{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		// Tests and the Vitest config run under Node; the build (tsconfig.json) has no Node types.
		"types": ["node"],
		"noEmit": true,
		"rootDir": "."
	},
	"include": ["src/**/*", "fixtures/**/*", "vitest.config.ts", "vitest.browser.config.ts"],
	"exclude": ["node_modules", "dist"]
}
