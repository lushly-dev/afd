{
	"name": "@lushly-dev/specimen-fast-af",
	"version": "0.1.0-preview.2",
	"type": "module",
	"description": "FAST-AF plugin for Specimen: Definition Schema, @command runner and theme presets",
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./guides": {
			"types": "./dist/guides.d.ts",
			"import": "./dist/guides.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc",
		"clean": "rimraf dist *.tsbuildinfo",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"test": "vitest run",
		"test:browser": "vitest run --config vitest.browser.config.ts"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"sideEffects": false,
	"peerDependencies": {
		"@lushly-dev/fast-element": "^3.0.1-preview",
		"@lushly-dev/specimen": "^2.2.0-preview"
	},
	"devDependencies": {
		"@lushly-dev/fast-element": "workspace:^",
		"@lushly-dev/specimen": "workspace:^",
		"@types/node": "^26.6.6",
		"rimraf": "^6.1.4",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/lushly-dev/afd.git",
		"directory": "integrations/specimen-fast-af"
	},
	"license": "MIT"
}
