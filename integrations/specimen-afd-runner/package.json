{
	"name": "@lushly-dev/specimen-afd-runner",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Private AFD application-command runner, in-page job driver, and scenario job source for Specimen",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./job-source": {
			"types": "./dist/job-source.d.ts",
			"import": "./dist/job-source.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc",
		"clean": "rimraf dist *.tsbuildinfo",
		"typecheck": "tsc -p tsconfig.typecheck.json && tsc -p tsconfig.browser.json",
		"test": "vitest run",
		"test:browser": "vitest run --config vitest.browser.config.ts"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"sideEffects": false,
	"dependencies": {
		"@lushly-dev/afd-core": "workspace:^",
		"@lushly-dev/afd-testing": "workspace:^",
		"@lushly-dev/specimen": "workspace:^"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.1",
		"rimraf": "^6.1.4",
		"typescript": "^7.0.2",
		"vitest": "^5.1.1"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/lushly-dev/afd.git",
		"directory": "integrations/specimen-afd-runner"
	},
	"license": "MIT"
}
