{
	"name": "@lushly-dev/violet-afd",
	"version": "0.2.0",
	"license": "MIT",
	"author": "Falkicon",
	"repository": {
		"type": "git",
		"url": "https://github.com/lushly-dev/afd.git",
		"directory": "integrations/violet-afd"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"violet",
		"design-tokens",
		"afd",
		"agent-first",
		"commands"
	],
	"engines": {
		"node": ">=24"
	},
	"description": "AFD command bindings for the native Violet token engine; the pre-split violet-core command surface",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./worker": {
			"import": "./dist/worker.js",
			"types": "./dist/worker.d.ts"
		},
		"./commands": {
			"import": "./dist/commands/index.js",
			"types": "./dist/commands/index.d.ts"
		},
		"./css": {
			"import": "./dist/css.js",
			"types": "./dist/css.d.ts"
		},
		"./types": {
			"import": "./dist/types/index.js",
			"types": "./dist/types/index.d.ts"
		}
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"lint": "biome check src/",
		"test": "vitest run --config vitest.unit.config.ts",
		"test:db": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"clean": "rm -rf dist *.tsbuildinfo"
	},
	"dependencies": {
		"@lushly-dev/afd-core": "workspace:^2.2.0",
		"@neondatabase/serverless": "^1.1.0",
		"nanoid": "^5.1.16",
		"ws": "^8.22.0",
		"zod": "^3.25.76",
		"zod-to-json-schema": "^3.25.2"
	},
	"peerDependencies": {
		"@lushly-dev/violet-core": "^0.2.0 || ^0.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@lushly-dev/violet-core": "workspace:^0.2.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"@types/ws": "^8.18.2",
		"@vitest/coverage-v8": "^4.1.12",
		"pg": "^8.23.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.12"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	]
}
