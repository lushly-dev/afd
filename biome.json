{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/*.plan.md",
			"!**/_generated",
			"!**/alfred",
			"!**/site",
			"!!foundations/fast-af",
			"!!foundations/violet",
			"!!integrations/violet-afd",
			"!!endpoints/violet-cli",
			"!!endpoints/violet-server",
			"!endpoints/botcore/provenance/*.json",
			"!endpoints/health/provenance/*.json",
			"!foundations/specimen/provenance/*.json",
			"!endpoints/botcore/src/botcore/provenance/*.json",
			"!spec/wire/*.json"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100,
		"lineEnding": "lf"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noUselessTypeConstraint": "error",
				"useLiteralKeys": "error"
			},
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error",
				"useExhaustiveDependencies": "warn"
			},
			"style": {
				"noNonNullAssertion": "error",
				"useConst": "error",
				"useImportType": "error",
				"useNodejsImportProtocol": "error"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noConfusingVoidType": "error",
				"noNonNullAssertedOptionalChain": "error",
				"useIterableCallbackReturn": "error",
				"noTemplateCurlyInString": "off",
				"noImplicitAnyLet": "error",
				"noArrayIndexKey": "error"
			},
			"a11y": {
				"noStaticElementInteractions": "error",
				"useKeyWithClickEvents": "error",
				"noLabelWithoutControl": "error"
			},
			"security": {
				"noDangerouslySetInnerHtml": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "es5",
			"semicolons": "always"
		}
	}
}
