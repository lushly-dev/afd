# Dependencies
node_modules/
.pnpm-store/
package-lock.json

# Build outputs
dist/
# setuptools writes build/lib when packaging the Health toolkit
endpoints/health/build/
*.tsbuildinfo
target/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
.eggs/
*.egg-info/
*.egg

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test coverage and reports
coverage/
test-results/
playwright-report/

# Environment
.env
.env.local
.env.*.local

# Rust
Cargo.lock
# Umbel is a binary: its lock is committed so CI builds what it tested
!endpoints/umbel/Cargo.lock
# So is Specimen's native host
!foundations/specimen/host/Cargo.lock

# C++ (CMake build trees; see packages/cpp)
/packages/cpp/build/
/packages/examples/todo/backends/cpp/build/

# Misc
*.plan.md
!PLAN/**/*.plan.md
!archive/**/*.plan.md
!docs/features/active/**/*.plan.md
# Imported Botcore tracks its plan documents; provenance hashes them.
!endpoints/botcore/**/*.plan.md
.claude/worktrees/
.cursor/
nul
tmpclaude-*
tools-response.json
execution.review.md
api-alignment-report.md
# Vitest browser-mode failure artifacts; untracked Specimen files would fail its provenance test.
foundations/specimen/.vitest-attachments/
foundations/specimen/reference/__screenshots__/
