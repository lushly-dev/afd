# Dependencies
node_modules/
.pnpm-store/
package-lock.json

# Build outputs
dist/
dist-installers/
# setuptools writes build/lib when packaging the Health toolkit
endpoints/health/build/
*.tsbuildinfo
target/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
.eggs/
*.egg-info/
*.egg
# Each ignores itself with a `*` inside, which leaves the folder itself unignored to git
# check-ignore, so botcore's disk-reclaim would refuse to strip it
.pytest_cache/
.ruff_cache/
.mypy_cache/

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test coverage and reports
coverage/
test-results/
playwright-report/
# Vitest 5 artifacts: failure screenshots, attachments and file reporters write under .vitest/.
.vitest/

# Environment
.env
.env.local
.env.*.local

# Rust
Cargo.lock
# Umbel is a binary: its lock is committed so CI builds what it tested
!endpoints/umbel/Cargo.lock
# So is the Loam OS host, built on Umbel's crates
!endpoints/loam-os/Cargo.lock
# So is Specimen's native host
!foundations/specimen/host/Cargo.lock
# And Mail's engine
!endpoints/loam/plugins/mail/engine/Cargo.lock
# And Loam's desktop host (phase 6 specification, section 2)
!endpoints/loam/packages/desktop/src-tauri/Cargo.lock
# The Rust AFD crate's CI lockfile (#1765; excluded from crates.io publish by Cargo for libraries)
!packages/rust/Cargo.lock

# C++ (CMake build trees; see packages/cpp)
/packages/cpp/build/
/packages/examples/todo/backends/cpp/build/

# Misc
*.plan.md
!PLAN/**/*.plan.md
!archive/**/*.plan.md
!docs/features/**/*.plan.md
# Imported Botcore tracks its plan documents; provenance hashes them.
!endpoints/botcore/**/*.plan.md
.claude/worktrees/
.cursor/
nul
tmpclaude-*
tools-response.json
execution.review.md
api-alignment-report.md
# Untracked Specimen files would fail its provenance test. Vitest's browser-mode failure
# artifacts land under .vitest/ (ignored above).
foundations/specimen/packages/*/bin/

# The local Umbel workspace scripts/umbel-components.mjs writes (Component Briefs, step C5).
.umbel/

# A factory cell's hand-off to the lane: its PR body and enqueue arguments (prepare-pr lane mode).
.factory/

# Specimen's local working data: capture sets, runs and points (Design Decisions proposal,
# section 5). Records meant to be committed live under specimens/.
.specimen/
