{
	"name": "@lushly-dev/afd-server",
	"version": "2.4.0",
	"description": "Server-side utilities for building AFD-compliant MCP servers with Zod validation",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./define": {
			"types": "./dist/define.d.ts",
			"import": "./dist/define.js"
		},
		"./direct": {
			"types": "./dist/direct.d.ts",
			"import": "./dist/direct.js"
		},
		"./credentials": {
			"types": "./dist/credentials.d.ts",
			"import": "./dist/credentials.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"dev": "tsc --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@lushly-dev/afd-core": "workspace:*",
		"@modelcontextprotocol/node": "^2.1.2",
		"@modelcontextprotocol/server": "^2.4.0",
		"jose": "^6.2.14",
		"yaml": "^2.9.1",
		"zod": "^4.6.6"
	},
	"devDependencies": {
		"@lushly-dev/afd-client": "workspace:*",
		"@modelcontextprotocol/client": "^2.4.0",
		"@vitest/coverage-v8": "^5.1.0",
		"esbuild": "0.28.2",
		"playwright": "1.64.0",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	},
	"keywords": [
		"afd",
		"agent-first",
		"mcp",
		"server",
		"zod",
		"validation"
	],
	"author": "Falkicon",
	"license": "MIT",
	"homepage": "https://github.com/lushly-dev/afd#readme",
	"bugs": {
		"url": "https://github.com/lushly-dev/afd/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/lushly-dev/afd.git",
		"directory": "packages/server"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	}
}
