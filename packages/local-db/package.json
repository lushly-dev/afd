{
	"name": "@lushly-dev/local-db",
	"version": "2.2.1",
	"description": "Async data adapter with swappable backends (Memory, HTTP, IndexedDB) for Agent-First Development",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./indexeddb": {
			"types": "./dist/indexeddb-adapter.d.ts",
			"import": "./dist/indexeddb-adapter.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"import": "./dist/testing.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsc",
		"clean": "rimraf dist *.tsbuildinfo",
		"dev": "tsc --watch",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:hosted": "node hosted/run-phase.mjs"
	},
	"keywords": [
		"afd",
		"agent-first",
		"database",
		"adapter",
		"sqlite",
		"local-storage",
		"indexeddb",
		"data-layer"
	],
	"author": "Falkicon",
	"license": "MIT",
	"homepage": "https://github.com/lushly-dev/afd#readme",
	"bugs": {
		"url": "https://github.com/lushly-dev/afd/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/lushly-dev/afd.git",
		"directory": "packages/local-db"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"sideEffects": false,
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^4.1.12",
		"fake-indexeddb": "^6.2.7",
		"rimraf": "^6.1.3",
		"typescript": "^5.9.3",
		"vitest": "^4.1.12"
	},
	"peerDependencies": {
		"vitest": ">=1.0.0"
	},
	"peerDependenciesMeta": {
		"vitest": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
