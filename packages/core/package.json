{
	"name": "@lushly-dev/afd-core",
	"version": "2.5.0",
	"description": "Core types and utilities for Agent-First Development",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./platform": {
			"types": "./dist/platform.d.ts",
			"import": "./dist/platform.js"
		},
		"./connectors": {
			"types": "./dist/connectors/index.d.ts",
			"import": "./dist/connectors/index.js"
		},
		"./journal-file": {
			"types": "./dist/journal-file.d.ts",
			"import": "./dist/journal-file.js"
		},
		"./journal-indexeddb": {
			"types": "./dist/journal-indexeddb.d.ts",
			"import": "./dist/journal-indexeddb.js"
		},
		"./internal/direct-approval": {
			"types": "./dist/direct-approval.d.ts",
			"import": "./dist/direct-approval.js"
		},
		"./internal/canonical-json": {
			"types": "./dist/canonical-json.d.ts",
			"import": "./dist/canonical-json.js"
		},
		"./internal/direct-allow": {
			"types": "./dist/direct-allow.d.ts",
			"import": "./dist/direct-allow.js"
		},
		"./internal/dispatch-id": {
			"types": "./dist/dispatch-id.d.ts",
			"import": "./dist/dispatch-id.js"
		},
		"./internal/app-calls": {
			"types": "./dist/app-calls.d.ts",
			"import": "./dist/app-calls.js"
		},
		"./commands": {
			"types": "./dist/commands.d.ts",
			"import": "./dist/commands.js"
		},
		"./errors": {
			"types": "./dist/errors.d.ts",
			"import": "./dist/errors.js"
		},
		"./result": {
			"types": "./dist/result.d.ts",
			"import": "./dist/result.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsc",
		"clean": "rimraf dist *.tsbuildinfo",
		"dev": "tsc --watch",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [
		"afd",
		"agent-first",
		"mcp",
		"ai-agents",
		"command-schema"
	],
	"author": "Falkicon",
	"license": "MIT",
	"homepage": "https://github.com/lushly-dev/afd#readme",
	"bugs": {
		"url": "https://github.com/lushly-dev/afd/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/lushly-dev/afd.git",
		"directory": "packages/core"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"sideEffects": false,
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.1",
		"fake-indexeddb": "^6.2.8",
		"rimraf": "^6.1.4",
		"typescript": "^7.0.2",
		"vitest": "^5.1.1"
	},
	"publishConfig": {
		"access": "public"
	}
}
