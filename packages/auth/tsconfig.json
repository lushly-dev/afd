{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		// Browser code: no Node globals or `node:` modules (#811).
		"types": [],
		"outDir": "./dist",
		"rootDir": "./src",
		"declaration": true,
		"declarationMap": true,
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM", "DOM.Iterable"]
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "**/*.test.ts"]
}
