{
	"extends": "../../../../../tsconfig.json",
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"declaration": false,
		"declarationMap": false,
		"sourceMap": false,
		"types": ["node"]
	},
	"include": ["src/**/*", "test/**/*"]
}
