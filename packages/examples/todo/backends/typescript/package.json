{
	"name": "@afd/example-todo-ts",
	"private": true,
	"version": "1.0.0",
	"description": "Todo example - TypeScript backend implementing AFD patterns",
	"type": "module",
	"main": "dist/server.js",
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"start": "node dist/server.js",
		"dev": "tsx watch src/server.ts",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@lushly-dev/afd-core": "workspace:*",
		"@lushly-dev/afd-server": "workspace:*",
		"zod": "^4.6.6"
	},
	"devDependencies": {
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^4.1.12"
	}
}
