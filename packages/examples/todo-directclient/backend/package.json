{
	"name": "@afd/example-todo-directclient",
	"private": true,
	"version": "0.1.0",
	"description": "Example: the to-do reference commands run by an in-process AI copilot through DirectClient",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"start": "node dist/chat-server.js",
		"dev": "tsx watch src/chat-server.ts",
		"benchmark": "tsx src/benchmark/compare.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"demo": "tsx src/demo.ts"
	},
	"dependencies": {
		"@afd/example-todo-ts": "workspace:*",
		"@google/genai": "^2.32.0",
		"@lushly-dev/afd-client": "workspace:*",
		"@lushly-dev/afd-core": "workspace:*",
		"@lushly-dev/afd-server": "workspace:*",
		"@lushly-dev/afd-view-state": "workspace:*",
		"dotenv": "^18.0.10"
	},
	"devDependencies": {
		"@lushly-dev/afd-testing": "workspace:*",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.1.2",
		"zod": "^4.6.6"
	}
}
