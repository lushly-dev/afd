# Gemini API Key (required for AI chat)
# Get it from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_api_key_here

# Server Configuration
CHAT_PORT=3201
# Interface to bind. The default, 127.0.0.1, is reachable from this machine only.
# Use 0.0.0.0 to listen on every interface, and then set ALLOWED_HOSTS too.
CHAT_HOST=127.0.0.1

# Security Configuration
# Extra exact browser origins allowed to call the API, comma-separated. The UI
# this server serves (http://localhost:3201, http://127.0.0.1:3201) is always
# allowed. "*" and "null" (file:// pages) are refused.
# ALLOWED_ORIGINS=http://localhost:5173

# Extra host names accepted in the Host header (blocks DNS rebinding).
# localhost, 127.0.0.1 and [::1] are always accepted.
# ALLOWED_HOSTS=chat.example.com

# Set only when a reverse proxy in front of this server appends X-Forwarded-For.
# The rate limiter then keys on the address that proxy appended.
TRUST_PROXY=false

# Rate Limiting (requests per minute per client)
RATE_LIMIT_CHAT=30
RATE_LIMIT_EXECUTE=120
# Most clients tracked at once (bounds the rate limiter's memory)
RATE_LIMIT_MAX_CLIENTS=10000

# Request Body Size Limit (bytes)
MAX_BODY_SIZE=10240

# Most rounds of tool calls Gemini may make for one message
GEMINI_MAX_TOOL_ROUNDS=5
