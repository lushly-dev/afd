# Gemini API Key (required for AI chat)
# Get it from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_api_key_here

# Server Configuration
CHAT_PORT=3201
# Interface to bind. The default, 127.0.0.1, is reachable from this machine only.
# Use 0.0.0.0 to listen on every interface, and then set ALLOWED_HOSTS too.
CHAT_HOST=127.0.0.1

# Security Configuration
# Extra exact browser origins allowed to call the API, comma-separated. The UI
# this server serves (http://localhost:3201, http://127.0.0.1:3201) is always
# allowed. "*" and "null" (file:// pages) are refused.
# ALLOWED_ORIGINS=http://localhost:5173

# Extra host names accepted in the Host header (blocks DNS rebinding).
# localhost, 127.0.0.1 and [::1] are always accepted.
# ALLOWED_HOSTS=chat.example.com

# Set only when a reverse proxy in front of this server appends X-Forwarded-For.
# The rate limiter then keys on the address that proxy appended.
TRUST_PROXY=false

# Rate Limiting (requests per minute per client)
RATE_LIMIT_CHAT=30
RATE_LIMIT_ANSWER=120
# Most clients tracked at once (bounds the rate limiter's memory)
RATE_LIMIT_MAX_CLIENTS=10000

# Request Body Size Limit (bytes)
MAX_BODY_SIZE=10240

# Most rounds of tool calls Gemini may make for one message
GEMINI_MAX_TOOL_ROUNDS=5

# Retries for transient Gemini failures, with exponential backoff from this delay
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_DELAY_MS=1000

# The store, shared with the main to-do example (see its README): file (default), sqlite or memory
# TODO_STORE_TYPE=file
# TODO_STORE_PATH=

# GEMINI_API_KEY is read when GOOGLE_API_KEY is not set
# GEMINI_API_KEY=

# The main example's server settings, which apply to the copilot's calls and to /mcp alike
# (see packages/examples/todo/backends/typescript/README.md):
# APPROVALS=agents             # agents (default) holds todo-clear for agents; off holds nothing
# CONFIRMATIONS=off            # off, enforce or require-human, for /mcp
# TODO_APPROVAL_SECRET=        # at least 32 bytes; default a random key per process
# TODO_JOURNAL=                # a JSON Lines file recording every call, for afd replay
# NODE_ENV=development         # verbose errors; /mcp then accepts any browser origin
# LOG_LEVEL=info               # debug also logs each call's input and result
