{
	"name": "@afd/example-pond",
	"private": true,
	"version": "0.1.0",
	"description": "Example: an event-sourced pond simulation whose state is rebuilt by replaying its command journal",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"start": "node dist/cli.js",
		"dev": "tsx src/cli.ts",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@lushly-dev/afd-core": "workspace:*",
		"@lushly-dev/afd-server": "workspace:*",
		"zod": "^4.6.6"
	},
	"devDependencies": {
		"@types/node": "^26.6.10",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.1.1"
	}
}
