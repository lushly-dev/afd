{
	"name": "@afd/example-chat",
	"private": true,
	"version": "1.0.0",
	"description": "Real-time chat example demonstrating the AFD handoff pattern for WebSocket connections",
	"type": "module",
	"main": "dist/server.js",
	"scripts": {
		"build": "tsc && vite build",
		"typecheck": "tsc -p tsconfig.typecheck.json && tsc -p demo/tsconfig.json",
		"start": "node dist/server.js",
		"dev": "vite build && tsx watch src/server.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"build:demo": "vite build"
	},
	"dependencies": {
		"@lushly-dev/afd-core": "workspace:*",
		"@lushly-dev/afd-server": "workspace:*",
		"ws": "^8.23.0",
		"zod": "^4.6.6"
	},
	"devDependencies": {
		"@lushly-dev/violet-elements": "workspace:*",
		"@types/ws": "^8.18.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.1.2"
	}
}
