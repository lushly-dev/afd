{
	"name": "@lushly-dev/specimen",
	"version": "2.2.0",
	"description": "Command-first component observations and comparison bench",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"import": "./dist/types.js"
		}
	},
	"bin": {
		"specimen": "./dist/bin.js"
	},
	"files": [
