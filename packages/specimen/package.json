		"zod": "^4.6.6"
	},
	"devDependencies": {
		"@types/node": "^25.9.5",
		"@vitest/coverage-v8": "^4.1.11",
		"rimraf": "^6.1.3",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
