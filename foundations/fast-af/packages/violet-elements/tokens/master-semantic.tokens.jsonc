{
  // Master semantic token registry for reusable Violet components.
  // This file is intended to be:
  // 1. a human-reviewed source of truth for token intent
  // 2. a future validation source for duplicate/overlapping tokens
  // 3. a seed input for Violet-aligned exports and tooling
  //
  // Important:
  // - Meaning lives in structured fields, not only comments.
  // - New semantic tokens should be added deliberately and reviewed.
  // - Component-local aliases should not be added here unless they become
  //   broadly reusable across multiple components.
  "registryVersion": "0.1.0",
