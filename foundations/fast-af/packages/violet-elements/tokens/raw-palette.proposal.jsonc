{
  // Draft raw palette proposal for Violet.
  // This sits below semantic tokens and gives us a named color vocabulary
  // we can map into surfaces, text, accents, and state roles.
  "proposalVersion": "0.1.0",
  "package": "@lushly-dev/violet-elements",
  "description": "Draft raw palette names and first semantic mapping proposal for Violet.",

  "rawPalette": [
    {
      "id": "oat-blossom",
      "hex": "#FFFEFA",
      "hsl": "hsla(48, 100%, 99%, 1)",
      "roleHint": "light warm neutral"
    },
    {
      "id": "dry-sage",
      "hex": "#FAF9F5",
      "hsl": "hsla(48, 33%, 97%, 1)",
      "roleHint": "secondary light neutral"
    },
    {
      "id": "sage-stem",
      "hex": "#F0EFE6",
      "hsl": "hsla(54, 25%, 92%, 1)",
      "roleHint": "deeper light neutral"
    },
    {
      "id": "rain-mint",
      "hex": "#DFE8E0",
      "hsl": "hsla(127, 16%, 89%, 1)",
      "roleHint": "soft selected-surface accent"
    },
    {
      "id": "pine-teal",
      "hex": "#244635",
      "hsl": "hsla(150, 32%, 21%, 1)",
      "roleHint": "cool dark accent ink"
    },
    {
      "id": "ripe-tomato",
      "hex": "#EC654E",
      "hsl": "hsla(9, 81%, 62%, 1)",
      "roleHint": "primary accent"
    },
    {
      "id": "chestnut",
      "hex": "#7A2B1E",
      "hsl": "hsla(8, 61%, 30%, 1)",
      "roleHint": "warm dark accent ink"
    },
    {
      "id": "black-pitch",
      "hex": "#1C1A0D",
      "hsl": "hsla(52, 37%, 8%, 1)",
      "roleHint": "default dark neutral ink"
    }
  ],

  "semanticMapping": {
    "surfaces": {
      "color.surface.page": {
        "source": "oat-blossom",
        "strategy": "direct",
        "notes": [
          "Current page surface direction now matches the named raw palette value directly."
        ]
      },
      "color.surface.card": {
        "source": "dry-sage",
        "strategy": "direct",
        "notes": [
          "Cards now map more cleanly to the second light neutral instead of deriving another lighter oat-blossom step."
        ]
      },
      "color.surface.subtle": {
        "source": "sage-stem",
        "strategy": "direct",
        "notes": [
          "Subtle/recessed structure for quieter nested surfaces."
        ]
      },
      "color.surface.selected": {
        "source": "rain-mint",
        "strategy": "direct",
        "notes": [
          "The selected-surface green is now light enough to stand as the named raw palette value itself."
        ]
      },
      "color.surface.floating": {
        "source": "sage-stem",
        "strategy": "direct-shared",
        "notes": [
          "Floating layers currently share the subtle surface value and depend on elevation to establish separation."
        ]
      }
    },
    "text": {
      "color.text.primary": {
        "source": "black-pitch",
        "strategy": "direct"
      },
      "color.text.secondary": {
        "source": "pine-teal",
        "strategy": "derived-muted",
        "candidateHex": "#405448",
        "notes": [
          "Secondary text should stay quieter than primary body text while still fitting the botanical palette."
        ]
      },
      "color.text.accent.primary": {
        "source": "ripe-tomato",
        "strategy": "direct-sparingly",
        "notes": [
          "Primary accent text for occasional pops, not frequent body usage."
        ]
      },
      "color.text.accent.secondary": {
        "source": "rain-mint",
        "strategy": "direct-sparingly",
        "notes": [
          "Secondary accent text when a cooler emphasis is needed."
        ]
      },
      "color.text.accent.coolDark": {
        "source": "pine-teal",
        "strategy": "direct-sparingly",
        "notes": [
          "Dark cool accent ink for highlighted words or labels."
        ]
      },
      "color.text.accent.warmDark": {
        "source": "chestnut",
        "strategy": "direct-sparingly",
        "notes": [
          "Dark warm accent ink for highlighted words or labels."
        ]
      }
    },
    "actions": {
      "color.action.primary": {
        "source": "ripe-tomato",
        "strategy": "direct"
      },
      "color.action.secondary": {
        "source": "rain-mint",
        "strategy": "direct"
      }
    }
  },

  "notes": [
    "Raw palette names should stay expressive and botanical/material in tone.",
    "Semantic tokens should remain functional even when they map to expressive raw names.",
    "Ripe-tomato is the primary accent. Rain-mint is the secondary accent.",
    "Pine-teal and chestnut are best treated as occasional dark accent inks rather than default body text colors.",
    "Black-pitch is the default dark neutral for primary text."
  ]
}
