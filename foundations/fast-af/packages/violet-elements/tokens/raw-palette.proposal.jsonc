{
  // AFD Refined raw palette reference for Violet's built-in default theme (D159, D172).
  // These primitives come from Loam's Violet token tree (endpoints/loam/packages/theme/tree/loam.tokens.json)
  // and map into the semantic surface, text, action, focus, accent and state roles.
  "proposalVersion": "0.3.0",
  "package": "@lushly-dev/violet-elements",
  "description": "AFD Refined raw palette primitives and semantic mapping reference for Violet.",

  "rawPalette": [
    {
      "id": "paper",
      "hex": "#f4f0ea",
      "hsl": "hsla(36, 31%, 94%, 1)",
      "roleHint": "page surface (warm paper canvas)"
    },
    {
      "id": "paper-bright",
      "hex": "#f8f9f3",
      "hsl": "hsla(70, 33%, 96%, 1)",
      "roleHint": "card surface (brighter paper)"
    },
    {
      "id": "paper-200",
      "hex": "#e9e5de",
      "hsl": "hsla(38, 20%, 89%, 1)",
      "roleHint": "subtle recessed surface and tracks"
    },
    {
      "id": "cerulean-wash",
      "hex": "#dfecf4",
      "hsl": "hsla(203, 49%, 92%, 1)",
      "roleHint": "selected rows and accent wash"
    },
    {
      "id": "cerulean-soft",
      "hex": "#c0daeb",
      "hsl": "hsla(204, 52%, 84%, 1)",
      "roleHint": "selected control fill (checkbox, switch, radio)"
    },
    {
      "id": "cerulean-500",
      "hex": "#28769e",
      "hsl": "hsla(200, 59%, 39%, 1)",
      "roleHint": "focus ring and active handle"
    },
    {
      "id": "cerulean-ink",
      "hex": "#1b5f80",
      "hsl": "hsla(200, 65%, 30%, 1)",
      "roleHint": "selection, accent and link ink"
    },
    {
      "id": "mint-wash",
      "hex": "#dfeae3",
      "hsl": "hsla(142, 21%, 90%, 1)",
      "roleHint": "success message wash"
    },
    {
      "id": "mint-ink",
      "hex": "#2c5e4b",
      "hsl": "hsla(157, 36%, 27%, 1)",
      "roleHint": "success text and icon ink"
    },
    {
      "id": "red-ink",
      "hex": "#c42a1a",
      "hsl": "hsla(6, 77%, 44%, 1)",
      "roleHint": "danger action and invalid ink"
    },
    {
      "id": "ink-soft",
      "hex": "#48534b",
      "hsl": "hsla(136, 7%, 30%, 1)",
      "roleHint": "secondary text and hover border"
    },
    {
      "id": "ink",
      "hex": "#181b1a",
      "hsl": "hsla(160, 6%, 10%, 1)",
      "roleHint": "primary text and main action"
    }
  ],

  "semanticMapping": {
    "surfaces": {
      "color.surface.page": {
        "source": "paper",
        "strategy": "direct",
        "notes": [
          "Quiet warm paper canvas for the resting page surface."
        ]
      },
      "color.surface.card": {
        "source": "paper-bright",
        "strategy": "direct",
        "notes": [
          "Card surfaces step brighter than the page without leaving the paper family."
        ]
      },
      "color.surface.subtle": {
        "source": "paper-200",
        "strategy": "direct",
        "notes": [
          "Recessed bands, tinted rows and slider tracks."
        ]
      },
      "color.surface.selected": {
        "source": "cerulean-wash",
        "strategy": "direct",
        "notes": [
          "Cerulean 235° wash for selected rows and accent surfaces on paper (D172)."
        ]
      },
      "color.surface.floating": {
        "source": "paper-bright",
        "strategy": "brightened-to-white",
        "notes": [
          "Floating layers sit brightest on pure white (#ffffff) with a soft drop shadow."
        ]
      }
    },
    "text": {
      "color.text.primary": {
        "source": "ink",
        "strategy": "direct"
      },
      "color.text.secondary": {
        "source": "ink-soft",
        "strategy": "direct",
        "notes": [
          "Secondary text and field hover edges stay legible over every light surface."
        ]
      },
      "color.control.selected.foreground": {
        "source": "cerulean-ink",
        "strategy": "direct",
        "notes": [
          "Cerulean selection and accent ink paired with cerulean-soft and cerulean-wash (D172)."
        ]
      },
      "color.focus.ring": {
        "source": "cerulean-500",
        "strategy": "direct",
        "notes": [
          "Keyboard focus ring and active handle in light mode (D172)."
        ]
      },
      "color.state.success.text": {
        "source": "mint-ink",
        "strategy": "direct",
        "notes": [
          "Success ink paired with mint-wash, kept distinct from cerulean selection and focus."
        ]
      },
      "color.state.danger.text": {
        "source": "red-ink",
        "strategy": "direct",
        "notes": [
          "Readable danger text and destructive action color on light paper."
        ]
      }
    },
    "actions": {
      "color.action.primary.background": {
        "source": "ink",
        "strategy": "direct"
      },
      "color.control.selected.background": {
        "source": "cerulean-soft",
        "strategy": "direct"
      }
    }
  },

  "notes": [
    "AFD's Refined palette pairs ink on paper with cerulean for selection, focus and accent, mint for success, and red for danger (D159, D172).",
    "Semantic tokens are generated from Loam's Violet theme tree into tokens/violet-theme.export.json (D50, D159, D172).",
    "Products with their own look (such as Lushly) install their own VioletThemeSet via installVioletThemeSet()."
  ]
}
