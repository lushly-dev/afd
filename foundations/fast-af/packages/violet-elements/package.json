    "clean": "rimraf dist",
    "lint": "biome check src && node ../../../../scripts/codemods/split-define.mjs --check",
    "test:browser": "vitest --run --coverage",
    "test:browser:firefox": "node scripts/run-browser-tests.mjs firefox",
    "test:browser:webkit": "node scripts/run-browser-tests.mjs webkit",
    "test:browser:all": "node scripts/run-browser-tests.mjs all",
    "test:stories": "tsc -p tsconfig.stories.json && node scripts/run-stories.mjs",
    "theme:build": "node ./scripts/build-runtime-theme.mjs",
    "icons:build": "node ./scripts/build-icons.mjs",
    "cem:analyze": "cem analyze --config custom-elements-manifest.config.js && node ./scripts/normalize-custom-elements.mjs",
    "verify:exports": "node ./scripts/verify-package-exports.mjs",
    "taxonomy:check": "node --test scripts/check-attribute-taxonomy.test.mjs && node scripts/check-attribute-taxonomy.mjs",
    "pack:build": "node scripts/build-pack.mjs"
  },
