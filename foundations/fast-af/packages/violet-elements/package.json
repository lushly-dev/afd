{
  "name": "@lushly-dev/violet-elements",
  "description": "Reusable Violet web components for FAST-AF",
  "version": "0.1.0",
  "author": "Lushly Dev",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/*": "./dist/*",
    "./custom-elements.json": "./custom-elements.json",
    "./tokens/*": "./tokens/*",
    "./package.json": "./package.json"
  },
  "customElements": "custom-elements.json",
  "sideEffects": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "dev": "tsc -p tsconfig.lib.json --watch",
    "clean": "rimraf dist",
    "lint": "biome lint src",
    "test:browser": "vitest --run --coverage",
    "test:stories": "tsc -p tsconfig.stories.json && node scripts/run-stories.mjs",
    "theme:build": "node ./scripts/build-runtime-theme.mjs",
    "icons:build": "node ./scripts/build-icons.mjs",
    "cem:analyze": "cem analyze --config custom-elements-manifest.config.js && node ./scripts/normalize-custom-elements.mjs",
    "verify:exports": "node ./scripts/verify-package-exports.mjs"
  },
  "dependencies": {
    "@tanstack/virtual-core": "3.13.23",
    "tslib": "^2.6.3"
  },
  "peerDependencies": {
    "@lushly-dev/fast-element": "workspace:*"
  },
  "files": [
    "dist",
    "custom-elements.json",
    "tokens",
    "README.md"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@lushly-dev/fast-element": "workspace:*",
    "@lushly-dev/specimen": "workspace:*",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "playwright": "^1.64.0",
    "rimraf": "^6.1.4",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.1.0"
  }
}
