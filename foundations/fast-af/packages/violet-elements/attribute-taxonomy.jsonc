      "usedBy": ["violet-button"]
    },
    {
      "name": "heading",
      "property": "heading",
      "valueType": "string",
      "category": "content",
      "definition": "Provides the primary title text for a component that owns an internal heading treatment.",
      "useFor": ["empty states", "callouts", "other surfaces with a compact owned title slot"],
      "doNotUseFor": ["slotted arbitrary heading markup when the consumer should control semantics directly", "button labels"],
      "usedBy": ["violet-empty-state"]
    },
    {
      "name": "message",
      "property": "message",
      "valueType": "string",
      "category": "content",
      "definition": "Provides the main descriptive copy for a compact message surface that owns its text layout internally.",
      "useFor": ["empty states", "message surfaces", "simple guided placeholders"],
      "doNotUseFor": ["rich multi-slot body content", "ARIA live-region text that should stay separate from visible copy"],
      "usedBy": ["violet-empty-state"]
    },
    {
      "name": "decorative",
