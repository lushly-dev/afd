{
  "version": "0.1.0",
  "description": "Canonical public-attribute taxonomy for Violet and FAST-AF reference components.",
  "purpose": [
    "Keep attribute names stable across components.",
    "Prevent the same name from drifting into multiple meanings.",
    "Prefer native HTML and Fluent-familiar naming when it reduces surprise.",
    "Provide structured input for component linting and contract validation."
  ],
  "rules": [
    {
      "id": "one-name-one-meaning",
      "summary": "A public attribute name should keep one stable meaning across the system."
    },
    {
      "id": "native-first",
      "summary": "Prefer native HTML naming like disabled, readonly, checked, value, placeholder, and type before inventing custom terms."
    },
    {
      "id": "variant-vs-state",
      "summary": "Use appearance-like attributes for stylistic variants and state attributes for interactive or validation state."
    },
    {
      "id": "data-via-properties",
      "summary": "Do not serialize rich objects or arrays through reflected attributes; use element properties for structured data."
    }
  ],
  "attributes": [
    {
      "name": "as",
      "property": "as",
      "valueType": "enum",
      "allowedValues": [],
      "allowedValuesByComponent": {
        "violet-text": ["span", "p", "small", "strong", "label", "h1", "h2", "h3", "h4"]
      },
      "category": "semantics",
      "definition": "Selects the underlying semantic HTML element the component should render while keeping the Violet styling contract.",
      "useFor": ["typography primitives", "semantic wrappers that intentionally vary their native tag without changing their broader API"],
      "doNotUseFor": ["pure styling variants", "ARIA roles", "component family selection"],
      "usedBy": ["violet-text"]
    },
    {
      "name": "appearance",
      "property": "appearance",
      "valueType": "enum",
      "allowedValues": ["primary", "secondary", "quiet", "transparent"],
      "allowedValuesByComponent": {
        "violet-button": ["primary", "secondary", "quiet", "transparent", "danger"],
        "violet-card": ["filled", "outline", "subtle"],
        "violet-badge": ["filled", "outline", "subtle"],
        "violet-divider": ["subtle", "strong"],
        "violet-empty-state": ["plain", "subtle", "outline"],
        "violet-carousel": ["framed", "plain"],
        "violet-file-upload": ["button", "dropzone"],
        "violet-tree": ["plain", "framed"],
        "violet-tabs": ["open", "closed", "mixed"]
      },
      "category": "variant",
      "definition": "Selects a visual emphasis treatment for an action-like control without changing its semantic role.",
      "useFor": ["buttons", "tabs", "action chips", "card surfaces", "other explicit action or navigation surfaces with multiple emphasis levels"],
      "doNotUseFor": ["selection state", "validation state", "density or size", "component-specific mode toggles"],
      "usedBy": ["violet-button", "violet-icon-button", "violet-card", "violet-badge", "violet-divider", "violet-empty-state", "violet-carousel", "violet-file-upload", "violet-tree", "violet-tabs"]
    },
    {
      "name": "color",
      "property": "color",
      "valueType": "enum",
      "allowedValues": [],
      "allowedValuesByComponent": {
        "violet-badge": ["neutral", "accent", "success", "warning", "danger"]
      },
      "category": "variant",
      "definition": "Selects a semantic color family for a compact status or category indicator without changing the underlying content.",
      "useFor": ["badges", "status chips", "small semantic indicators"],
      "doNotUseFor": ["arbitrary CSS colors", "theme switching", "state that should use disabled, invalid, or checked semantics"],
      "usedBy": ["violet-badge"]
    },
    {
      "name": "type",
      "property": "type",
      "valueType": "enum",
      "allowedValues": [],
      "allowedValuesByComponent": {
        "violet-button": ["button", "submit", "reset"],
        "violet-icon-button": ["button", "submit", "reset"],
        "violet-text-field": ["text", "search", "email", "url", "password", "tel", "number", "date"],
        "violet-dialog": ["modal", "non-modal", "alert"]
      },
      "category": "native-form",
      "definition": "Passes through the native HTML control type when the component wraps a native form control with standard type semantics.",
      "useFor": ["button-like primitives", "single-line field primitives", "dialog components"],
      "doNotUseFor": ["visual variants", "business modes", "custom component family names"],
      "usedBy": ["violet-button", "violet-icon-button", "violet-text-field", "violet-dialog"],
      "notes": ["Allowed values should stay aligned with the native control being wrapped."]
    },
    {
      "name": "disabled",
      "property": "disabled",
      "valueType": "boolean",
      "category": "state",
      "definition": "Marks a control as unavailable for interaction and participation in normal form workflows.",
      "useFor": ["interactive controls", "form fields", "toggle-like inputs"],
      "doNotUseFor": ["temporary loading visuals unless the control is truly unavailable", "read-only content"],
      "usedBy": ["violet-button", "violet-icon-button", "violet-checkbox", "violet-radio", "violet-radio-group", "violet-switch", "violet-text-field", "violet-text-area", "violet-data-grid", "violet-range-slider", "violet-chat-composer", "violet-listbox", "violet-option", "violet-option-group", "violet-select", "violet-combobox", "violet-accordion-item", "violet-segment", "violet-segmented-control", "violet-pagination", "violet-calendar", "violet-date-picker", "violet-time-picker", "violet-date-range-picker", "violet-file-upload", "violet-color-picker", "violet-tab", "violet-tabs", "violet-tree-item", "violet-data-grid-multi-picker", "violet-data-grid-reference-picker", "violet-data-grid-persona-picker", "violet-data-grid-attachment-cell", "violet-data-grid-rating"]
    },
    {
      "name": "name",
      "property": "name",
      "valueType": "string",
      "category": "native-form",
      "definition": "Supplies the native form field name used when a component participates in form submission.",
      "useFor": ["form-associated controls", "custom elements that intentionally mirror native form semantics"],
      "doNotUseFor": ["visual labels", "analytics identifiers", "component registry names"],
      "usedBy": ["violet-checkbox", "violet-radio", "violet-radio-group", "violet-slider", "violet-switch", "violet-text-field", "violet-text-area", "violet-range-slider", "violet-select", "violet-combobox", "violet-segmented-control", "violet-date-picker", "violet-time-picker", "violet-date-range-picker", "violet-file-upload", "violet-color-picker"]
    },
    {
      "name": "required",
      "property": "required",
      "valueType": "boolean",
      "category": "validation",
      "definition": "Marks a form-associated control as requiring a user-provided value or selection before validation succeeds.",
      "useFor": ["text-entry controls", "checkboxes and other native-like selection inputs with required semantics"],
      "doNotUseFor": ["visual emphasis", "business rules that should not map to native form validity"],
      "usedBy": ["violet-checkbox", "violet-radio-group", "violet-slider", "violet-switch", "violet-text-field", "violet-text-area", "violet-range-slider", "violet-select", "violet-combobox", "violet-segmented-control", "violet-file-upload", "violet-color-picker"]
    },
    {
      "name": "readonly",
      "property": "readonly",
      "valueType": "boolean",
      "category": "state",
      "definition": "Prevents user edits while retaining a readable value; grid renderers may expose a non-interactive display instead of an editor.",
      "useFor": ["text inputs", "textareas", "other editable text-like fields", "grid value renderers with a distinct non-editable display"],
      "doNotUseFor": ["disabled-like behavior", "controls without a defined read-only value presentation"],
      "usedBy": ["violet-text-field", "violet-text-area", "violet-data-grid-attachment-cell", "violet-data-grid-rating"]
    },
    {
      "name": "checked",
      "property": "checked",
      "valueType": "boolean",
      "category": "selection",
      "definition": "Represents the on/off or selected/unselected state of a binary native-style control.",
      "useFor": ["checkboxes", "switches", "radio-like wrappers where native checked semantics apply"],
      "doNotUseFor": ["multi-value arrays", "non-binary UI state", "selected rows in rich data components"],
      "usedBy": ["violet-checkbox", "violet-radio", "violet-switch", "violet-segment"]
    },
    {
      "name": "indeterminate",
      "property": "indeterminate",
      "valueType": "boolean",
      "category": "selection",
      "definition": "Represents a mixed aggregate selection state for checkbox-like controls.",
      "useFor": ["select-all checkboxes", "aggregate selection controls where some but not all children are selected"],
      "doNotUseFor": ["regular binary checked state", "radio buttons", "visual loading states"],
      "usedBy": ["violet-checkbox"]
    },
    {
      "name": "selected",
      "property": "selected",
      "valueType": "boolean",
      "category": "selection",
      "definition": "Indicates that an item within a composite selection surface is currently selected.",
      "useFor": ["listbox options", "tree items", "selectable collection items that expose option semantics"],
      "doNotUseFor": ["overlay visibility", "focus-only active state", "checked native inputs unless they truly map to checked semantics"],
      "usedBy": ["violet-option", "violet-tree-item"]
    },
    {
      "name": "current",
      "property": "current",
      "valueType": "boolean",
      "category": "navigation",
      "definition": "Indicates that an item within a navigation sequence represents the current location.",
      "useFor": ["breadcrumb items", "pagination items", "other navigation elements that map to aria-current semantics"],
      "doNotUseFor": ["selection widgets that should use selected or checked", "transient focus state", "hover styling"],
      "usedBy": ["violet-breadcrumb-item"]
    },
    {
      "name": "activeid",
      "property": "activeid",
      "valueType": "string",
      "category": "behavior",
      "definition": "Identifies the active child item in a composite that coordinates one selected trigger with one visible content region.",
      "useFor": ["tabs or similar composites that synchronize one active item with one active content region"],
      "doNotUseFor": ["selected row ids in data collections", "generic HTML id passthrough", "single controls without child item coordination"],
      "usedBy": ["violet-tabs"]
    },
    {
      "name": "active-index",
      "property": "activeIndex",
      "valueType": "number",
      "category": "behavior",
      "definition": "Indicates the currently active zero-based item in a paged composite that renders one visible item at a time.",
      "useFor": ["carousels or similar paged composites with slotted items and generated navigation"],
      "doNotUseFor": ["page numbers", "selected row ids", "listbox option values", "generic collection indexes that are not part of a public paging contract"],
      "usedBy": ["violet-carousel"]
    },
    {
      "name": "multiple",
      "property": "multiple",
      "valueType": "boolean",
      "category": "selection",
      "definition": "Allows a composite selection surface to keep more than one option selected at the same time.",
      "useFor": ["listbox-style selection primitives that intentionally support multiple selected options"],
      "doNotUseFor": ["binary checked controls", "layout density", "freeform repeated data entry"],
      "usedBy": ["violet-listbox", "violet-file-upload", "violet-data-grid-reference-picker", "violet-data-grid-persona-picker"]
    },
    {
      "name": "allow-create",
      "property": "allowCreate",
      "valueType": "boolean",
      "category": "behavior",
      "definition": "Enables a host-owned create affordance for unmatched picker queries.",
      "useFor": ["pickers delegating item creation to the host"],
      "doNotUseFor": ["automatic data creation", "authorization flags"],
      "usedBy": ["violet-data-grid-reference-picker"]
    },
    {
      "name": "accept",
      "property": "accept",
      "valueType": "string",
      "category": "native-form",
      "definition": "Passes through accepted file type hints using the same syntax as the native file input accept attribute.",
      "useFor": ["file upload controls that intentionally mirror native file input filtering semantics"],
      "doNotUseFor": ["freeform content type validation unrelated to file selection", "display-only file badges"],
      "usedBy": ["violet-file-upload"]
    },
    {
      "name": "invalid",
      "property": "invalid",
      "valueType": "boolean",
      "category": "validation",
      "definition": "Indicates that the control or field should present invalid styling and invalid accessibility semantics.",
      "useFor": ["form-associated controls", "selection controls with explicit validation requirements"],
      "doNotUseFor": ["warning-only states", "application errors unrelated to the control's value"],
      "usedBy": ["violet-checkbox", "violet-radio", "violet-radio-group", "violet-slider", "violet-switch", "violet-text-field", "violet-text-area", "violet-range-slider", "violet-select", "violet-combobox", "violet-segmented-control", "violet-date-picker", "violet-time-picker", "violet-date-range-picker", "violet-file-upload", "violet-color-picker", "violet-data-grid-pill-select"]
    },
    {
      "name": "value",
      "property": "value",
      "valueType": "string",
      "category": "data",
      "definition": "Carries the current scalar value of a form control wrapper.",
      "useFor": ["text fields", "text areas", "single-value native-like controls"],
      "doNotUseFor": ["row collections", "complex objects", "display-only labels"],
      "usedBy": ["violet-checkbox", "violet-radio", "violet-radio-group", "violet-slider", "violet-switch", "violet-text-field", "violet-text-area", "violet-chat-composer", "violet-listbox", "violet-option", "violet-select", "violet-combobox", "violet-progress", "violet-segment", "violet-segmented-control", "violet-calendar", "violet-date-picker", "violet-time-picker", "violet-color-picker", "violet-color-swatch", "violet-tree", "violet-tree-item", "violet-data-grid-pill-select", "violet-data-grid-rating"]
    },
    {
      "name": "value-start",
      "property": "valueStart",
      "valueType": "string",
      "category": "data",
      "definition": "Carries the lower bound value of a dual-thumb range control.",
      "useFor": ["range sliders with two handles"],
      "doNotUseFor": ["single-value controls"],
      "usedBy": ["violet-range-slider"]
    },
    {
      "name": "value-end",
      "property": "valueEnd",
      "valueType": "string",
      "category": "data",
      "definition": "Carries the upper bound value of a dual-thumb range control.",
      "useFor": ["range sliders with two handles"],
      "doNotUseFor": ["single-value controls"],
      "usedBy": ["violet-range-slider"]
    },
    {
      "name": "label-start",
      "property": "labelStart",
      "valueType": "string",
      "category": "a11y",
      "definition": "Accessible label for the lower thumb of a dual-thumb range control.",
      "useFor": ["range sliders with two handles that need distinct screen-reader labels per thumb"],
      "doNotUseFor": ["primary field labels", "single-value controls"],
      "usedBy": ["violet-range-slider"]
    },
    {
      "name": "label-end",
      "property": "labelEnd",
      "valueType": "string",
      "category": "a11y",
      "definition": "Accessible label for the upper thumb of a dual-thumb range control.",
      "useFor": ["range sliders with two handles that need distinct screen-reader labels per thumb"],
      "doNotUseFor": ["primary field labels", "single-value controls"],
      "usedBy": ["violet-range-slider"]
    },
    {
      "name": "icon",
      "property": "icon",
      "valueType": "string",
      "category": "content",
      "definition": "Selects an icon asset from a component-owned icon registry or packaged icon source.",
      "useFor": ["icon primitives", "components that intentionally resolve icons from an internal named registry"],
      "doNotUseFor": ["form field names", "visual labels", "arbitrary image URLs"],
      "usedBy": ["violet-icon", "violet-badge"]
    },
    {
      "name": "src",
      "property": "src",
      "valueType": "string",
      "category": "content",
      "definition": "Supplies the media source URL for a component that renders a native image resource.",
      "useFor": ["image primitives", "other media components that intentionally wrap a native image source"],
      "doNotUseFor": ["icon registry names", "fallback labels", "component identifiers"],
      "usedBy": ["violet-image"]
    },
    {
      "name": "alt",
      "property": "alt",
      "valueType": "string",
      "category": "accessibility",
      "definition": "Provides the alternative text for an informative image when the component renders a native image element.",
      "useFor": ["image primitives", "other components that expose meaningful raster or photo content"],
      "doNotUseFor": ["decorative images marked with decorative", "captions", "adjacent visible headings"],
      "usedBy": ["violet-image"]
    },
    {
      "name": "label",
      "property": "label",
      "valueType": "string",
      "category": "content",
      "definition": "Provides the primary text label or internal accessible name for a control when the component owns its label rendering or accessible naming internally.",
      "useFor": ["field wrappers", "control shells with internal label placement", "icon-only controls that need an explicit accessible name"],
      "doNotUseFor": ["button body content that should come from a slot", "decorative headings"],
      "usedBy": ["violet-icon", "violet-icon-button", "violet-persona", "violet-progress", "violet-radio-group", "violet-slider", "violet-spinner", "violet-badge", "violet-text-field", "violet-text-area", "violet-range-slider", "violet-reasoning-block", "violet-chat-composer", "violet-listbox", "violet-option", "violet-option-group", "violet-select", "violet-combobox", "violet-segmented-control", "violet-breadcrumb", "violet-pagination", "violet-carousel", "violet-date-picker", "violet-time-picker", "violet-date-range-picker", "violet-file-upload", "violet-color-picker", "violet-color-swatch", "violet-tree", "violet-file-explorer"]
    },
    {
      "name": "control-label",
      "property": "controlLabel",
      "valueType": "string",
      "category": "accessibility",
      "definition": "Names the field edited by the data-grid pill selector; its trigger combines this name with the current selected value.",
      "useFor": ["the existing data-grid pill selector field-name contract"],
      "doNotUseFor": ["selected option text", "new general controls that use label"],
      "usedBy": ["violet-data-grid-pill-select"],
      "notes": ["Preserves the existing control-label API used by custom grid editor templates."]
    },
    {
      "name": "aria-label",
      "property": "ariaLabel",
      "valueType": "string",
      "category": "accessibility",
      "definition": "Provides an explicit ARIA label when visible label content is absent and the component needs a direct accessible name.",
      "useFor": ["composite widgets that need a fallback accessible name", "controls whose visible label is intentionally omitted"],
      "doNotUseFor": ["components that already render a visible label and can reference it internally", "duplicating adjacent visible text without need"],
      "usedBy": ["violet-gantt", "violet-tree", "violet-data-grid-rating"]
    },
    {
      "name": "aria-controls",
      "property": "ariaControls",
      "valueType": "string",
      "category": "accessibility",
      "definition": "Identifies the element whose content or presence is controlled by an interactive trigger.",
      "useFor": ["button wrappers that forward a controls relationship to their native control"],
      "doNotUseFor": ["visual grouping without an interactive control relationship", "references to unrelated content"],
      "usedBy": ["violet-button"]
    },
    {
      "name": "aria-expanded",
      "property": "ariaExpanded",
      "valueType": "string",
      "category": "accessibility",
      "definition": "Indicates whether content controlled by an interactive trigger is currently expanded or collapsed.",
      "useFor": ["button wrappers that forward disclosure or popup state to their native control"],
      "doNotUseFor": ["selection state", "visibility that is unrelated to the control"],
      "usedBy": ["violet-button"]
    },
    {
      "name": "aria-pressed",
      "property": "ariaPressed",
      "valueType": "string",
      "category": "accessibility",
      "definition": "Indicates the pressed state of a toggle button: \"true\", \"false\" or \"mixed\".",
      "useFor": ["button wrappers that act as a toggle and forward their pressed state to their native control"],
      "doNotUseFor": ["selection state of options or rows", "disclosure state (use aria-expanded)"],
      "usedBy": ["violet-button"]
    },
    {
      "name": "aria-haspopup",
