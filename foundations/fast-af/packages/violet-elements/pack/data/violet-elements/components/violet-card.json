	"status": "stable",
	"summary": "Surface that frames related content, with optional header and footer slots.",
	"tag": "violet-card",
	"usage": [
		{
			"basis": "authored",
			"id": "card.padding",
			"text": "Padding defaults to none, so content touches the edge: set small, medium or large, or the --violet-card-padding custom property, which overrides every preset. Header and footer show only when filled."
		},
		{
			"basis": "authored",
			"id": "card.interactive",
			"text": "The interactive attribute only adds tabindex=\"0\", role=\"group\" (unless a role is set) and hover and focus styling. It handles no keys and fires no event: add click and Enter/Space handling, or put a real button or link inside."
		}
	]
}
