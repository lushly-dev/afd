		],
		"events": [
			{
				"basis": "declared",
				"description": "Emitted when the dismiss control is activated.",
				"name": "dismiss"
			}
		],
		"slots": [
			{
				"basis": "observed",
				"description": "Alert body content.",
				"name": ""
			},
			{
				"basis": "observed",
				"description": "Optional action buttons or links.",
				"name": "actions"
			},
			{
				"basis": "observed",
				"description": "Optional leading icon that overrides the default tone icon.",
				"name": "icon"
			},
			{
				"basis": "observed",
				"description": "Optional alert heading.",
				"name": "title"
			}
		]
	},
	"examples": [
		{
			"basis": "observed",
			"from": "components-alert--assertive-announcement",
			"html": "<violet-alert announcement=\"assertive\" tone=\"danger\">\n            <span slot=\"title\">Propagation update</span>\n            Tray transplant is now the default path for late-spring greens in this plan.\n            <span slot=\"actions\">\n                <violet-button appearance=\"secondary\" type=\"button\">Review changes</violet-button>\n            </span>\n        </violet-alert>"
		},
		{
			"basis": "observed",
			"from": "components-alert--dismiss-interaction",
			"html": "<violet-alert announcement=\"off\" dismissible tone=\"warning\">\n            <span slot=\"title\">Propagation update</span>\n            Tray transplant is now the default path for late-spring greens in this plan.\n            <span slot=\"actions\">\n                <violet-button appearance=\"secondary\" type=\"button\">Review changes</violet-button>\n            </span>\n        </violet-alert>"
		},
		{
			"basis": "observed",
			"from": "components-alert--dismissible",
			"html": "<violet-alert announcement=\"off\" dismissible tone=\"warning\">\n            <span slot=\"title\">Propagation update</span>\n            Tray transplant is now the default path for late-spring greens in this plan.\n            <span slot=\"actions\">\n                <violet-button appearance=\"secondary\" type=\"button\">Review changes</violet-button>\n            </span>\n        </violet-alert>"
		}
	],
	"format": 1,
	"gaps": [
		{
			"kind": "role"
		}
	],
	"import": "@lushly-dev/violet-elements",
	"rules": [
		"import.root",
		"message.announcement",
		"message.tone",
		"taxonomy.announcement",
		"taxonomy.dismissible",
		"taxonomy.tone"
	],
	"status": "stable",
	"summary": "Persistent inline message with tone, optional title, actions and dismiss button.",
	"tag": "violet-alert",
	"usage": [
		{
			"basis": "authored",
			"id": "alert.dismiss",
			"text": "The dismissible attribute shows a close button that only fires a dismiss event (no detail). The alert stays in place until the page removes or hides it."
		},
		{
			"basis": "authored",
			"id": "alert.content",
			"text": "The title slot renders in a p, not a heading. Tones default and info show no icon unless the icon slot is filled; success, warning and danger show a default icon."
		}
	]
}
