		{
			"basis": "observed",
			"from": "conversation-message--all-roles",
			"html": "<div style=\"display: flex; flex-direction: column; gap: 12px; max-inline-size: 600px;\"><violet-message message-role=\"system\" tone=\"default\"><violet-message-text state=\"done\">Session started.</violet-message-text></violet-message><violet-message message-role=\"user\" tone=\"default\"><violet-message-text state=\"done\">What is composting?</violet-message-text></violet-message><violet-message message-role=\"assistant\" tone=\"default\"><violet-message-text state=\"done\">Composting is the natural process of recycling organic matter, such as food scraps and yard waste, into a nutrient-rich soil amendment.</violet-message-text></violet-message><violet-message message-role=\"user\" tone=\"default\"><violet-message-text state=\"done\">How long does it take?</violet-message-text></violet-message><violet-message message-role=\"assistant\" tone=\"default\"><violet-message-text state=\"done\">Hot composting can produce usable compost in 4-8 weeks. Cold composting takes 6-12 months but requires less effort.</violet-message-text></violet-message></div>"
		},
		{
			"basis": "observed",
			"from": "conversation-message--error-tone",
			"html": "<violet-message message-role=\"assistant\" tone=\"error\"><violet-message-text state=\"done\">I encountered an error while processing your request. Please try again.</violet-message-text></violet-message>"
		},
		{
			"basis": "observed",
			"from": "conversation-message--overview",
			"html": "<violet-message message-role=\"assistant\" tone=\"default\"><violet-message-text state=\"done\">Hostas, ferns, and astilbe are excellent choices for partial shade gardens. They require minimal maintenance and provide beautiful foliage throughout the growing season.</violet-message-text></violet-message>"
		}
