{
	"a11y": {
		"axe": {
			"basis": "observed",
			"exceptions": [],
			"violations": 0
		},
		"role": [],
		"statements": [
			{
				"basis": "authored",
				"id": "empty-state.heading",
				"text": "The heading attribute always renders as an h3; its level cannot be changed. Where h3 does not fit the outline, leave heading empty and put your own heading in the default slot."
			},
			{
				"basis": "authored",
				"id": "empty-state.announce",
				"text": "It has no role or live region. When it replaces results after a search or filter, announce the change elsewhere, for example with a status message."
			},
			{
				"basis": "authored",
				"id": "empty-state.media",
				"text": "Media is read as is: give a purely decorative illustration alt=\"\" (or decorative on violet-image) so it is skipped."
			}
		]
	},
	"api": {
		"attributes": [
			{
				"basis": "observed",
				"default": "plain",
				"name": "appearance",
				"property": "appearance",
				"rules": [
					"taxonomy.appearance"
				],
				"type": "VioletEmptyStateAppearance"
			},
			{
				"basis": "observed",
				"default": "",
				"name": "heading",
				"property": "heading",
				"rules": [
					"taxonomy.heading"
				],
				"type": "string"
			},
			{
				"basis": "observed",
				"default": "",
				"name": "message",
				"property": "message",
				"rules": [
					"taxonomy.message"
				],
				"type": "string"
			},
			{
