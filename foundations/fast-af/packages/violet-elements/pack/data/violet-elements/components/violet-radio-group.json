	"status": "stable",
	"summary": "Form field that holds violet-radio children and submits the one selected value; use for a single choice among a few visible options.",
	"tag": "violet-radio-group",
	"usage": [
		{
			"basis": "authored",
			"id": "radio-group.value",
			"text": "Set the group's value to a radio's value to select it; with no group value, a radio marked checked is used. The group overwrites each radio's checked state, tabindex and, when it has a name, its name."
		},
		{
			"basis": "authored",
			"id": "radio-group.change",
			"text": "A click delivers two change events to a group listener: the group's own (detail.value) and the clicked radio's bubbling one (detail.checked). Keyboard selection delivers only the group's. Check event.target."
		},
		{
			"basis": "authored",
			"id": "radio-group.keyboard",
			"text": "The group is one tab stop. Arrow keys, Home and End move focus and select in the same step, skipping disabled radios and wrapping at the ends."
		}
	]
}
