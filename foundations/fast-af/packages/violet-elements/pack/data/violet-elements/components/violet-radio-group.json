		{
			"basis": "observed",
			"from": "components-radio-group--invalid",
			"html": "<violet-radio-group label=\"Sowing method\" supporting-text=\"Use invalid state when a server-side rule rejects the selection.\" error-text value name=\"sowingMethod\" invalid orientation=\"vertical\"><violet-radio role=\"radio\" aria-checked=\"false\" tabindex=\"0\" name=\"sowingMethod\" value=\"broadcast\">Broadcast sowing<span slot=\"supporting\">Dense sowing for baby leaf or nursery staging.</span></violet-radio><violet-radio role=\"radio\" aria-checked=\"false\" tabindex=\"-1\" name=\"sowingMethod\" value=\"direct\">Direct seed<span slot=\"supporting\">Seed directly into the finished bed.</span></violet-radio><violet-radio role=\"radio\" aria-checked=\"false\" tabindex=\"-1\" name=\"sowingMethod\" value=\"transplant\">Tray transplant<span slot=\"supporting\">Raise in trays first, then move into the block.</span></violet-radio></violet-radio-group>"
