			"from": "components-carousel--card-strip",
			"html": "<div style=\"max-inline-size: 34rem;\">\n            <violet-carousel label=\"Card strip carousel\" appearance=\"plain\" active-index=\"0\" slides-per-view=\"2\" style=\"--_carousel-slides-per-view: 2;\">\n                \n        <violet-card appearance=\"filled\" padding=\"large\" style=\"--violet-card-background:rgba(222, 234, 223, 0.95); min-block-size: 16rem; block-size: 100%;\" data-label=\"Propagation dashboard\" data-carousel-index=\"0\" data-carousel-label=\"Propagation dashboard\" data-active aria-hidden=\"false\" orientation=\"vertical\">\n            <violet-text as=\"h3\" variant=\"title-sm\" tone=\"default\">Propagation dashboard</violet-text>\n            <violet-text as=\"p\" variant=\"body\" tone=\"secondary\" style=\"display:block; margin-block-start:12px;\">\n                Track sowing method, tray count, and current greenhouse staffing in one quick review panel.\n            </violet-text>\n        </violet-card>\n    \n        <violet-card appearance=\"filled\" padding=\"large\" style=\"--violet-card-background:rgba(226, 238, 247, 0.95); min-block-size: 16rem; block-size: 100%;\" data-label=\"Watering reminders\" data-carousel-index=\"1\" data-carousel-label=\"Watering reminders\" data-active aria-hidden=\"false\" orientation=\"vertical\">\n            <violet-text as=\"h3\" variant=\"title-sm\" tone=\"default\">Watering reminders</violet-text>\n            <violet-text as=\"p\" variant=\"body\" tone=\"secondary\" style=\"display:block; margin-block-start:12px;\">\n                Coordinate moisture checks, next irrigation windows, and exception alerts for the active block.\n            </violet-text>\n        </violet-card>\n    \n        <violet-card appearance=\"filled\" padding=\"large\" style=\"--violet-card-background:rgba(248, 238, 224, 0.95); min-block-size: 16rem; block-size: 100%;\" data-label=\"Harvest prep\" data-carousel-index=\"2\" data-carousel-label=\"Harvest prep\" inert aria-hidden=\"true\" orientation=\"vertical\">\n            <violet-text as=\"h3\" variant=\"title-sm\" tone=\"default\">Harvest prep</violet-text>\n            <violet-text as=\"p\" variant=\"body\" tone=\"secondary\" style=\"display:block; margin-block-start:12px;\">\n                Keep cut lists, pack-out tasks, and fulfillment notes aligned before the crew starts its pass.\n            </violet-text>\n        </violet-card>\n    \n            </violet-carousel>\n        </div>"
		},
