			"html": "<div style=\"max-inline-size: 28rem;\">\n            <violet-tree label=\"Disabled tree item\" appearance=\"plain\" supporting-text error-text value>\n                <violet-tree-item value=\"workspace\" expanded role=\"treeitem\" aria-level=\"1\" aria-posinset=\"1\" aria-setsize=\"1\" aria-selected=\"false\" tabindex=\"0\" id=\"violet-tree-item-0\" aria-expanded=\"true\" style=\"--_tree-level: 1;\">\n                    Workspace\n                    <violet-tree-item value=\"analytics\" disabled role=\"treeitem\" aria-level=\"2\" aria-posinset=\"1\" aria-setsize=\"1\" aria-selected=\"false\" aria-disabled=\"true\" tabindex=\"-1\" slot=\"item\" id=\"violet-tree-item-1\" style=\"--_tree-level: 2;\">Analytics</violet-tree-item>\n                </violet-tree-item>\n            </violet-tree>\n        </div>"
