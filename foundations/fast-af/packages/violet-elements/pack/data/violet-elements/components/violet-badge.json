	"examples": [
		{
			"basis": "observed",
			"from": "components-badge--appearances",
			"html": "<div style=\"display:flex;flex-wrap:wrap;gap:12px;align-items:center;\">\n            <violet-badge appearance=\"filled\" color=\"accent\" icon label size=\"md\">Filled</violet-badge>\n            <violet-badge appearance=\"outline\" color=\"accent\" icon label size=\"md\">Outline</violet-badge>\n            <violet-badge appearance=\"subtle\" color=\"accent\" icon label size=\"md\">Subtle</violet-badge>\n        </div>"
		},
		{
			"basis": "observed",
			"from": "components-badge--decorative",
			"html": "<violet-badge appearance=\"filled\" aria-hidden=\"true\" color=\"warning\" decorative icon label size=\"md\">Trial</violet-badge>"
		},
		{
			"basis": "observed",
			"from": "components-badge--icon-only",
			"html": "<violet-badge appearance=\"filled\" aria-label=\"Saved\" color=\"accent\" icon=\"system/check\" label=\"Saved\" role=\"img\" size=\"md\"></violet-badge>"
		}
	],
	"format": 1,
	"gaps": [
		{
			"kind": "role"
		}
	],
	"import": "@lushly-dev/violet-elements",
	"rules": [
		"a11y.decorative",
		"import.root",
		"taxonomy.appearance",
		"taxonomy.color",
		"taxonomy.decorative",
		"taxonomy.icon",
		"taxonomy.label",
		"taxonomy.size"
	],
	"status": "stable",
	"summary": "Compact, non-interactive inline label for a status, category or count.",
	"tag": "violet-badge",
	"usage": [
		{
			"basis": "authored",
			"id": "badge.content",
			"text": "Short text goes in the default slot. The icon attribute is a registry name (see violet-icon; register it first) rendered before the text and always decorative."
		},
		{
			"basis": "authored",
			"id": "badge.color",
			"text": "color is visual only, so the text must state the status itself. A badge has no events; do not put buttons or links in it."
		}
	]
}
