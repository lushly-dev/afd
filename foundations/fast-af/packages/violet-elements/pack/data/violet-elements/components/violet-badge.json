{
	"a11y": {
		"axe": {
			"basis": "observed",
			"exceptions": [],
			"violations": 0
		},
		"role": [],
		"statements": [
			{
				"basis": "authored",
				"id": "badge.label",
				"text": "The label attribute gives the host role img named by it, replacing the slotted text for assistive technology. Use it when the text alone, such as a bare count, is not meaningful."
			},
			{
				"basis": "authored",
				"id": "badge.decorative",
				"text": "decorative sets aria-hidden on the host and drops any role and label; use it only when nearby text already says the same thing."
			}
		]
	},
	"api": {
		"attributes": [
			{
				"basis": "observed",
				"default": "filled",
				"name": "appearance",
				"property": "appearance",
				"rules": [
					"taxonomy.appearance"
				],
				"type": "VioletBadgeAppearance"
			},
			{
				"basis": "observed",
				"default": "neutral",
				"name": "color",
				"property": "color",
				"rules": [
					"taxonomy.color"
				],
				"type": "VioletBadgeColor"
			},
			{
				"basis": "observed",
				"default": false,
				"name": "decorative",
				"property": "decorative",
				"rules": [
					"taxonomy.decorative"
				],
				"type": "boolean"
			},
			{
				"basis": "observed",
				"default": "",
				"name": "icon",
				"property": "icon",
