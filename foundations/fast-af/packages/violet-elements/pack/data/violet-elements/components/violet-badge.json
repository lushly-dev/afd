			{
				"basis": "declared",
				"default": "var(--_surface-subtle)",
				"name": "--_badge-bg"
			},
			{
				"basis": "declared",
				"default": "var(--_border-subtle)",
				"name": "--_badge-border"
			},
			{
				"basis": "declared",
				"default": "var(--_caption-size)",
