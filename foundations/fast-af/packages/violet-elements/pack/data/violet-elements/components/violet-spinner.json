	"status": "stable",
	"summary": "Small indeterminate loading indicator for a local wait, such as inside a button or a panel that is loading.",
	"tag": "violet-spinner",
	"usage": [
		{
			"basis": "authored",
			"id": "spinner.status",
			"text": "It shows activity only. Announce when loading starts and ends with text in a status region of your own, and remove the spinner when done."
		},
		{
			"basis": "authored",
			"id": "spinner.motion",
			"text": "Under prefers-reduced-motion the rotation slows to 1.6 seconds per turn rather than stopping."
		}
	]
