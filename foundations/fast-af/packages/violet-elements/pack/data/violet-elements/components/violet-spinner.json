{
	"a11y": {
		"axe": {
			"basis": "observed",
			"exceptions": [],
			"violations": 0
		},
		"role": [],
		"statements": [
			{
				"basis": "authored",
				"id": "spinner.name",
				"text": "Unless decorative, it is role img named by the label attribute, default \"Loading\". It is not a live region, so it announces nothing when it appears."
			},
			{
				"basis": "authored",
				"id": "spinner.decorative",
				"text": "Set decorative when visible text nearby, such as \"Saving...\", already says it is loading; it is then hidden from assistive technology."
			}
		]
	},
	"api": {
		"attributes": [
			{
				"basis": "observed",
				"default": false,
				"name": "decorative",
				"property": "decorative",
				"rules": [
					"taxonomy.decorative"
				],
				"type": "boolean"
			},
			{
				"basis": "observed",
				"default": "",
				"name": "label",
				"property": "label",
				"rules": [
					"taxonomy.label"
				],
				"type": "string"
			},
			{
				"basis": "observed",
				"default": "md",
				"name": "size",
				"property": "size",
				"rules": [
