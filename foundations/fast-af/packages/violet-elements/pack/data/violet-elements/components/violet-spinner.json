			}
		],
		"events": [],
		"slots": []
	},
	"examples": [
		{
			"basis": "observed",
			"from": "components-spinner--decorative",
			"html": "<violet-spinner decorative size=\"sm\" label></violet-spinner>"
		},
		{
			"basis": "observed",
			"from": "components-spinner--in-context",
