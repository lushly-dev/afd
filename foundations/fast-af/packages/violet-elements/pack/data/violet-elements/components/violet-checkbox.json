		"statements": [
			{
				"basis": "authored",
				"id": "checkbox.name",
				"text": "The slotted label text is copied to the input as a plain-text aria-label; an aria-label on the host overrides it. Text in the supporting slot is visible but is not linked as a description."
			}
		]
	},
