	"examples": [
		{
			"basis": "observed",
			"from": "components-checkbox--checked",
			"html": "<violet-checkbox checked name=\"trackSeedLot\" value=\"yes\">Track seed lot<span slot=\"supporting\">Selection persists when the lot is already assigned.</span></violet-checkbox>"
		},
		{
			"basis": "observed",
			"from": "components-checkbox--disabled",
			"html": "<violet-checkbox disabled name=\"trackSeedLot\" value=\"yes\">Track seed lot<span slot=\"supporting\">Disabled while this batch is locked for review.</span></violet-checkbox>"
		},
		{
			"basis": "observed",
			"from": "components-checkbox--indeterminate-inline",
			"html": "<violet-checkbox aria-label=\"Select all plants\" indeterminate inline name=\"selectAllPlants\" value=\"yes\"></violet-checkbox>"
		}
	],
	"format": 0,
	"gaps": [
		{
			"kind": "role"
		}
	],
	"import": "@lushly-dev/violet-elements",
	"rules": [
		"form.invalid",
		"form.participation",
		"import.root",
		"taxonomy.checked",
		"taxonomy.disabled",
		"taxonomy.indeterminate",
		"taxonomy.inline",
		"taxonomy.invalid",
		"taxonomy.name",
		"taxonomy.required",
		"taxonomy.value",
		"theme.install",
		"toggle.form-value",
		"toggle.label"
	],
	"status": "stable",
	"summary": "Form checkbox with a slotted label, optional supporting text and an indeterminate state; use for independent on/off choices.",
	"tag": "violet-checkbox",
	"usage": [
		{
			"basis": "authored",
			"id": "checkbox.indeterminate",
			"text": "The indeterminate attribute is a display and ARIA state only. A user toggle clears it, it does not change what the form receives, and form reset restores it."
		},
		{
			"basis": "verified",
			"id": "checkbox.required",
			"text": "The required attribute is satisfied only while checked."
		}
	]
}
