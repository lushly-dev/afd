	"examples": [
		{
			"basis": "observed",
			"from": "components-listbox--disabled",
			"html": "<violet-listbox disabled label=\"Propagation method\" value=\"direct\"><violet-option aria-selected=\"false\" id=\"violet-option-1\" label role=\"option\" value=\"broadcast\">Broadcast sowing<span slot=\"description\">Fast coverage over larger beds.</span></violet-option><violet-option aria-selected=\"true\" id=\"violet-option-2\" label role=\"option\" selected value=\"direct\">Direct seed<span slot=\"description\">Best when row spacing matters.</span></violet-option><violet-option aria-selected=\"false\" id=\"violet-option-3\" label role=\"option\" value=\"transplant\">Tray transplant<span slot=\"description\">More control before planting.</span></violet-option><violet-option aria-disabled=\"true\" aria-selected=\"false\" disabled id=\"violet-option-4\" label role=\"option\" value=\"hydroponic\">Hydroponic<span slot=\"description\">Not available in soil beds.</span></violet-option></violet-listbox>"
		},
		{
			"basis": "observed",
			"from": "components-listbox--grouped-options",
			"html": "<violet-listbox label=\"Seed source\" value=\"regional\"><violet-option-group label=\"Current suppliers\"><violet-option aria-selected=\"true\" id=\"violet-option-1\" label role=\"option\" selected value=\"regional\">Regional catalog<span slot=\"description\">Preferred for weekly reorders.</span></violet-option><violet-option aria-selected=\"false\" id=\"violet-option-2\" label role=\"option\" value=\"coop\">Local co-op<span slot=\"description\">Best for regional seed stock.</span></violet-option></violet-option-group><violet-option-group disabled label=\"Archived suppliers\"><violet-option aria-disabled=\"true\" aria-selected=\"false\" id=\"violet-option-3\" label role=\"option\" value=\"legacy\">Legacy inventory<span slot=\"description\">Carryover lots from last year.</span></violet-option><violet-option aria-disabled=\"true\" aria-selected=\"false\" id=\"violet-option-4\" label role=\"option\" value=\"overflow\">Overflow greenhouse<span slot=\"description\">Unavailable this cycle.</span></violet-option></violet-option-group></violet-listbox>"
		},
		{
			"basis": "observed",
			"from": "components-listbox--overview",
			"html": "<violet-listbox label=\"Propagation method\" value=\"transplant\"><violet-option aria-selected=\"false\" id=\"violet-option-1\" label role=\"option\" value=\"broadcast\">Broadcast sowing<span slot=\"description\">Fast coverage over larger beds.</span></violet-option><violet-option aria-selected=\"false\" id=\"violet-option-2\" label role=\"option\" value=\"direct\">Direct seed<span slot=\"description\">Best when row spacing matters.</span></violet-option><violet-option aria-selected=\"true\" id=\"violet-option-3\" label role=\"option\" selected value=\"transplant\">Tray transplant<span slot=\"description\">More control before planting.</span></violet-option><violet-option aria-disabled=\"true\" aria-selected=\"false\" disabled id=\"violet-option-4\" label role=\"option\" value=\"hydroponic\">Hydroponic<span slot=\"description\">Not available in soil beds.</span></violet-option></violet-listbox>"
		}
	],
	"format": 1,
	"gaps": [
		{
			"kind": "role"
		}
	],
	"import": "@lushly-dev/violet-elements",
	"rules": [
		"a11y.managed",
		"field.aria-label",
		"import.root",
		"options.children",
		"taxonomy.disabled",
		"taxonomy.label",
		"taxonomy.multiple",
		"taxonomy.selection-follows-focus",
		"taxonomy.value",
		"theme.install"
	],
	"status": "stable",
	"summary": "Always-visible list of violet-option children for choosing one value, or several with multiple; not a form field.",
	"tag": "violet-listbox",
	"usage": [
		{
			"basis": "authored",
			"id": "listbox.not-form",
			"text": "It is not form-associated and has no name attribute. Read the value property, or selectedValues in multiple mode, and submit it yourself."
		},
		{
			"basis": "authored",
			"id": "listbox.multiple",
			"text": "With multiple, the selection is the selectedValues array property (no attribute) and value mirrors its first entry. Options marked selected seed it."
		},
		{
			"basis": "authored",
			"id": "listbox.events",
			"text": "User selection fires input and change with detail.value, plus detail.selectedValues in multiple mode. selectValue(v) and toggleValue(v) fire them too unless their second argument is false."
		},
		{
			"basis": "authored",
			"id": "listbox.keyboard",
			"text": "One tab stop. Arrows, Home, End and type-ahead move the highlight; Enter or Space selects, or toggles in multiple mode, where Ctrl or Cmd+A toggles all. selection-follows-focus selects while moving, single mode only."
		}
	]
}
