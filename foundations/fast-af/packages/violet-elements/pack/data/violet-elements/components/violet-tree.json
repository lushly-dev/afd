	"status": "stable",
	"summary": "Single-selection tree view of nested violet-tree-item elements, for hierarchies such as folders or categories.",
	"tag": "violet-tree",
	"usage": [
		{
			"basis": "authored",
			"id": "tree.structure",
			"text": "Children are violet-tree-item elements; nest an item inside another to make a branch. Only the tree's direct item children are its root items."
		},
		{
			"basis": "authored",
			"id": "tree.value",
			"text": "value selects the item whose value matches, or whose label text matches when the item has no value. With no tree value, an item marked selected is used."
		},
		{
			"basis": "authored",
			"id": "tree.events",
			"text": "change fires on user selection with detail { value, itemId }; setting value from script fires nothing. expanded-change fires only when the user expands or collapses a branch."
		},
		{
			"basis": "authored",
			"id": "tree.not-form",
			"text": "It is not form-associated: a form does not receive its value and there is no invalid attribute. Read value or listen for change; error-text shows whenever it is set."
		},
		{
			"basis": "authored",
			"id": "tree.keyboard",
			"text": "Arrows move focus without selecting; Enter or Space selects. Right expands or enters a branch, Left collapses or goes to the parent, Home and End jump, typed letters find an item."
		}
	]
}
