tree-item>\n                <violet-tree-item aria-level=\"1\" aria-posinset=\"2\" aria-selected=\"false\" aria-setsize=\"3\" id=\"violet-tree-item-6\" role=\"treeitem\" style=\"--_tree-level: 1;\" tabindex=\"-1\" value=\"inventory\">Inventory</violet-tree-item>\n                <violet-tree-item aria-level=\"1\" aria-posinset=\"3\" aria-selected=\"false\" aria-setsize=\"3\" id=\"violet-tree-item-7\" role=\"treeitem\" style=\"--_tree-level: 1;\" tabindex=\"-1\" value=\"reports\">Reports</violet-tree-item>\n            </violet-tree>\n        </div>"
