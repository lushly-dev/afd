				"name": "heading"
			}
		]
	},
	"examples": [
		{
			"basis": "observed",
			"from": "components-accordion-item--disabled",
			"html": "<div style=\"max-inline-size: 42rem;\"><violet-accordion-item disabled heading-level=\"3\"><span slot=\"heading\">Propagation planning</span>Coordinate sowing windows, propagation media, and bench allocation before crop launch.</violet-accordion-item></div>"
		},
		{
			"basis": "observed",
			"from": "components-accordion-item--expanded",
			"html": "<div style=\"max-inline-size: 42rem;\"><violet-accordion-item expanded heading-level=\"3\"><span slot=\"heading\">Propagation planning</span>Coordinate sowing windows, propagation media, and bench allocation before crop launch.</violet-accordion-item></div>"
		},
		{
			"basis": "observed",
			"from": "components-accordion-item--overview",
			"html": "<div style=\"max-inline-size: 42rem;\"><violet-accordion-item expanded heading-level=\"3\"><span slot=\"heading\">Propagation planning</span>Coordinate sowing windows, propagation media, and bench allocation before crop launch.</violet-accordion-item></div>"
		}
	],
	"format": 0,
	"gaps": [
		{
			"kind": "unobserved",
			"name": "heading-level",
			"section": "attributes"
