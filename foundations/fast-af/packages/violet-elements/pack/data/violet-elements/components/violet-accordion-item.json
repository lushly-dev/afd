		"statements": [
			{
				"basis": "authored",
				"id": "accordion-item.level",
				"text": "The heading-level attribute (1 to 6, default 3; other values become 3) sets the header's aria-level. Match it to the page's heading outline."
			},
			{
				"basis": "authored",
				"id": "accordion-item.region",
				"text": "An expanded panel is a region labelled by its header button, so keep each heading slot's text short and distinct."
			}
		]
	},
	"api": {
		"attributes": [
			{
				"basis": "observed",
				"default": false,
				"name": "disabled",
				"property": "disabled",
				"rules": [
					"taxonomy.disabled"
				],
				"type": "boolean"
			},
			{
				"basis": "observed",
				"default": false,
				"name": "expanded",
				"property": "expanded",
				"rules": [
					"taxonomy.expanded"
				],
				"type": "boolean"
			},
			{
				"basis": "declared",
				"default": 3,
				"name": "heading-level",
				"property": "headingLevel",
				"rules": [
					"taxonomy.heading-level"
				],
				"type": "number"
			}
		],
		"commands": [],
		"cssProperties": [
			{
				"basis": "declared",
				"default": "var(--violet-accordion-item-background, var(--_surface-page))",
				"name": "--_accordion-item-background"
			},
			{
				"basis": "declared",
				"default": "var(--violet-accordion-item-background-expanded, var(--_surface-card))",
				"name": "--_accordion-item-background-expanded"
			},
			{
				"basis": "declared",
				"default": "var(--violet-accordion-item-background-hover, var(--_surface-subtle))",
