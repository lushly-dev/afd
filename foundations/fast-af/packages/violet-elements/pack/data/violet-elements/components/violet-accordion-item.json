	"import": "@lushly-dev/violet-elements",
	"rules": [
		"a11y.managed",
		"import.root",
		"taxonomy.disabled",
		"taxonomy.expanded",
		"taxonomy.heading-level",
		"theme.install"
	],
	"status": "stable",
	"summary": "One collapsible section of a violet-accordion, with a heading slot and a body.",
	"tag": "violet-accordion-item",
	"usage": [
		{
			"basis": "authored",
			"id": "accordion-item.parent",
			"text": "Use it inside violet-accordion: its header button only fires a toggle-request event (detail.expanded), and the accordion sets the expanded attribute. Alone, a click changes nothing unless the page handles that event."
		},
		{
			"basis": "authored",
			"id": "accordion-item.slots",
			"text": "Header text goes in the heading slot, which renders inside a button, so put no interactive or heading elements there. The body is the default slot. The expanded attribute in markup opens it initially."
		}
	]
}
