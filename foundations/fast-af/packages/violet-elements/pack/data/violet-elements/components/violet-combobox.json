		"statements": [
			{
				"basis": "authored",
				"id": "combobox.name",
				"text": "Set label: without it the input has no programmatic label and browsers fall back to the placeholder. The popup list is named by the label, else the placeholder, else \"Options\"."
			},
			{
				"basis": "authored",
				"id": "combobox.active",
				"text": "Focus stays in the input; arrow keys move the highlighted option through aria-activedescendant and Enter chooses it."
			},
			{
				"basis": "authored",
				"id": "combobox.error",
				"text": "The rendered error message is linked to the input as its description, after the supporting text."
			}
		]
	},
