	"status": "stable",
	"summary": "Text input that filters a popup list of violet-option children; use when the list is long enough that the user should search it.",
	"tag": "violet-combobox",
	"usage": [
		{
			"basis": "authored",
			"id": "combobox.value",
			"text": "The value is the input text: after a choice, the option's label. The chosen option's value is the selectedOptionValue property, and the form receives that; raw text is submitted only when nothing is chosen."
		},
		{
			"basis": "authored",
			"id": "combobox.script",
			"text": "To choose from script call selectValue(optionValue). Assigning the value property later changes only the text, not selectedOptionValue. An initial value may be an option's value or its label."
		},
		{
			"basis": "authored",
			"id": "combobox.filter",
			"text": "Typing filters by label, ignoring case and punctuation; arrow keys skip non-matching options, and \"No matching options\" shows when none match. Unchosen text is discarded on Tab, Escape or an outside press."
		},
		{
			"basis": "authored",
			"id": "combobox.events",
			"text": "Choosing fires only change, with detail { value, selectedValue, label }. Typing fires input and a native commit fires change, each with { value, selectedValue }; selectedValue is empty for unchosen text."
		},
		{
			"basis": "authored",
			"id": "combobox.open",
			"text": "The list opens on focus, typing and arrow keys, and the open attribute reflects it. show() opens it; hide(true) closes it and resets the text to the chosen option's label, or empties it when nothing is chosen."
		}
	]
}
