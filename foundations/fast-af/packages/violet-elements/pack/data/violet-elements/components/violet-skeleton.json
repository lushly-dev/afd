	"status": "stable",
	"summary": "Decorative placeholder shape shown while content loads.",
	"tag": "violet-skeleton",
	"usage": [
		{
			"basis": "authored",
			"id": "skeleton.lines",
			"text": "The lines attribute repeats the bar as a text block with a shorter last line. It repeats circles too, so keep lines at 1 for shape=\"circle\". Animation is off unless animated is set."
		},
		{
			"basis": "authored",
			"id": "skeleton.size",
			"text": "Shapes rect and text draw the same bar: size sets its height (0.75 to 1rem) and the host's width sets its width, so size the host with CSS to match the content it stands in for."
		}
	]
