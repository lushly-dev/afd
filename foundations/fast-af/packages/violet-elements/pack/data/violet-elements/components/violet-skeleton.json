			"html": "<violet-card appearance=\"outline\" orientation=\"vertical\" padding=\"medium\" style=\"inline-size:22rem;\">\n            <div style=\"display:grid;grid-template-columns:auto 1fr;gap:12px;align-items:start;\">\n                <violet-skeleton aria-hidden=\"true\" lines=\"1\" shape=\"circle\" size=\"lg\"></violet-skeleton>\n                <div style=\"display:grid;gap:8px;\">\n                    <violet-skeleton aria-hidden=\"true\" lines=\"1\" shape=\"rect\" size=\"md\" style=\"inline-size:8rem;\"></violet-skeleton>\n                    <violet-skeleton aria-hidden=\"true\" lines=\"3\" shape=\"text\" size=\"md\"></violet-skeleton>\n                </div>\n            </div>\n        </violet-card>"
