		"slots": [
			{
				"basis": "observed",
				"description": "Switch label content.",
				"name": ""
			},
			{
				"basis": "observed",
				"description": "Optional supporting copy rendered under the label.",
				"name": "supporting"
			}
		]
	},
	"examples": [
		{
			"basis": "observed",
			"from": "components-switch--checked",
			"html": "<violet-switch checked name=\"trayRestocks\" value=\"enabled\">Auto-approve tray restocks<span slot=\"supporting\">Keeps replenishment requests moving without manual review.</span></violet-switch>"
		},
		{
			"basis": "observed",
			"from": "components-switch--disabled",
			"html": "<violet-switch disabled name=\"harvestSync\" value=\"enabled\">Enable harvest sync<span slot=\"supporting\">Unavailable while the field audit is in progress.</span></violet-switch>"
		},
		{
			"basis": "observed",
			"from": "components-switch--inline",
			"html": "<violet-switch aria-label=\"Compact irrigation alerts switch\" checked inline name=\"compactIrrigationAlerts\" value=\"enabled\"></violet-switch>"
		}
	],
	"format": 1,
	"gaps": [
