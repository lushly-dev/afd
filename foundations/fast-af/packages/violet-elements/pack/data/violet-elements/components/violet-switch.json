			{
				"basis": "declared",
				"default": "clamp(16px, calc(var(--_track-block-size) - 4px), 20px)",
				"name": "--_thumb-size"
			},
			{
				"basis": "declared",
				"default": "clamp(20px, calc(var(--_target-size) - 10px), 24px)",
