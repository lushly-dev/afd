		"taxonomy.required",
		"taxonomy.value",
		"theme.install",
		"toggle.form-value",
		"toggle.label"
	],
	"status": "stable",
	"summary": "On/off form toggle with a slotted label and optional supporting text; use for settings that take effect immediately.",
	"tag": "violet-switch",
	"usage": [
		{
			"basis": "verified",
			"id": "switch.required",
			"text": "The required attribute is satisfied only while the switch is on."
		},
		{
			"basis": "authored",
			"id": "switch.no-mixed",
			"text": "There is no indeterminate state; use violet-checkbox when a mixed state is needed."
		}
	]
