	"status": "stable",
	"summary": "Single-choice dropdown: a button that opens a list of violet-option children. Use when the user picks one value from a short fixed list.",
	"tag": "violet-select",
	"usage": [
		{
			"basis": "authored",
			"id": "select.value",
			"text": "The value attribute holds the chosen option's value and the trigger shows that option's label. With no value and no selected option nothing is chosen; the first option is not picked for you."
		},
		{
			"basis": "authored",
			"id": "select.unmatched",
			"text": "A value that matches no enabled option is kept: the trigger shows the raw value and the form receives it. Set value only to an existing option's value."
		},
		{
			"basis": "authored",
			"id": "select.events",
			"text": "Choosing an option fires input then change, each with detail.value, even when the same option is chosen again. selectValue(value) fires them too; assigning the value property does not."
		},
		{
			"basis": "authored",
			"id": "select.open",
			"text": "It opens on click, Enter, Space or the arrow keys, from the open attribute, or with show(); it closes on choice, Escape, an outside press or focus leaving. No event reports opening or closing."
		},
		{
			"basis": "authored",
			"id": "select.typeahead",
			"text": "Typing a character on the closed trigger selects the next option whose label starts with it and fires input and change without opening; while open, typing only moves the highlight."
		}
	]
}
