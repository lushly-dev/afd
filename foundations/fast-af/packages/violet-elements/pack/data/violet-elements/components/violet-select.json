		"statements": [
			{
				"basis": "authored",
				"id": "select.name",
				"text": "The trigger is named by the label plus the shown value. Without a label its name is only the value or placeholder text."
			},
			{
				"basis": "authored",
				"id": "select.focus",
				"text": "Opening moves focus into the list, where arrow keys, Home and End move the highlight and Enter or Space chooses. Escape and choosing return focus to the trigger."
			},
			{
				"basis": "authored",
				"id": "select.error",
				"text": "The rendered error message is linked to the trigger as its description, after the supporting text."
			}
		]
