	"examples": [
		{
			"basis": "observed",
			"from": "components-select--disabled",
			"html": "<div style=\"min-block-size: 16rem; padding-block-end: 9rem; box-sizing: border-box;\"><form><violet-select disabled error-text=\"Please choose a propagation path.\" label=\"Propagation path\" name=\"propagation-path\" placeholder=\"Select a path\" supporting-text=\"Choose the default path for this crop plan.\" value=\"direct\"><violet-option aria-selected=\"false\" id=\"violet-option-1\" label role=\"option\" value=\"broadcast\">Broadcast sowing<span slot=\"description\">Quick coverage for open beds.</span></violet-option><violet-option aria-selected=\"true\" id=\"violet-option-2\" label role=\"option\" selected value=\"direct\">Direct seed<span slot=\"description\">Most common field workflow.</span></violet-option><violet-option aria-selected=\"false\" id=\"violet-option-3\" label role=\"option\" value=\"transplant\">Tray transplant<span slot=\"description\">Best for controlled starts.</span></violet-option><violet-option aria-disabled=\"true\" aria-selected=\"false\" disabled id=\"violet-option-4\" label role=\"option\" value=\"hydroponic\">Hydroponic<span slot=\"description\">Unavailable for this field.</span></violet-option></violet-select></form></div>"
		},
