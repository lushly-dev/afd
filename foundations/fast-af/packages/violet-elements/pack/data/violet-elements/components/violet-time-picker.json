			"associated": true,
			"basis": "observed"
		},
		"slots": []
	},
	"examples": [
		{
			"basis": "observed",
			"from": "components-time-picker--disabled",
			"html": "<form style=\"max-inline-size: 20rem;\">\n                <violet-time-picker disabled error-text label=\"Start time\" max=\"21:00\" min=\"06:00\" name=\"start-time\" size=\"natural\" step=\"60\" supporting-text=\"This schedule is inherited from the greenhouse template.\" value=\"09:30\"></violet-time-picker>\n            </form>"
		},
		{
			"basis": "observed",
			"from": "components-time-picker--invalid",
			"html": "<form style=\"max-inline-size: 20rem;\">\n                <violet-time-picker error-text=\"Please choose a time.\" invalid label=\"Start time\" max=\"21:00\" min=\"06:00\" name=\"start-time\" required size=\"natural\" step=\"60\" supporting-text=\"Choose when this automation should begin each day.\" value></violet-time-picker>\n            </form>"
		},
		{
			"basis": "observed",
			"from": "components-time-picker--overview",
			"html": "<form style=\"max-inline-size: 20rem;\">\n                <violet-time-picker error-text label=\"Start time\" max=\"21:00\" min=\"06:00\" name=\"start-time\" size=\"natural\" step=\"60\" supporting-text=\"Choose when this automation should begin each day.\" value=\"09:30\"></violet-time-picker>\n            </form>"
		}
	],
	"format": 2,
	"gaps": [
		{
			"kind": "role"
		},
		{
			"kind": "unobserved",
			"name": "size",
			"section": "attributes"
		}
	],
	"import": "@lushly-dev/violet-elements",
	"rules": [
		"event.input-once",
		"field.input-change",
		"field.label",
		"field.label-required",
		"field.supporting-text",
		"form.error-text",
		"form.invalid",
		"form.participation",
		"import.root",
		"taxonomy.disabled",
		"taxonomy.error-text",
		"taxonomy.error-text.not-for",
		"taxonomy.invalid",
		"taxonomy.label",
		"taxonomy.max",
		"taxonomy.min",
		"taxonomy.name",
		"taxonomy.required",
		"taxonomy.size",
		"taxonomy.step",
		"taxonomy.supporting-text",
		"taxonomy.value",
		"theme.install"
	],
	"status": "stable",
	"summary": "Time-of-day field wrapping the native time input, with a label, supporting text and range checks; the value is a 24-hour time string.",
	"tag": "violet-time-picker",
	"usage": [
		{
			"basis": "authored",
			"id": "time-picker.value",
			"text": "value is a 24-hour \"HH:MM\" or \"HH:MM:SS\" string whatever the display format, and the form receives it under name. Any other string fails validation, and its message shows while invalid is set."
		},
		{
			"basis": "authored",
			"id": "time-picker.step",
			"text": "step is in seconds, default 60, so only hours and minutes are edited. Use step=\"1\" to edit seconds, or e.g. 900 for 15-minute arrow-key steps."
		},
		{
			"basis": "authored",
			"id": "time-picker.range",
			"text": "min and max are times within one day; a value outside them fails validation, and its message shows while invalid is set. A range that crosses midnight is not supported."
		},
		{
			"basis": "authored",
			"id": "time-picker.events",
			"text": "input and change carry detail.value."
		}
	]
}
