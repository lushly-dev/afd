			{
				"basis": "declared",
				"default": "var(--_type-body-size-compact)",
				"name": "--violet-control-body-size"
			},
			{
				"basis": "declared",
				"default": "var(--_type-caption-size-compact)",
				"name": "--violet-control-caption-size"
			},
			{
				"basis": "declared",
				"default": "var(--_type-label-size-compact)",
				"name": "--violet-control-label-size"
			},
			{
				"basis": "declared",
				"default": "max(0.9rem, calc(var(--_target-size) * 0.33))",
				"name": "--violet-icon-size"
			},
			{
				"basis": "declared",
				"default": "var(--_target-size-compact)",
				"name": "--violet-target-size"
			}
		],
		"events": [
			{
				"basis": "declared",
