				"text": "The trigger button is named by the label attribute followed by its visible text, e.g. \"Accent #c84f3b Adjust color\"; without label the name is only that text."
			},
			{
				"basis": "authored",
				"id": "color-picker.focus",
				"text": "Opening moves focus into the hex field and selects its text. Preset swatches are toggle buttons named \"Use #rrggbb\", pressed when they match the current color."
			}
		]
