	"status": "stable",
	"summary": "Swatch button that opens a color editor popover with a hex field, HSL sliders and preset swatches; use to choose one color as a hex value.",
	"tag": "violet-color-picker",
	"usage": [
		{
			"basis": "authored",
			"id": "color-picker.value",
			"text": "value is a hex color; 3- or 6-digit input is accepted and every user edit writes lowercase #rrggbb. The form receives value under name. Empty shows \"Choose color\"."
		},
		{
			"basis": "authored",
			"id": "color-picker.events",
			"text": "input fires as the color changes and change on commit (slider release, hex Enter or blur, preset click), both with detail.value. change fires only when the color differs, ignoring case, from the last commit."
		},
		{
			"basis": "authored",
			"id": "color-picker.native-input",
			"text": "The hex field's and sliders' native input events also reach host listeners, without detail; skip events that have none. Typing previews only full 6-digit hex; an invalid entry reverts on blur."
		},
		{
			"basis": "authored",
			"id": "color-picker.open",
			"text": "There is no open attribute: toggleOpen() opens or closes the popover and close() closes it. Escape or an outside click also closes it, and no open-change event fires."
		},
		{
			"basis": "authored",
			"id": "color-picker.reset",
			"text": "Form reset clears value to empty instead of restoring the initial value. The built-in swatches are fixed; content in the presets slot renders below them but is not wired to pick a color."
		}
	]
}
