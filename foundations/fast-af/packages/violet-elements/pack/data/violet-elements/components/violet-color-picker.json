	"examples": [
		{
			"basis": "observed",
			"from": "components-color-picker--disabled",
			"html": "<div style=\"max-inline-size: 22rem; padding-block-end: 16rem;\"><form><violet-color-picker disabled error-text=\"Select a color before continuing.\" label=\"Accent color\" name=\"accent-color\" size=\"natural\" supporting-text=\"Choose a color for chart or status highlights.\" value=\"#146ba0\"></violet-color-picker></form></div>"
		}
	],
	"format": 2,
	"gaps": [
		{
			"kind": "unobserved",
			"name": "size",
			"section": "attributes"
		}
	],
	"import": "@lushly-dev/violet-elements",
	"rules": [
		"event.input-once",
		"field.input-change",
		"field.label",
		"field.label-required",
		"field.supporting-text",
		"form.error-text",
		"form.invalid",
		"import.root",
		"taxonomy.disabled",
		"taxonomy.error-text",
		"taxonomy.error-text.not-for",
		"taxonomy.invalid",
		"taxonomy.label",
		"taxonomy.name",
		"taxonomy.required",
		"taxonomy.size",
		"taxonomy.supporting-text",
		"taxonomy.value",
		"theme.install"
	],
	"status": "stable",
	"summary": "Swatch button that opens a color editor popover with a hex field, HSL sliders and preset swatches; use to choose one color as a hex value.",
	"tag": "violet-color-picker",
	"usage": [
		{
			"basis": "authored",
			"id": "color-picker.value",
			"text": "value is a hex color; 3- or 6-digit input is accepted and every user edit writes lowercase #rrggbb. The form receives value under name. Empty shows \"Choose color\"."
		},
		{
			"basis": "authored",
			"id": "color-picker.events",
			"text": "input fires as the color changes and change on commit (slider release, hex Enter or blur, preset click), both with detail.value. change fires only when the color differs, ignoring case, from the last commit."
		},
		{
			"basis": "authored",
			"id": "color-picker.input",
			"text": "input fires only when the colour changes, with detail.value. Typing previews only full 6-digit hex; an invalid entry reverts on blur."
		},
		{
			"basis": "authored",
			"id": "color-picker.open",
			"text": "There is no open attribute: toggleOpen() opens or closes the popover and close() closes it. Escape or an outside click also closes it, and no open-change event fires."
		},
		{
			"basis": "authored",
			"id": "color-picker.reset",
			"text": "Form reset restores the value the picker had when it was connected. The built-in swatches are fixed; content in the presets slot renders below them but is not wired to pick a color."
		},
		{
			"basis": "authored",
			"id": "color-picker.defaults",
			"text": "The empty-state slider seed (#146ba0) and eight built-in presets (#181b1a, #2c5e4b, #a3ebcd, #146ba0, #c42a1a, #f96e5b, #92400e, #6b7d6e) come from AFD's Refined palette as component defaults, not theme tokens."
		}
	]
}
