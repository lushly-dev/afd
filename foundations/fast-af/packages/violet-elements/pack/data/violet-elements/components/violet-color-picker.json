{
	"a11y": {
		"axe": {
			"basis": "observed",
			"exceptions": [],
			"violations": 0
		},
		"role": [
			{
				"basis": "authored",
				"name": "from the label attribute followed by \"color picker\"",
				"role": "dialog",
				"state": "open"
			}
		],
		"statements": [
			{
				"basis": "authored",
				"id": "color-picker.trigger-name",
				"text": "The trigger button is named by the label attribute followed by its visible text, e.g. \"Accent #146ba0 Adjust color\"; without label the name is only that text."
			},
			{
				"basis": "authored",
				"id": "color-picker.focus",
				"text": "Opening moves focus into the hex field and selects its text. Preset swatches are toggle buttons named \"Use #rrggbb\", pressed when they match the current color."
			}
		]
	},
	"api": {
		"attributes": [
