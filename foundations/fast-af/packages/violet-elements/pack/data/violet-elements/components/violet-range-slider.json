	"status": "stable",
	"summary": "Two-thumb range input for choosing a low and a high bound, such as a price range, with a built-in label and supporting text.",
	"tag": "violet-range-slider",
	"usage": [
		{
			"basis": "authored",
			"id": "range-slider.values",
			"text": "Set the bounds with value-start and value-end (strings, defaults 25 and 75). Both are clamped to min and max, snapped to step, and start is kept at or below end. The value property returns only valueStart."
		},
		{
			"basis": "authored",
			"id": "range-slider.form",
			"text": "The form receives two entries, <name>-start and <name>-end (range-start and range-end when name is unset), not one value under name."
		},
		{
			"basis": "authored",
			"id": "range-slider.events",
			"text": "input and change are CustomEvents with detail { valueStart, valueEnd }, not detail.value. The inner range's native input event also reaches host listeners, without detail; skip events that have none."
		},
		{
			"basis": "authored",
			"id": "range-slider.validation",
			"text": "The required attribute has no effect on validity. Only the invalid attribute makes it invalid, showing error-text or the built-in \"Please choose a valid range.\""
		},
		{
			"basis": "authored",
			"id": "range-slider.ticks",
			"text": "show-ticks draws marks only when (max - min) / step is from 2 to 50. With orientation=\"vertical\" the minimum is at the bottom."
		}
	]
}
