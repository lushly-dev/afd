		"statements": [
			{
				"basis": "authored",
				"id": "range-slider.thumb-names",
				"text": "Each thumb is a native slider named only by label-start or label-end (default \"Minimum\", \"Maximum\"); the label attribute is in neither name. Name the quantity, e.g. label-start=\"Minimum price\"."
			},
			{
				"basis": "authored",
				"id": "range-slider.bounds",
				"text": "The thumbs cannot cross: the start thumb's announced maximum is valueEnd and the end thumb's minimum is valueStart. Arrow keys move the focused thumb by step."
			}
		]
	},
