{
  "extends": "../../tsconfig.base.wc.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "./src",
    "outDir": "./dist",
    "inlineSources": true,
    "declarationMap": false,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    // theme-css imports its generated naming rule as `.ts`, so the source runs in Node with type
    // stripping and the emitted `.js` imports in plain Node (verify:exports checks both).
    "rewriteRelativeImportExtensions": true,
    "useDefineForClassFields": false
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.spec.ts",
    "src/**/*.stories.ts"
  ]
}
