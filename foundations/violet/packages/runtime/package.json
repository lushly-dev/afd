{
	"name": "@lushly-dev/violet-runtime",
	"version": "0.2.0",
	"license": "MIT",
	"author": "Falkicon",
	"repository": {
		"type": "git",
		"url": "https://github.com/lushly-dev/afd.git",
		"directory": "foundations/violet/packages/runtime"
	},
	"homepage": "https://github.com/lushly-dev/afd#readme",
	"bugs": {
		"url": "https://github.com/lushly-dev/afd/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"design-tokens",
		"theming",
		"css-variables",
		"runtime",
		"violet"
	],
	"engines": {
		"node": ">=24"
	},
	"description": "Violet Design Runtime - Web SDK for dynamic token loading and theme switching",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"lint": "biome check src/",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"clean": "rm -rf dist *.tsbuildinfo"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.0",
		"happy-dom": "^21.0.4",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	]
}
