{
	"name": "@lushly-dev/specimen",
	"version": "2.2.0",
	"description": "Native component observations and comparison bench",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"import": "./dist/types.js"
		},
		"./schema": {
			"types": "./dist/schema.d.ts",
			"import": "./dist/schema.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsc",
		"clean": "rimraf dist *.tsbuildinfo",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"test": "vitest run --config vitest.unit.config.ts",
		"build:host": "cd host && cargo build --release --locked",
		"test:browser": "pnpm run build:host && vitest run && vitest run --config vitest.reference.config.ts"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"sideEffects": false,
	"dependencies": {
		"parse5": "^8.0.0",
		"playwright": "^1.64.0",
		"vite": "^8.3.0",
		"zod": "^4.6.6"
	},
	"devDependencies": {
		"@types/node": "^25.9.5",
		"@vitest/browser-playwright": "^4.1.12",
		"@vitest/coverage-v8": "^4.1.12",
		"rimraf": "^6.1.3",
		"typescript": "^5.9.3",
		"vitest": "^4.1.12"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/lushly-dev/afd.git",
		"directory": "foundations/specimen"
	},
	"license": "MIT"
}
