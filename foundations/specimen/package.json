{
	"name": "@lushly-dev/specimen",
	"version": "2.2.0-preview.0",
	"description": "Native component observations and comparison bench",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"import": "./dist/types.js"
		},
		"./schema": {
			"types": "./dist/schema.d.ts",
			"import": "./dist/schema.js"
		},
		"./evidence": {
			"types": "./dist/evidence.d.ts",
			"import": "./dist/evidence.js"
		},
		"./preview": {
			"types": "./dist/preview.d.ts",
			"import": "./dist/preview.js"
		},
		"./test": {
			"types": "./dist/test.d.ts",
			"import": "./dist/test.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsc && node -e \"require('node:fs').cpSync('src/browser/page.css', 'dist/browser/page.css')\"",
		"clean": "rimraf dist *.tsbuildinfo",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"test": "vitest run --config vitest.unit.config.ts",
		"build:host": "cd host && cargo build --release --locked",
		"test:browser": "pnpm run build:host && vitest run && vitest run --config vitest.reference.config.ts",
		"stage:host": "node host/stage.mjs"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"sideEffects": false,
	"dependencies": {
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/user-event": "^14.6.3",
		"@types/chai": "^5.2.2",
		"@vitest/expect": "3.2.4",
		"@vitest/spy": "3.2.4",
		"axe-core": "4.13.0",
		"chai": "^5.2.0",
		"playwright": "^1.64.0",
		"vite": "^8.3.0",
		"zod": "^4.6.6"
	},
	"optionalDependencies": {
		"@lushly-dev/specimen-host-darwin-arm64": "workspace:*",
		"@lushly-dev/specimen-host-darwin-x64": "workspace:*",
		"@lushly-dev/specimen-host-linux-arm64-gnu": "workspace:*",
		"@lushly-dev/specimen-host-linux-x64-gnu": "workspace:*"
	},
	"devDependencies": {
		"@storybook/addon-a11y": "10.6.2",
		"@storybook/addon-vitest": "10.6.2",
		"@storybook/web-components-vite": "10.6.2",
		"@types/node": "^26.6.6",
		"@vitest/browser": "4.1.12",
		"@vitest/browser-playwright": "^4.1.12",
		"@vitest/coverage-v8": "^4.1.12",
		"lit": "3.3.3",
		"parse5": "^8.0.0",
		"rimraf": "^6.1.3",
		"storybook": "10.6.2",
		"typescript": "^5.9.3",
		"vitest": "^4.1.12"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/lushly-dev/afd.git",
		"directory": "foundations/specimen"
	},
	"license": "MIT"
}
