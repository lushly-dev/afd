{
	"avoidWhen": [
		{
			"id": "destructive-confirm.avoid-when.reversible",
			"text": "Avoid interrupting reversible actions; execute them and offer undo-offer instead."
		}
	],
	"customize": [
		{
			"id": "destructive-confirm.customize.labels",
			"text": "Use a specific verb on the confirm button naming what will be removed or retired."
		}
	],
	"facets": {
		"behavior": [
			"confirmation",
			"escape-dismiss",
			"focus-management"
		],
		"purpose": [
			"destructive-action",
			"safety"
		],
		"structure": [
			"dialog"
		]
	},
	"format": 2,
	"gates": {
		"escape-dismisses": {
			"scenario": [
				{
					"action": {
						"press": "Escape"
					},
					"id": "press-escape"
				},
				{
					"expect": {
						"absent": true,
						"event": "submit",
						"since": "press-escape"
					},
					"id": "no-submit"
				},
				{
					"expect": {
						"focus": true,
						"target": "opener"
					},
					"id": "returns-focus"
				}
			],
			"setup": "default"
		},
		"focuses-cancel": {
			"scenario": [
				{
					"expect": {
						"focus": true,
						"target": "cancel"
					},
					"id": "cancel-has-focus"
				},
				{
					"expect": {
						"focus": false,
						"target": "confirm"
					},
					"id": "confirm-not-focused"
				}
			],
			"setup": "default"
		},
		"modal-dialog": {
			"scenario": [
				{
					"expect": {
						"a11y": {
							"nameNonEmpty": true,
							"role": [
								"dialog",
								"alertdialog"
							]
						},
						"target": "dialog"
					},
					"id": "check-dialog"
				},
				{
					"expect": {
						"a11y": {
							"disabled": false,
							"nameContains": "Delete",
							"role": "button"
						},
						"target": "confirm"
					},
					"id": "check-confirm"
				}
			],
			"setup": "default"
		}
	},
	"implementations": [],
	"keep": [
		{
			"gate": "modal-dialog",
			"id": "destructive-confirm.keep.modal-dialog",
			"text": "Presents the confirmation prompt inside a named dialog or alertdialog."
		},
		{
			"gate": "focuses-cancel",
			"id": "destructive-confirm.keep.focuses-cancel",
			"text": "Places initial keyboard focus on Cancel rather than the destructive confirm button."
		},
		{
			"gate": "escape-dismisses",
			"id": "destructive-confirm.keep.escape-dismisses",
			"text": "Pressing Escape dismisses the dialog without submitting and returns focus to the opener."
		},
		{
			"id": "destructive-confirm.keep.cancel-no-side-effect",
			"text": "Cancelling via Escape or Cancel never invokes the destructive command."
		},
		{
			"id": "destructive-confirm.keep.show-confirm-prompt",
			"text": "State the command's confirmPrompt consequences in plain text before invoking the command."
		}
	],
	"pattern": "destructive-confirm",
	"scope": "composition",
	"setups": {
		"default": {
			"targets": {
				"cancel": {
					"name": "Cancel",
					"role": "button"
				},
				"confirm": {
					"nameContains": "Delete",
					"role": "button"
				},
				"dialog": {
					"role": [
						"dialog",
						"alertdialog"
					]
				},
				"opener": {
					"nameContains": "Remove",
					"role": "button"
				}
			},
			"text": "Mount a destructive confirmation dialog (such as Loam's loam-modal with danger: true) beside its opener button, with Cancel and a destructive Confirm button."
		}
	},
	"status": "stable",
	"summary": "Ask for explicit confirmation before running a destructive command, focusing Cancel first and cancelling cleanly on Escape.",
	"useWhen": [
		{
			"id": "destructive-confirm.use-when.irreversible",
			"text": "Use whenever a command declares destructive: true or a confirmPrompt for an action that cannot be undone."
		}
	]
}
