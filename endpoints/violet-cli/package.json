{
	"name": "@lushly-dev/violet-cli",
	"version": "0.2.0",
	"license": "MIT",
	"author": "Falkicon",
	"repository": {
		"type": "git",
		"url": "https://github.com/lushly-dev/afd.git",
		"directory": "endpoints/violet-cli"
	},
	"homepage": "https://github.com/lushly-dev/afd#readme",
	"bugs": {
		"url": "https://github.com/lushly-dev/afd/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"violet",
		"design-tokens",
		"dtcg",
		"cli",
		"css-variables",
		"agent-first"
	],
	"engines": {
		"node": ">=24"
	},
	"description": "Violet Design CLI - Command-line interface for token management",
	"type": "module",
	"bin": {
		"violet": "./dist/bin.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"lint": "biome check src/",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"clean": "rm -rf dist *.tsbuildinfo"
	},
	"dependencies": {
		"@lushly-dev/violet-afd": "workspace:*",
		"@lushly-dev/violet-core": "workspace:*",
		"@lushly-dev/violet-server": "workspace:*",
		"chalk": "^5.6.2",
		"commander": "^15.1.0",
		"nanoid": "^6.0.2",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.0",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	]
