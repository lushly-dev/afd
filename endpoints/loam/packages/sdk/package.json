{
	"name": "@lushly-dev/loam-sdk",
	"version": "0.1.0",
	"private": true,
	"description": "The whole contract a Loam app codes against: defineApp, the contexts, the client, the kit, the overlays and the surface element, and /view for sandboxed code",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=22.12.0"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./view": {
			"types": "./dist/view.d.ts",
			"import": "./dist/view.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"clean": "rimraf dist coverage",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@lushly-dev/afd-core": "workspace:*",
		"@lushly-dev/loam-manifest": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^4.1.12",
		"rimraf": "^6.1.3",
		"typescript": "^7.0.2",
		"vitest": "^4.1.12"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/lushly-dev/afd.git",
		"directory": "endpoints/loam/packages/sdk"
	}
}
