{
	"name": "@lushly-dev/loam-web",
	"version": "0.1.0",
	"private": true,
	"description": "Loam's browser host: the static shell built with Vite, its Chromium suite and its budget",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"build": "vite build",
		"clean": "rimraf dist coverage",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"test": "vitest run --config vitest.config.ts",
		"test:browser": "vitest run --config vitest.browser.config.ts"
	},
	"dependencies": {
		"@lushly-dev/loam-chrome": "workspace:*",
		"@lushly-dev/loam-kernel": "workspace:*",
		"@lushly-dev/loam-theme": "workspace:*"
	},
	"devDependencies": {
		"@lushly-dev/specimen": "workspace:*",
		"@lushly-dev/violet-runtime": "workspace:*",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^4.1.12",
		"axe-core": "4.13.0",
		"playwright": "^1.64.0",
		"rimraf": "^6.1.3",
		"typescript": "^5.9.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.12"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/lushly-dev/afd.git",
		"directory": "endpoints/loam/packages/web"
	}
}
