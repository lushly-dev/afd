{
	"name": "@lushly-dev/loam-web",
	"version": "0.1.0",
	"private": true,
	"description": "Loam's browser host: the static shell built with Vite, its Chromium suite and its budget",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"build": "vite build",
		"clean": "rimraf dist coverage",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"test": "vitest run --config vitest.config.ts",
		"test:browser": "pnpm -F @lushly-dev/specimen build:host && vitest run --config vitest.browser.config.ts && vitest run --config vitest.conformance.config.ts",
		"build:umbel": "cd ../../../umbel && export CARGO_TARGET_DIR=\"${LOAM_UMBEL_TARGET_DIR:-${CARGO_TARGET_DIR:-target}}\" && cargo build --locked -p umbel --bin umbel && cargo build --locked -p umbel-plugin-hello --features mounted --bin hello-mcp",
		"test:mounted": "pnpm -F @lushly-dev/loam-web build:umbel && vitest run --config vitest.mounted.config.ts",
		"budget": "node scripts/budget.mjs"
	},
	"dependencies": {
		"@lushly-dev/afd-auth": "workspace:*",
		"@lushly-dev/afd-client": "workspace:*",
		"@lushly-dev/afd-core": "workspace:*",
		"@lushly-dev/loam-chrome": "workspace:*",
		"@lushly-dev/loam-kernel": "workspace:*",
		"@lushly-dev/loam-manifest": "workspace:*",
		"@lushly-dev/loam-theme": "workspace:*",
		"@lushly-dev/local-db": "workspace:*",
		"zod": "^4.6.6"
	},
	"devDependencies": {
		"@lushly-dev/afd-server": "workspace:*",
		"@lushly-dev/loam-app-hello": "workspace:*",
		"@lushly-dev/loam-app-tally": "workspace:*",
		"@lushly-dev/loam-app-tasks": "workspace:*",
		"@lushly-dev/loam-cli": "workspace:*",
		"@lushly-dev/loam-sdk": "workspace:*",
		"@lushly-dev/loam-testing": "workspace:*",
		"@lushly-dev/specimen": "workspace:*",
		"@lushly-dev/violet-runtime": "workspace:*",
		"@modelcontextprotocol/ext-apps": "2.0.4",
		"@types/node": "^26.6.6",
		"@vitest/browser": "4.1.12",
		"@vitest/browser-playwright": "^4.1.12",
		"@vitest/coverage-v8": "^4.1.12",
		"axe-core": "4.13.0",
		"fake-indexeddb": "^6.2.7",
		"playwright": "^1.64.0",
		"rimraf": "^6.1.3",
		"typescript": "^5.9.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.12"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/lushly-dev/afd.git",
		"directory": "endpoints/loam/packages/web"
	}
}
