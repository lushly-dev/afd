{
	"name": "@lushly-dev/loam-web",
	"version": "0.1.0",
	"private": true,
	"description": "Loam's browser host: the static shell built with Vite, its Chromium suite and its budget",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"build": "vite build",
		"clean": "rimraf dist build-record coverage",
		"typecheck": "tsc -p tsconfig.typecheck.json && tsc -p tsconfig.browser.json",
		"typecheck:hosted": "tsc -p tsconfig.hosted.json",
		"test": "vitest run --config vitest.config.ts",
		"test:browser": "pnpm -F @lushly-dev/specimen build:host && vitest run --config vitest.browser.config.ts && vitest run --config vitest.conformance.config.ts",
		"test:firefox": "vitest run --config vitest.engines.config.ts --project firefox",
		"test:webkit": "vitest run --config vitest.engines.config.ts --project webkit",
		"test:walk": "vitest run --config vitest.walk.config.ts",
		"test:hosted": "vitest run --config vitest.hosted.config.ts",
		"build:umbel": "node scripts/build-umbel.mjs",
		"test:mounted": "pnpm -F @lushly-dev/loam-web build:umbel && vitest run --config vitest.mounted.config.ts",
		"budget": "node scripts/budget.mjs"
	},
	"dependencies": {
		"@lushly-dev/afd-auth": "workspace:*",
		"@lushly-dev/afd-client": "workspace:*",
		"@lushly-dev/afd-core": "workspace:*",
		"@lushly-dev/loam-chrome": "workspace:*",
		"@lushly-dev/loam-kernel": "workspace:*",
		"@lushly-dev/loam-manifest": "workspace:*",
		"@lushly-dev/loam-theme": "workspace:*",
		"@lushly-dev/local-db": "workspace:*",
		"@modelcontextprotocol/client": "2.4.0",
		"zod": "^4.6.6",
		"@lushly-dev/loam-copilot": "workspace:*"
	},
	"devDependencies": {
		"@better-auth/passkey": "1.7.26",
		"@lushly-dev/afd-server": "workspace:*",
		"@lushly-dev/afd-testing": "workspace:*",
		"@lushly-dev/loam-app-checklist": "workspace:*",
		"@lushly-dev/loam-app-hello": "workspace:*",
		"@lushly-dev/loam-app-notes": "workspace:*",
		"@lushly-dev/loam-app-tally": "workspace:*",
		"@lushly-dev/loam-app-tasks": "workspace:*",
		"@lushly-dev/loam-cli": "workspace:*",
		"@lushly-dev/loam-host": "workspace:*",
		"@lushly-dev/loam-identity": "workspace:*",
		"@lushly-dev/loam-sdk": "workspace:*",
		"@lushly-dev/loam-testing": "workspace:*",
		"@lushly-dev/specimen": "workspace:*",
		"@lushly-dev/violet-runtime": "workspace:*",
		"@modelcontextprotocol/ext-apps": "2.0.4",
		"@modelcontextprotocol/server": "2.4.0",
		"@types/node": "^26.6.6",
		"@vitest/browser": "5.1.1",
		"@vitest/browser-playwright": "^5.1.1",
		"@vitest/coverage-v8": "^5.1.1",
		"axe-core": "4.14.0",
		"better-auth": "1.7.26",
		"fake-indexeddb": "^6.2.8",
		"playwright": "^1.64.1",
		"rimraf": "^6.1.4",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.1.1"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/lushly-dev/afd.git",
		"directory": "endpoints/loam/packages/web"
	}
}
