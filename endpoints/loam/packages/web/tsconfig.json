{
	// The hosted criterion (`test/hosted/`, `vitest.hosted.config.ts`) is the frozen hosted lane's (D162, `architecture.json`
	// `lanes`): `tsconfig.hosted.json` checks it in `loam.yml`'s hosted job, so this check never needs `loam-host` built.
	"extends": "../../../../tsconfig.json",
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"useDefineForClassFields": false,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"declaration": false,
		"declarationMap": false,
		"sourceMap": false,
		"types": ["node", "vite/client"]
	},
	"include": [
		"src/**/*",
		"test/**/*",
		"vite.config.ts",
		"vitest.config.ts",
		"vitest.browser.config.ts",
		"vitest.engines.config.ts",
		"vitest.mounted.config.ts",
		"vitest.conformance.config.ts"
	],
	"exclude": ["node_modules", "dist", "test/hosted"]
}
