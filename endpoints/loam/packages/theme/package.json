{
	"name": "@lushly-dev/loam-theme",
	"version": "0.1.0",
	"private": true,
	"description": "Loam's Violet themes, their exports, the token contract and the token-only lint",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"bin": {
		"loam-lint-tokens": "./scripts/lint-tokens.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./loam-theme.css": "./dist/loam-theme.css",
		"./loam-theme.json": "./dist/loam-theme.json",
		"./contract.json": "./dist/contract.json"
	},
	"scripts": {
		"build": "tsc && node dist/cli.js build",
		"clean": "rimraf dist coverage",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"test": "vitest run",
		"theme:build": "tsc && node dist/cli.js build",
		"theme:check": "tsc && node dist/cli.js check",
		"lint:tokens": "node scripts/lint-tokens.mjs \"src/**/*.ts\" \"src/**/*.css\""
	},
	"dependencies": {
		"@lushly-dev/violet-core": "workspace:*"
	},
	"devDependencies": {
		"@lushly-dev/loam-kernel": "workspace:*",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^4.1.12",
		"rimraf": "^6.1.3",
		"typescript": "^5.9.3",
		"vitest": "^4.1.12"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/lushly-dev/afd.git",
		"directory": "endpoints/loam/packages/theme"
	}
}
