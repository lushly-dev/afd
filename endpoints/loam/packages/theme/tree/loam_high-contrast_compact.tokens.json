{
  "$extensions": {
    "dev.lushly.violet": {
      "node": "loam/high-contrast/compact",
      "parent": "loam/high-contrast",
      "type": "custom"
    }
  },
  "shell": {
    "size": {
      "rail": {
        "$value": "{ref.target.40}"
      },
      "tabbar": {
        "$value": "{ref.target.48}"
      },
      "titlebar": {
        "$value": "{ref.target.32}"
      }
    }
  },
  "size": {
    "target": {
      "comfortable": {
        "$value": "{ref.target.32}"
      },
      "natural": {
        "$value": "{ref.target.28}"
      }
    }
  },
  "space": {
    "inline": {
      "group": {
        "$value": "{ref.space.6}"
      },
      "tight": {
        "$value": "{ref.space.2}"
      }
    },
    "stack": {
      "group": {
        "$value": "{ref.space.4}"
      },
      "section": {
        "$value": "{ref.space.8}"
      },
      "tight": {
        "$value": "{ref.space.2}"
      }
    }
  }
}
