{
	"name": "@lushly-dev/loam-chrome",
	"version": "0.1.0",
	"private": true,
	"description": "Loam's chrome: the shell parts as FAST-AF elements, the palette, keyboard and responsive rules",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"clean": "rimraf dist coverage",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"test": "vitest run",
		"lint:tokens": "loam-lint-tokens \"src/**/*.ts\" \"specimens/**/*.ts\"",
		"session:record": "node scripts/record-session.mjs"
	},
	"loamLintTokens": {
		"stateProperties": [
			"--_sidebar-width",
			"--_inspector-width",
			"--_panel-height"
		]
	},
	"dependencies": {
		"@lushly-dev/fast-element": "workspace:*",
		"@lushly-dev/loam-kernel": "workspace:*",
		"@lushly-dev/loam-theme": "workspace:*",
		"@lushly-dev/violet-elements": "workspace:*"
	},
	"devDependencies": {
		"@lushly-dev/afd-core": "workspace:*",
		"@lushly-dev/specimen": "workspace:*",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^4.1.12",
		"rimraf": "^6.1.3",
		"typescript": "^5.9.3",
		"vitest": "^4.1.12"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/lushly-dev/afd.git",
		"directory": "endpoints/loam/packages/chrome"
	}
}
