{
	"name": "@lushly-dev/loam-console",
	"version": "0.1.0",
	"private": true,
	"description": "Loam's console, every new app's first UI: the command list, forms from input schemas and results through the adapters",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./form": {
			"types": "./dist/form.d.ts",
			"import": "./dist/form.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"clean": "rimraf dist coverage",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"test": "vitest run",
		"lint:tokens": "loam-lint-tokens \"src/**/*.ts\""
	},
	"dependencies": {
		"@lushly-dev/afd-adapters": "workspace:*",
		"@lushly-dev/afd-core": "workspace:*",
		"@lushly-dev/fast-element": "workspace:*",
		"@lushly-dev/loam-sdk": "workspace:*",
		"@lushly-dev/violet-elements": "workspace:*"
	},
	"devDependencies": {
		"@lushly-dev/loam-theme": "workspace:*",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^4.1.12",
		"rimraf": "^6.1.3",
		"typescript": "^5.9.3",
		"vitest": "^4.1.12"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/lushly-dev/afd.git",
		"directory": "endpoints/loam/packages/console"
	}
}
