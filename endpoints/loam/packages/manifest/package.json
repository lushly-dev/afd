{
	"name": "@lushly-dev/loam-manifest",
	"version": "0.1.0",
	"private": true,
	"description": "Loam's manifest profile, deployment file and browser projection: schemas, generated types, standalone validators, the readers and refusals, and the catalogs",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=22.12.0"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./validate": {
			"types": "./dist/validate.d.ts",
			"import": "./dist/validate.js"
		},
		"./schemas/app-manifest.v1.json": "./schemas/app-manifest.v1.json",
		"./schemas/app-manifest.v2.json": "./schemas/app-manifest.v2.json",
		"./schemas/deployment.v1.json": "./schemas/deployment.v1.json",
		"./schemas/deployment.v2.json": "./schemas/deployment.v2.json",
		"./schemas/projection.v1.json": "./schemas/projection.v1.json",
		"./schemas/projection.v2.json": "./schemas/projection.v2.json"
	},
	"scripts": {
		"build": "node scripts/schema-build.mjs && tsc",
		"schema:build": "node scripts/schema-build.mjs",
		"clean": "rimraf dist coverage",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"test": "vitest run"
	},
	"dependencies": {
		"ajv": "^8.20.0",
		"zod": "^4.6.6"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^4.1.12",
		"json-schema-to-typescript": "^16.0.0",
		"rimraf": "^6.1.4",
		"typescript": "^7.0.2",
		"vitest": "^4.1.12"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/lushly-dev/afd.git",
		"directory": "endpoints/loam/packages/manifest"
	}
}
