{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://afd.dev/loam/schemas/app-manifest.v2.json",
	"title": "Loam app manifest, version 2 (conforms to plugin manifest core version 1)",
	"description": "Loam's closed profile of the plugin manifest core (spec/plugin-manifest.md, P1 to P6), version 2: version 1 and the keys of the phase 2 specifications (D76). One validator reads both versions, and the rule `manifest-version-keys` refuses a version 2 key under `manifest_version = 1`. Every object it admits is closed at its depth, conditionals sit in allOf, and a key it refuses is false. readManifest applies the rules beyond the schema.",
	"type": "object",
	"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/manifest",
	"properties": {
		"manifest_version": {
			"enum": [1, 2]
		},
		"protocol": {
			"const": 1
		},
		"afd_contract": true,
		"plugin": {
			"$ref": "#/$defs/plugin"
		},
		"native": {
			"$ref": "#/$defs/native"
		},
		"view": {
			"$ref": "#/$defs/view"
		},
		"mount": {
			"$ref": "#/$defs/mount"
		},
		"app": {
			"$ref": "#/$defs/app"
		},
		"grants": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/grant"
			}
		},
		"commands": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/command"
			}
		},
		"contexts": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/context"
			}
		},
		"pipelines": false,
		"skills": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/skill"
			}
		},
		"config": {
			"$ref": "#/$defs/config"
		},
		"ui": {
			"$ref": "#/$defs/ui"
		}
	},
	"unevaluatedProperties": false,
	"allOf": [
		{
			"if": {
				"type": "object",
				"properties": {
					"plugin": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "native"
							}
						},
						"required": ["kind"]
					}
				},
				"required": ["plugin"]
			},
			"then": {
				"type": "object",
				"properties": {
					"native": true
				},
				"required": ["native"]
			},
			"else": {
				"type": "object",
				"properties": {
					"native": false
				}
			}
		},
		{
			"if": {
				"type": "object",
				"properties": {
					"plugin": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "view"
							}
						},
						"required": ["kind"]
					}
				},
				"required": ["plugin"]
			},
			"then": {
				"type": "object"
			},
			"else": {
				"type": "object",
				"properties": {
					"view": false,
					"ui": {
						"type": "object",
						"properties": {
							"resources": false
						}
					}
				}
			}
		}
	],
	"$defs": {
		"plugin": {
			"type": "object",
			"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/plugin",
			"properties": {
				"id": {
					"type": "string",
					"not": {
						"enum": [
							"shell",
							"app",
							"project",
							"scope",
							"document",
							"presence",
							"thread",
							"copilot",
							"run",
							"automation",
							"autonomy",
							"approval",
							"agent",
							"pack",
							"view-state",
							"layout",
							"toast",
							"dialog",
							"modal",
							"popover",
							"prompt",
							"overlay",
							"appearance",
							"palette",
							"status",
							"setting",
							"experiment",
							"notification",
							"event",
							"account",
							"persona",
							"session",
							"auth",
							"afd"
						]
					}
				},
				"kind": {
					"type": "string",
					"enum": ["native", "view", "mounted"]
				},
				"domains": true
			},
			"required": ["domains"],
			"unevaluatedProperties": false
		},
		"native": {
			"type": "object",
			"properties": {
				"entry": {
					"type": "string",
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/relativePath",
					"pattern": "\\.m?js$"
				}
			},
			"required": ["entry"],
			"unevaluatedProperties": false
		},
		"view": {
			"type": "object",
			"properties": {
				"handlers": {
					"type": "string",
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/relativePath",
					"pattern": "\\.html?$"
				}
			},
			"unevaluatedProperties": false
		},
		"app": {
			"type": "object",
			"properties": {
				"scope_levels": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"enum": ["workspace", "project"]
					}
				},
				"resource_keys": {
					"type": "object",
					"propertyNames": {
						"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/commandName"
					},
					"additionalProperties": {
						"type": "string",
						"minLength": 1
					}
				}
			},
			"unevaluatedProperties": false
		},
		"command": {
			"type": "object",
			"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/command",
			"properties": {
				"effects": {
					"type": "array",
					"items": {
						"not": {
							"const": "workspace-write"
						}
					}
				},
				"approval": {
					"enum": ["none"]
				},
				"expose": {
					"$ref": "#/$defs/expose"
				},
				"examples": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/example"
					}
				},
				"confirm_prompt": false,
				"output_budget": false,
				"first_class": false
			},
			"unevaluatedProperties": false
		},
		"expose": {
			"type": "object",
			"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/expose",
			"unevaluatedProperties": false
		},
		"example": {
			"type": "object",
			"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/example",
			"unevaluatedProperties": false
		},
		"grant": {
			"type": "object",
			"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/grant",
			"unevaluatedProperties": false
		},
		"context": {
			"type": "object",
			"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/context",
			"unevaluatedProperties": false
		},
		"skill": {
			"type": "object",
			"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/skill",
			"unevaluatedProperties": false
		},
		"config": {
			"type": "object",
			"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/config",
			"unevaluatedProperties": false
		},
		"mount": {
			"type": "object",
			"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/mount",
			"properties": {
				"tools": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/mountTool"
					}
				}
			},
			"unevaluatedProperties": false
		},
		"mountTool": {
			"type": "object",
			"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/mountTool",
			"properties": {
				"effects": {
					"type": "array",
					"items": {
						"not": {
							"const": "workspace-write"
						}
					}
				},
				"confirm_prompt": false,
				"approval": false,
				"first_class": false
			},
			"unevaluatedProperties": false
		},
		"ui": {
			"type": "object",
			"properties": {
				"surfaces": {
					"$ref": "#/$defs/surfaces"
				},
				"layout": {
					"$ref": "#/$defs/layout"
				},
				"compositions": {
					"type": "array",
					"uniqueItems": true,
					"items": {
						"enum": ["console", "list-detail"]
					}
				},
				"resources": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/resource"
					}
				},
				"project_summary": {
					"$ref": "#/$defs/projectSummary"
				},
				"documents": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/documentType"
					}
				},
				"new": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/newItem"
					}
				}
			},
			"unevaluatedProperties": false
		},
		"projectSummary": {
			"type": "object",
			"properties": {
				"command": {
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/commandName"
				}
			},
			"required": ["command"],
			"unevaluatedProperties": false
		},
		"newItem": {
			"type": "object",
			"properties": {
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 80
				},
				"icon": {
					"enum": [
						"system/attach",
						"system/calendar",
						"system/checkmark",
						"system/clock",
						"system/document",
						"system/folder",
						"system/search",
						"system/warning"
					]
				},
				"command": {
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/commandName"
				},
				"scope_levels": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"enum": ["workspace", "project"]
					}
				}
			},
			"required": ["title", "icon", "command"],
			"unevaluatedProperties": false
		},
		"documentType": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string",
					"minLength": 1
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 80
				},
				"icon": {
					"enum": [
						"system/attach",
						"system/calendar",
						"system/checkmark",
						"system/clock",
						"system/document",
						"system/folder",
						"system/search",
						"system/warning"
					]
				},
				"content_schema": {
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/schemaOrPath"
				},
				"content_version": {
					"type": "integer",
					"minimum": 1
				},
				"autosave_ms": {
					"type": "integer",
					"minimum": 200,
					"maximum": 60000
				},
				"instance_commands": {
					"type": "array",
					"items": {
						"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/commandName"
					}
				},
				"export_command": {
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/commandName"
				},
				"import_command": {
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/commandName"
				},
				"scope_levels": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"enum": ["workspace", "project"]
					}
				},
				"editor": {
					"$ref": "#/$defs/documentSurface"
				},
				"embed": {
					"$ref": "#/$defs/documentSurface"
				},
				"inspector": {
					"$ref": "#/$defs/documentInspector"
				},
				"panel": false,
				"binding": {
					"$ref": "#/$defs/documentBinding"
				},
				"templates": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/documentTemplate"
					}
				}
			},
			"required": [
				"id",
				"title",
				"icon",
				"content_schema",
				"content_version",
				"editor",
				"binding",
				"templates"
			],
			"unevaluatedProperties": false
		},
		"documentSurface": {
			"type": "object",
			"properties": {
				"element": {
					"type": "string",
					"minLength": 1
				},
				"resource": {
					"type": "string",
					"minLength": 1
				}
			},
			"unevaluatedProperties": false
		},
		"documentInspector": {
			"type": "object",
			"properties": {
				"element": {
					"type": "string",
					"minLength": 1
				}
			},
			"required": ["element"],
			"unevaluatedProperties": false
		},
		"documentBinding": {
			"type": "object",
			"properties": {
				"model": {
					"enum": ["command", "crdt"]
				},
				"selection": {
					"enum": ["none", "text-range", "item"]
				},
				"locator": {
					"enum": ["none", "text-range", "item"]
				},
				"conflict": {
					"enum": ["last-writer-wins"]
				}
			},
			"required": ["model", "selection", "locator", "conflict"],
			"unevaluatedProperties": false
		},
		"documentTemplate": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string",
					"minLength": 1
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 80
				},
				"content": {}
			},
			"required": ["id", "title", "content"],
			"unevaluatedProperties": false
		},
		"surfaces": {
			"type": "object",
			"properties": {
				"rail": {
					"$ref": "#/$defs/rail"
				},
				"sidebar": {
					"$ref": "#/$defs/sidebar"
				},
				"header": {
					"$ref": "#/$defs/header"
				},
				"main": {
					"$ref": "#/$defs/main"
				},
				"inspector": {
					"$ref": "#/$defs/inspector"
				},
				"panel": {
					"$ref": "#/$defs/panel"
				},
				"status": {
					"$ref": "#/$defs/status"
				},
				"keybindings": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/keybinding"
					}
				}
			},
			"unevaluatedProperties": false
		},
		"rail": {
			"type": "object",
			"properties": {
				"label": {
					"type": "string",
					"minLength": 1,
					"maxLength": 80
				},
				"icon": {
					"enum": [
						"system/attach",
						"system/calendar",
						"system/checkmark",
						"system/clock",
						"system/document",
						"system/folder",
						"system/search",
						"system/warning"
					]
				},
				"order": {
					"type": "integer"
				}
			},
			"unevaluatedProperties": false
		},
		"sidebar": {
			"type": "object",
			"properties": {
				"shape": {
					"enum": ["list", "custom", "tree"]
				},
				"command": {
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/commandName"
				},
				"element": {
					"type": "string",
					"minLength": 1
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 80
				}
			},
			"required": ["shape"],
			"allOf": [
				{
					"if": {
						"type": "object",
						"properties": {
							"shape": {
								"enum": ["list", "tree"]
							}
						},
						"required": ["shape"]
					},
					"then": {
						"type": "object",
						"properties": {
							"command": true
						},
						"required": ["command"]
					}
				},
				{
					"if": {
						"type": "object",
						"properties": {
							"shape": {
								"const": "custom"
							}
						},
						"required": ["shape"]
					},
					"then": {
						"type": "object",
						"properties": {
							"element": true
						},
						"required": ["element"]
					}
				}
			],
			"unevaluatedProperties": false
		},
		"header": {
			"type": "object",
			"properties": {
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 80
				},
				"actions": {
					"type": "array",
					"maxItems": 3,
					"items": {
						"$ref": "#/$defs/headerAction"
					}
				}
			},
			"unevaluatedProperties": false
		},
		"headerAction": {
			"type": "object",
			"properties": {
				"command": {
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/commandName"
				},
				"label": {
					"type": "string",
					"minLength": 1,
					"maxLength": 80
				}
			},
			"required": ["command", "label"],
			"unevaluatedProperties": false
		},
		"main": {
			"type": "object",
			"properties": {
				"element": {
					"type": "string",
					"minLength": 1
				},
				"resource": {
					"type": "string",
					"minLength": 1
				},
				"command": {
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/commandName"
				}
			},
			"unevaluatedProperties": false
		},
		"inspector": {
			"type": "object",
			"properties": {
				"element": {
					"type": "string",
					"minLength": 1
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 80
				}
			},
			"required": ["element"],
			"unevaluatedProperties": false
		},
		"panel": {
			"type": "object",
			"properties": {
				"views": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/panelView"
					}
				}
			},
			"required": ["views"],
			"unevaluatedProperties": false
		},
		"panelView": {
			"type": "object",
			"properties": {
				"id": {
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/contextName"
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 80
				},
				"element": {
					"type": "string",
					"minLength": 1
				}
			},
			"required": ["id", "title", "element"],
			"unevaluatedProperties": false
		},
		"status": {
			"type": "object",
			"properties": {
				"items": {
					"type": "array",
					"maxItems": 4,
					"items": {
						"$ref": "#/$defs/statusItem"
					}
				}
			},
			"required": ["items"],
			"unevaluatedProperties": false
		},
		"statusItem": {
			"type": "object",
			"properties": {
				"id": {
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/contextName"
				},
				"label": {
					"type": "string",
					"minLength": 1,
					"maxLength": 80
				},
				"command": {
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/commandName"
				},
				"priority": {
					"type": "integer"
				}
			},
			"required": ["id", "label"],
			"unevaluatedProperties": false
		},
		"keybinding": {
			"type": "object",
			"properties": {
				"chord": {
					"type": "string",
					"pattern": "^(?:Mod\\+(?:Shift\\+)?(?:Alt\\+)?[A-Z0-9]|(?:Mod\\+)?(?:Shift\\+)?(?:Alt\\+)?F(?:[1-9]|1[0-9]|2[0-4]))$"
				},
				"command": {
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/commandName"
				}
			},
			"required": ["chord", "command"],
			"unevaluatedProperties": false
		},
		"layout": {
			"type": "object",
			"properties": {
				"sidebar": {
					"$ref": "#/$defs/layoutSide"
				},
				"inspector": {
					"$ref": "#/$defs/layoutSide"
				},
				"panel": {
					"$ref": "#/$defs/layoutPanel"
				}
			},
			"unevaluatedProperties": false
		},
		"layoutSide": {
			"type": "object",
			"properties": {
				"open": {
					"type": "boolean"
				},
				"width": {
					"type": "integer"
				}
			},
			"unevaluatedProperties": false
		},
		"layoutPanel": {
			"type": "object",
			"properties": {
				"open": {
					"type": "boolean"
				},
				"height": {
					"type": "integer"
				}
			},
			"unevaluatedProperties": false
		},
		"resource": {
			"type": "object",
			"properties": {
				"uri": {
					"type": "string",
					"minLength": 1
				},
				"path": {
					"type": "string",
