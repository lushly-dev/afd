{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://afd.dev/loam/schemas/app-manifest.v3.json",
	"title": "Loam app manifest, version 3 (conforms to plugin manifest core version 2)",
	"description": "Loam's closed profile of the plugin manifest core (spec/plugin-manifest.md, P1 to P6), version 3: version 2 on core version 2, whose commands[].expose admits apps (phase 5 specification, 9.1). One validator reads versions 1, 2 and 3: the rule `manifest-version-keys` refuses a version 2 key under `manifest_version = 1`, and a version 3 key (`commands[].expose.apps`) under `manifest_version` 1 or 2. Every object it admits is closed at its depth, conditionals sit in allOf, and a key it refuses is false. readManifest applies the rules beyond the schema.",
	"type": "object",
	"$ref": "https://afd.dev/spec/plugin-manifest.core.v2.json#/$defs/manifest",
	"properties": {
		"manifest_version": {
			"enum": [1, 2, 3]
		},
		"protocol": {
			"const": 1
		},
		"afd_contract": true,
		"plugin": {
			"$ref": "#/$defs/plugin"
		},
		"native": {
			"$ref": "#/$defs/native"
		},
		"view": {
			"$ref": "#/$defs/view"
		},
		"mount": {
			"$ref": "#/$defs/mount"
		},
		"app": {
			"$ref": "#/$defs/app"
		},
		"grants": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/grant"
			}
		},
		"calls": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/call"
			}
		},
		"commands": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/command"
			}
		},
		"contexts": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/context"
			}
		},
		"pipelines": false,
		"skills": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/skill"
			}
		},
		"config": {
			"$ref": "#/$defs/config"
		},
		"ui": {
			"$ref": "#/$defs/ui"
		}
	},
	"unevaluatedProperties": false,
	"allOf": [
		{
			"if": {
				"type": "object",
				"properties": {
					"plugin": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "native"
							}
						},
						"required": ["kind"]
					}
				},
				"required": ["plugin"]
			},
			"then": {
				"type": "object",
				"properties": {
					"native": true
				},
				"required": ["native"]
			},
			"else": {
				"type": "object",
				"properties": {
					"native": false
				}
			}
		},
		{
			"if": {
				"type": "object",
				"properties": {
					"plugin": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "view"
							}
						},
						"required": ["kind"]
					}
				},
				"required": ["plugin"]
			},
			"then": {
				"type": "object"
			},
			"else": {
				"type": "object",
				"properties": {
					"view": false,
					"ui": {
						"type": "object",
						"properties": {
							"resources": false
						}
					}
				}
			}
		}
	],
	"$defs": {
		"plugin": {
			"type": "object",
			"$ref": "https://afd.dev/spec/plugin-manifest.core.v2.json#/$defs/plugin",
			"properties": {
				"id": {
					"type": "string",
					"not": {
						"enum": [
							"shell",
							"app",
							"project",
							"scope",
							"document",
							"presence",
							"thread",
							"copilot",
							"run",
							"automation",
							"autonomy",
							"approval",
							"agent",
							"pack",
							"view-state",
							"layout",
							"toast",
							"dialog",
							"modal",
							"popover",
							"prompt",
							"overlay",
							"appearance",
							"palette",
							"status",
							"setting",
							"experiment",
							"notification",
							"limit",
							"keybinding",
							"event",
							"account",
							"persona",
							"session",
							"auth",
							"workspace",
							"section",
							"editor",
							"new",
							"member",
							"confirmation",
							"afd",
							"p",
							"loam"
						]
					}
				},
				"kind": {
					"type": "string",
					"enum": ["native", "view", "mounted"]
				},
				"domains": true
			},
			"required": ["domains"],
			"unevaluatedProperties": false
		},
		"native": {
			"type": "object",
			"properties": {
				"entry": {
					"type": "string",
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v2.json#/$defs/relativePath",
					"pattern": "\\.m?js$"
				}
			},
			"required": ["entry"],
			"unevaluatedProperties": false
		},
		"view": {
			"type": "object",
			"properties": {
				"handlers": {
					"type": "string",
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v2.json#/$defs/relativePath",
					"pattern": "\\.html?$"
				}
			},
			"unevaluatedProperties": false
		},
		"app": {
			"type": "object",
			"properties": {
				"scope_levels": {
					"$ref": "#/$defs/scopeLevels"
				},
				"resource_keys": {
					"type": "object",
					"propertyNames": {
						"$ref": "https://afd.dev/spec/plugin-manifest.core.v2.json#/$defs/commandName"
					},
					"additionalProperties": {
						"type": "string",
						"minLength": 1
					}
				},
				"requires_experiment": {
					"$ref": "#/$defs/experimentRef"
				}
			},
			"unevaluatedProperties": false
		},
		"command": {
			"type": "object",
			"$ref": "https://afd.dev/spec/plugin-manifest.core.v2.json#/$defs/command",
			"properties": {
				"effects": {
					"type": "array",
					"items": {
						"not": {
							"const": "workspace-write"
						}
					}
				},
				"approval": {
					"enum": ["none"]
				},
				"expose": {
					"$ref": "#/$defs/expose"
				},
				"examples": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/example"
					}
				},
				"confirm_prompt": {
					"description": "Phase 4's 7.2: plain text the shell shows beneath its own header when it asks the person to confirm the command, 1 to 200 characters. A key of version 2.",
					"type": "string",
					"minLength": 1,
					"maxLength": 200
				},
				"output_budget": false,
				"first_class": false
			},
			"unevaluatedProperties": false
		},
		"expose": {
			"type": "object",
			"$ref": "https://afd.dev/spec/plugin-manifest.core.v2.json#/$defs/expose",
			"unevaluatedProperties": false
		},
		"example": {
			"type": "object",
			"$ref": "https://afd.dev/spec/plugin-manifest.core.v2.json#/$defs/example",
			"unevaluatedProperties": false
		},
		"grant": {
			"type": "object",
			"$ref": "https://afd.dev/spec/plugin-manifest.core.v2.json#/$defs/grant",
			"unevaluatedProperties": false
		},
		"context": {
			"type": "object",
			"$ref": "https://afd.dev/spec/plugin-manifest.core.v2.json#/$defs/context",
			"unevaluatedProperties": false
		},
		"skill": {
			"type": "object",
			"$ref": "https://afd.dev/spec/plugin-manifest.core.v2.json#/$defs/skill",
			"unevaluatedProperties": false
		},
		"config": {
			"type": "object",
			"$ref": "https://afd.dev/spec/plugin-manifest.core.v2.json#/$defs/config",
			"unevaluatedProperties": false
		},
		"mount": {
			"type": "object",
			"$ref": "https://afd.dev/spec/plugin-manifest.core.v2.json#/$defs/mount",
			"properties": {
				"tools": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/mountTool"
					}
				}
			},
			"unevaluatedProperties": false
		},
		"mountTool": {
			"type": "object",
			"$ref": "https://afd.dev/spec/plugin-manifest.core.v2.json#/$defs/mountTool",
			"properties": {
				"effects": {
					"type": "array",
					"items": {
						"not": {
							"const": "workspace-write"
						}
					}
				},
				"confirm_prompt": false,
				"approval": false,
				"first_class": false
			},
			"unevaluatedProperties": false
		},
		"ui": {
			"type": "object",
			"properties": {
				"surfaces": {
					"$ref": "#/$defs/surfaces"
				},
				"layout": {
					"$ref": "#/$defs/layout"
				},
				"compositions": {
					"type": "array",
					"uniqueItems": true,
					"items": {
						"enum": ["console", "list-detail"]
					}
				},
				"resources": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/resource"
					}
				},
				"project_summary": {
					"$ref": "#/$defs/projectSummary"
				},
				"documents": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/documentType"
					}
				},
				"new": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/newItem"
					}
				},
				"settings": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/settingSection"
					}
				},
				"account": {
					"type": "array",
					"maxItems": 2,
					"items": {
						"$ref": "#/$defs/accountSection"
					}
				},
				"experiments": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/experiment"
					}
				}
			},
			"unevaluatedProperties": false
		},
		"accountSection": {
			"description": "An app's section of the account section (phase 3 specification, 5.5): a tab at workspace level showing one of the app's declared surfaces.",
			"type": "object",
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 40
				},
				"surface": {
					"type": "string",
					"pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
				}
			},
			"required": ["id", "title", "surface"],
			"unevaluatedProperties": false
		},
		"settingSection": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 40
				},
				"description": {
					"type": "string",
					"minLength": 1,
					"maxLength": 200
				},
				"levels": {
					"$ref": "#/$defs/settingLevels"
				},
				"schema": {
					"$ref": "#/$defs/settingSchema"
				},
				"requires_experiment": {
					"$ref": "#/$defs/experimentRef"
				}
			},
			"required": ["id", "title", "levels", "schema"],
			"unevaluatedProperties": false
		},
		"settingLevels": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": {
				"enum": ["person", "workspace", "project"]
			}
		},
		"settingSchema": {
			"type": "object",
			"properties": {
				"type": {
					"const": "object"
				},
				"properties": {
					"type": "object",
					"minProperties": 1,
					"maxProperties": 32,
					"propertyNames": {
						"pattern": "^[a-z][a-zA-Z0-9]{0,39}$"
					},
					"additionalProperties": {
						"$ref": "#/$defs/settingKey"
					}
				},
				"additionalProperties": {
					"const": false
				}
			},
			"required": ["type", "properties", "additionalProperties"],
			"unevaluatedProperties": false
		},
		"settingKey": {
			"type": "object",
			"properties": {
				"type": {
					"enum": ["boolean", "string", "integer", "number", "array"]
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 60
				},
				"description": {
					"type": "string",
					"minLength": 1,
					"maxLength": 200
				},
				"levels": {
					"$ref": "#/$defs/settingLevels"
				},
				"default": true,
				"enum": {
					"$ref": "#/$defs/settingChoices"
				},
				"enumTitles": {
					"type": "array",
					"minItems": 1,
					"maxItems": 32,
					"items": {
						"type": "string",
						"minLength": 1,
						"maxLength": 60
					}
				},
				"maxLength": {
					"type": "integer",
					"minimum": 1,
					"maximum": 1000
				},
				"minimum": {
					"type": "number"
				},
				"maximum": {
					"type": "number"
				},
				"items": {
					"$ref": "#/$defs/settingItems"
				},
				"maxItems": {
					"type": "integer",
					"minimum": 1,
					"maximum": 32
				},
				"uniqueItems": {
					"const": true
				}
			},
			"required": ["type", "title"],
			"unevaluatedProperties": false
		},
		"settingChoices": {
			"type": "array",
			"minItems": 1,
			"maxItems": 32,
			"uniqueItems": true,
			"items": {
				"type": "string",
				"minLength": 1,
				"maxLength": 60
			}
		},
		"settingItems": {
			"type": "object",
			"properties": {
				"type": {
					"const": "string"
				},
				"enum": {
					"$ref": "#/$defs/settingChoices"
				}
			},
			"required": ["type", "enum"],
			"unevaluatedProperties": false
		},
		"experiment": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 60
				},
				"changes": {
					"type": "string",
					"minLength": 1,
					"maxLength": 400
				},
				"ends": {
					"type": "string",
					"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
				},
				"stage": {
					"enum": ["hidden", "visible", "graduated", "removed"]
				}
			},
			"required": ["id", "title", "changes", "ends", "stage"],
			"unevaluatedProperties": false
		},
		"experimentRef": {
			"type": "string",
			"pattern": "^[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9-]{0,39}$",
			"maxLength": 105
		},
		"projectSummary": {
			"type": "object",
			"properties": {
				"command": {
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v2.json#/$defs/commandName"
				}
			},
			"required": ["command"],
			"unevaluatedProperties": false
		},
		"newItem": {
			"type": "object",
			"properties": {
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 80
				},
				"icon": {
					"$ref": "#/$defs/icon"
				},
				"command": {
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v2.json#/$defs/commandName"
				},
				"scope_levels": {
					"$ref": "#/$defs/scopeLevels"
				}
			},
			"required": ["title", "icon", "command"],
			"unevaluatedProperties": false
		},
		"documentType": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string",
					"minLength": 1
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 80
				},
				"icon": {
					"$ref": "#/$defs/icon"
				},
				"content_schema": {
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v2.json#/$defs/schemaOrPath"
				},
				"content_version": {
					"type": "integer",
					"minimum": 1
				},
				"autosave_ms": {
					"type": "integer",
					"minimum": 200,
					"maximum": 60000
				},
				"instance_commands": {
					"type": "array",
					"items": {
						"$ref": "https://afd.dev/spec/plugin-manifest.core.v2.json#/$defs/commandName"
					}
				},
				"export_command": {
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v2.json#/$defs/commandName"
				},
				"import_command": {
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v2.json#/$defs/commandName"
				},
				"scope_levels": {
					"$ref": "#/$defs/scopeLevels"
				},
				"editor": {
					"$ref": "#/$defs/documentSurface"
				},
				"embed": {
					"$ref": "#/$defs/documentSurface"
				},
				"inspector": {
					"$ref": "#/$defs/documentInspector"
				},
				"panel": false,
				"binding": {
					"$ref": "#/$defs/documentBinding"
				},
				"templates": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/documentTemplate"
					}
				}
			},
			"required": [
				"id",
				"title",
				"icon",
				"content_schema",
				"content_version",
				"instance_commands",
				"editor",
				"binding",
				"templates"
			],
			"unevaluatedProperties": false
		},
		"documentSurface": {
			"type": "object",
			"properties": {
				"element": {
					"type": "string",
					"minLength": 1
				},
				"resource": {
					"type": "string",
					"minLength": 1
				}
			},
			"unevaluatedProperties": false
		},
		"documentInspector": {
			"type": "object",
			"properties": {
				"element": {
					"type": "string",
					"minLength": 1
				}
			},
			"required": ["element"],
			"unevaluatedProperties": false
		},
		"documentBinding": {
			"type": "object",
			"properties": {
				"model": {
					"enum": ["command", "crdt"]
				},
				"selection": {
					"enum": ["none", "text-range", "item"]
				},
				"locator": {
					"enum": ["none", "text-range", "item"]
				},
				"conflict": {
					"enum": ["last-writer-wins"]
				}
			},
			"required": ["model", "selection", "locator", "conflict"],
			"unevaluatedProperties": false
		},
		"documentTemplate": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string",
					"minLength": 1
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 80
				},
				"content": {}
			},
			"required": ["id", "title", "content"],
			"unevaluatedProperties": false
		},
		"surfaces": {
			"type": "object",
			"properties": {
				"rail": {
					"$ref": "#/$defs/rail"
				},
				"sidebar": {
					"$ref": "#/$defs/sidebar"
				},
				"header": {
					"$ref": "#/$defs/header"
				},
				"main": {
					"$ref": "#/$defs/main"
				},
				"inspector": {
					"$ref": "#/$defs/inspector"
				},
				"panel": {
					"$ref": "#/$defs/panel"
				},
				"status": {
					"$ref": "#/$defs/status"
				},
				"keybindings": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/keybinding"
					}
				}
			},
			"unevaluatedProperties": false
		},
		"rail": {
			"type": "object",
			"properties": {
				"label": {
					"type": "string",
					"minLength": 1,
					"maxLength": 80
				},
				"icon": {
					"$ref": "#/$defs/icon"
				},
				"order": {
					"type": "integer"
				}
			},
			"unevaluatedProperties": false
		},
		"sidebar": {
			"type": "object",
			"properties": {
				"shape": {
					"enum": ["list", "custom", "tree"]
				},
				"command": {
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v2.json#/$defs/commandName"
				},
				"element": {
					"type": "string",
					"minLength": 1
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 80
				},
				"requires_experiment": {
					"$ref": "#/$defs/experimentRef"
				}
			},
			"required": ["shape"],
			"allOf": [
				{
					"if": {
						"type": "object",
						"properties": {
							"shape": {
								"enum": ["list", "tree"]
							}
						},
