{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://afd.dev/loam/schemas/deployment.v4.json",
	"title": "Loam deployment file, version 4",
	"description": "The deployer's loam.deployment.toml, read as JSON: version 3 with the host that serves it (phase 6 specification, 3.3), closed at every depth. Version 4 is needed only for [host] and [copilot] (phase 5 specification, 4.1); a version 1 to 3 file reads as static. Only @lushly-dev/loam-cli and @lushly-dev/loam-host read it; the browser gets the projection, which names the host's kind and nothing else of it.",
	"type": "object",
	"properties": {
		"deployment_version": {
			"const": 4
		},
		"workspace": {
			"$ref": "#/$defs/workspace"
		},
		"site": {
			"$ref": "#/$defs/site"
		},
		"sandbox": {
			"$ref": "#/$defs/sandbox"
		},
		"identity": {
			"$ref": "#/$defs/identity"
		},
		"host": {
			"$ref": "#/$defs/host"
		},
		"copilot": {
			"$ref": "#/$defs/copilot"
		},
		"apps": {
			"type": "object",
			"propertyNames": {
				"type": "string",
				"pattern": "^[a-z][a-z0-9]{0,31}$"
			},
			"additionalProperties": {
				"$ref": "#/$defs/instance"
			}
		}
	},
	"required": ["deployment_version", "apps"],
	"additionalProperties": false,
	"$defs": {
		"workspace": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
					"not": {
						"enum": [
							"apps",
							"assets",
							"mounts",
							"sandbox",
							"p",
							"~",
							"deployment.json",
							"index.html",
							"404.html",
							"api",
							"mcp",
							".well-known"
						]
					}
				},
				"name": {
					"type": "string",
					"minLength": 1,
					"maxLength": 80
				}
			},
			"additionalProperties": false
		},
		"site": {
			"type": "object",
			"properties": {
				"base_path": {
					"type": "string",
					"pattern": "^/([A-Za-z0-9._~-]+/)*$",
					"not": {
						"type": "string",
						"pattern": "(^|/)\\.{1,2}/"
					}
				}
			},
			"additionalProperties": false
		},
		"sandbox": {
			"type": "object",
			"properties": {
				"origin": {
					"type": "string",
					"pattern": "^(https?://[^/?#\\s]+|loam-sandbox://localhost)$"
				}
			},
			"required": ["origin"],
			"additionalProperties": false
		},
		"identity": {
			"type": "object",
			"description": "The deployment's identity (phase 3 specification, 2.2). Each value is checked again by readDeployment, which refuses one out of shape as DEPLOYMENT_IDENTITY_INVALID.",
			"properties": {
				"mode": {
					"enum": ["local", "provider"]
				},
				"provider": {
					"const": "better-auth"
				},
				"organization": {
					"type": "string"
				},
				"path": {
					"type": "string"
				},
				"methods": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			},
			"additionalProperties": false
		},
		"host": {
			"type": "object",
			"description": "Which host serves the deployment (phase 6 specification, 3.3): static (the default, as versions 1 to 3 read), the hosted server, or the desktop; and, for the desktop, whether its inbound endpoint serves (10.8).",
			"properties": {
				"kind": {
					"enum": ["static", "hosted", "desktop"]
				},
				"inbound": {
					"type": "boolean",
					"description": "The desktop's inbound MCP endpoint (phase 6 specification, 10.8; D137): on unless false. `deployment write --host desktop` writes it to `mounts.json`, which the desktop's Rust host alone reads; no other host serves one."
				}
			},
			"additionalProperties": false
		},
		"copilot": {
			"type": "object",
			"description": "The copilot's model providers (phase 5 specification, 4.1). The projection carries each provider's id, kind and model, never its key or endpoint; on the desktop, models.json carries the rest to the Rust host. readDeployment checks the rules between the keys.",
			"properties": {
				"default": {
					"$ref": "#/$defs/providerId"
				},
				"providers": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/copilotProvider"
					}
				}
			},
			"additionalProperties": false
		},
		"providerId": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]{0,31}$"
		},
		"copilotProvider": {
			"type": "object",
			"properties": {
				"id": {
					"$ref": "#/$defs/providerId"
				},
				"kind": {
					"enum": ["anthropic", "openai", "openai-compatible", "test"]
				},
				"model": {
					"type": "string",
					"pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$"
				},
				"endpoint": {
					"type": "string",
					"minLength": 1,
					"maxLength": 2048
				},
				"key": {
					"$ref": "#/$defs/copilotKey"
				}
			},
			"required": ["id", "kind", "model"],
			"additionalProperties": false
		},
		"copilotKey": {
			"description": "Where the Rust host reads the provider's key: an OS keychain entry, which loam copilot key set writes, or a file only its owner can read. Never the key itself.",
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"keychain": {
							"$ref": "#/$defs/keychainName"
						},
						"account": {
							"$ref": "#/$defs/keychainName"
						}
					},
					"required": ["keychain", "account"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"file": {
							"type": "string",
							"minLength": 1
						}
					},
					"required": ["file"],
					"additionalProperties": false
				}
			]
		},
		"keychainName": {
			"type": "string",
			"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
		},
		"instance": {
			"type": "object",
			"properties": {
				"app": {
					"type": "string",
					"pattern": "^[a-z][a-z0-9]{0,31}$"
				},
				"package": {
					"type": "string",
					"minLength": 1
				},
				"order": {
					"type": "integer"
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 80
				},
				"config": {
					"type": "object"
				},
				"prefix": {
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/domain"
				},
				"audience": {
					"enum": ["team", "person"]
				},
				"transport": {
					"enum": ["http", "stdio"]
				},
				"url": {
					"type": "string",
					"minLength": 1
				},
				"bearer_file": {
					"type": "string",
					"minLength": 1
				},
				"bearer_env": {
					"type": "string",
					"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
				},
				"command": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"cwd": {
					"type": "string",
					"minLength": 1
				},
				"projects": {
					"type": "array",
					"items": {
						"type": "string",
						"pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
					},
					"uniqueItems": true
				},
				"space": {
					"type": "object",
					"additionalProperties": {
						"type": "string",
						"minLength": 1
					}
				},
				"labels": {
					"enum": ["whole", "per-part"]
				},
				"approvals": {
					"enum": ["none", "shell"]
				},
				"views": {
					"description": "Phase 5's 9.3 (D169): whether shell-open may render this mounted instance's ui:// views, in the sandbox. Default false.",
					"type": "boolean"
				},
				"expose": {
					"$ref": "#/$defs/expose"
				},
				"commands": {
					"type": "object",
					"propertyNames": {
						"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/commandName"
					},
					"additionalProperties": {
						"$ref": "#/$defs/commandOverride"
					}
				}
			},
			"required": ["app", "package"],
			"additionalProperties": false
		},
		"expose": {
			"type": "object",
			"properties": {
				"agent": {
					"type": "boolean"
				},
				"palette": {
					"type": "boolean"
				},
				"mcp": {
					"const": false
				},
				"cli": {
					"const": false
				},
				"apps": false
			},
			"additionalProperties": false
		},
		"commandExpose": {
			"type": "object",
			"properties": {
				"agent": {
					"type": "boolean"
				},
				"palette": {
					"type": "boolean"
				},
				"mcp": {
					"const": false
				},
				"cli": {
					"const": false
				},
				"apps": {
					"type": "boolean"
				}
			},
			"additionalProperties": false
		},
		"commandOverride": {
			"type": "object",
			"properties": {
				"expose": {
					"$ref": "#/$defs/commandExpose"
				},
				"effects": {
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/effects"
				},
				"destructive": {
					"type": "boolean"
				},
				"preview": {
					"$ref": "#/$defs/preview"
				}
			},
			"additionalProperties": false
		},
		"preview": {
			"type": "object",
			"properties": {
				"command": {
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/commandName"
				},
				"input": {
					"type": "array",
					"minItems": 1,
					"maxItems": 16,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
					}
				}
			},
			"required": ["command", "input"],
			"additionalProperties": false
		}
	}
}
