{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://afd.dev/loam/schemas/projection.v3.json",
	"title": "Loam browser projection, version 3",
	"description": "deployment.json, written from the deployment file: version 2, which it also reads, with the deployment's identity (phase 3 specification, 2.2). It has no key for a location, a credential, a command line, a secret or an organization id, and it is closed at every depth, so a projection holding one fails readProjection. A version 2 projection, or one with no identity, is local. A boot record is for display only.",
	"type": "object",
	"properties": {
		"deployment_version": {
			"enum": [2, 3]
		},
		"generation": {
			"type": "string",
			"pattern": "^(sha256-[0-9a-f]{64}|empty|test)$"
		},
		"workspace": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
					"not": {
						"enum": [
							"apps",
							"assets",
							"mounts",
							"sandbox",
							"p",
							"~",
							"deployment.json",
							"index.html",
							"404.html"
						]
					}
				},
				"name": {
					"type": "string",
					"minLength": 1,
					"maxLength": 80
				}
			},
			"required": ["id", "name"],
			"additionalProperties": false
		},
		"sandbox_origin": {
			"type": ["string", "null"],
			"pattern": "^https?://[^/?#\\s]+$"
		},
		"identity": {
			"$ref": "#/$defs/identity"
		},
		"apps": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/app"
			}
		}
	},
	"required": ["deployment_version", "generation", "workspace", "sandbox_origin", "apps"],
	"additionalProperties": false,
	"if": {
		"properties": {
			"deployment_version": {
				"const": 2
			}
		}
	},
	"then": {
		"properties": {
			"identity": false
		}
	},
	"$defs": {
		"app": {
			"type": "object",
			"properties": {
				"instance": {
					"type": "string",
					"pattern": "^[a-z][a-z0-9]{0,31}$"
				},
				"app": {
					"type": "string",
					"pattern": "^[a-z][a-z0-9]{0,31}$"
				},
				"package": {
					"type": "string",
					"pattern": "^apps/[a-z][a-z0-9]{0,31}/$"
				},
				"order": {
					"type": "integer"
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 80
				},
				"config": {
					"type": "object"
				},
				"prefix": {
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/domain"
				},
				"audience": {
					"enum": ["team", "person"]
				},
				"transport": {
					"enum": ["http", "stdio"]
				},
				"route": {
					"type": "string",
					"pattern": "^mounts/[a-z][a-z0-9]{0,31}/mcp$"
				},
				"projects": {
					"type": "array",
					"items": {
						"type": "string",
						"pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
					},
					"uniqueItems": true
				},
				"space": {
					"type": "object",
					"additionalProperties": {
						"type": "string",
						"minLength": 1
					}
				},
				"expose": {
					"$ref": "#/$defs/expose"
				},
				"commands": {
					"type": "object",
					"propertyNames": {
						"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/commandName"
					},
					"additionalProperties": {
						"$ref": "#/$defs/commandOverride"
					}
				},
				"boot": {
					"$ref": "#/$defs/boot"
				}
			},
			"required": ["instance", "app", "package"],
			"additionalProperties": false
		},
		"expose": {
			"type": "object",
			"properties": {
				"agent": {
					"type": "boolean"
				},
				"palette": {
					"type": "boolean"
				},
				"mcp": {
					"const": false
				},
				"cli": {
					"const": false
				},
				"apps": false
			},
			"additionalProperties": false
		},
		"commandOverride": {
			"type": "object",
			"properties": {
				"expose": {
					"$ref": "#/$defs/expose"
				},
				"effects": {
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/effects"
				},
				"destructive": {
					"type": "boolean"
				}
			},
			"additionalProperties": false
		},
		"boot": {
			"type": "object",
			"properties": {
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 80
				},
				"kind": {
					"enum": ["native", "view", "mounted"]
				},
				"icon": {
					"type": "string",
					"minLength": 1,
					"maxLength": 64
				},
				"order": {
					"type": "integer"
				},
				"scope_levels": {
					"type": "array",
					"minItems": 1,
					"items": {
						"enum": ["workspace", "project"]
					}
				},
				"rail": {
					"type": "boolean"
				},
				"parts": {
					"type": "array",
					"items": {
						"enum": ["sidebar", "inspector", "panel"]
					}
				},
				"layout": {
					"$ref": "https://afd.dev/loam/schemas/app-manifest.v2.json#/$defs/layout"
				},
				"refusal": {
					"type": ["object", "null"],
					"properties": {
						"code": {
							"type": "string",
							"pattern": "^[A-Z][A-Z0-9_]*$",
							"maxLength": 64
						},
						"message": {
							"type": "string",
							"maxLength": 2000
						},
						"suggestion": {
							"type": "string",
							"maxLength": 2000
						}
					},
					"required": ["code", "message", "suggestion"],
					"additionalProperties": false
				}
			},
			"required": [
				"title",
				"kind",
				"icon",
				"order",
				"scope_levels",
				"rail",
				"parts",
				"layout",
				"refusal"
			],
			"additionalProperties": false
		},
		"identity": {
			"type": "object",
			"properties": {
				"mode": {
					"enum": ["local", "provider"]
				},
				"organization": {
					"type": "string",
					"pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
				},
				"path": {
					"type": "string",
					"pattern": "^(?!\\.\\.?(/|$))(?!.*/\\.\\.?(/|$))[A-Za-z0-9._~-]+(/[A-Za-z0-9._~-]+)*$"
				},
				"methods": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"pattern": "^(passkey|password|oidc:[a-z0-9][a-z0-9-]{0,31})$"
					}
				}
			},
			"required": ["mode"],
			"additionalProperties": false,
			"if": {
				"properties": {
					"mode": {
						"const": "provider"
					}
				}
			},
			"then": {
				"properties": {
					"organization": true,
					"path": true,
					"methods": true
				},
				"required": ["organization", "path", "methods"]
			},
			"else": {
				"maxProperties": 1
			}
		}
	}
}
