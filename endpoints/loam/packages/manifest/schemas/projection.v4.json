{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://afd.dev/loam/schemas/projection.v4.json",
	"title": "Loam browser projection, version 4",
	"description": "deployment.json, written from the deployment file: version 3, which it also reads, with the host that serves it (phase 6 specification, 3.3): its kind, and for the hosted server the same-origin path of its trust-record transport under base_path. It has no key for a location, a credential, a command line, a secret or an organization id, and it is closed at every depth. From version 4 also the copilot's providers (phase 5 specification, 4.1): each one's id, kind and model, never a key or an endpoint. A projection before version 4 is static.",
	"type": "object",
	"properties": {
		"deployment_version": {
			"enum": [2, 3, 4]
		},
		"generation": {
			"type": "string",
			"pattern": "^(sha256-[0-9a-f]{64}|empty|test)$"
		},
		"workspace": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
					"not": {
						"enum": [
							"apps",
							"assets",
							"mounts",
							"sandbox",
							"p",
							"~",
							"deployment.json",
							"index.html",
							"404.html"
						]
					}
				},
				"name": {
					"type": "string",
					"minLength": 1,
					"maxLength": 80
				}
			},
			"required": ["id", "name"],
			"additionalProperties": false
		},
		"sandbox_origin": {
			"type": ["string", "null"],
			"pattern": "^(https?://[^/?#\\s]+|loam-sandbox://localhost)$"
		},
		"identity": {
			"$ref": "#/$defs/identity"
		},
		"host": {
			"$ref": "#/$defs/host"
		},
		"copilot": {
			"$ref": "#/$defs/copilot"
		},
		"apps": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/app"
			}
		}
	},
	"required": ["deployment_version", "generation", "workspace", "sandbox_origin", "apps"],
	"additionalProperties": false,
	"if": {
		"properties": {
			"deployment_version": {
				"const": 2
			}
		}
	},
	"then": {
		"properties": {
			"identity": false,
			"host": false,
			"copilot": false
		}
	},
	"$defs": {
		"app": {
			"type": "object",
			"properties": {
				"instance": {
					"type": "string",
					"pattern": "^[a-z][a-z0-9]{0,31}$"
				},
				"app": {
					"type": "string",
					"pattern": "^[a-z][a-z0-9]{0,31}$"
				},
				"package": {
					"type": "string",
					"pattern": "^apps/[a-z][a-z0-9]{0,31}/$"
				},
				"order": {
					"type": "integer"
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 80
				},
				"config": {
					"type": "object"
				},
				"prefix": {
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/domain"
				},
				"audience": {
					"enum": ["team", "person"]
				},
				"transport": {
					"enum": ["http", "stdio"]
				},
				"route": {
					"type": "string",
					"pattern": "^mounts/[a-z][a-z0-9]{0,31}/mcp$"
				},
				"projects": {
					"type": "array",
					"items": {
						"type": "string",
						"pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
					},
					"uniqueItems": true
				},
				"space": {
					"type": "object",
					"additionalProperties": {
						"type": "string",
						"minLength": 1
					}
				},
				"labels": {
					"enum": ["whole", "per-part"]
				},
				"approvals": {
					"enum": ["none", "shell"]
				},
				"views": {
					"description": "Phase 5's 9.3 (D169): whether shell-open may render this mounted instance's ui:// views, in the sandbox. Default false.",
					"type": "boolean"
				},
				"expose": {
					"$ref": "#/$defs/expose"
				},
				"commands": {
					"type": "object",
					"propertyNames": {
						"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/commandName"
					},
					"additionalProperties": {
						"$ref": "#/$defs/commandOverride"
					}
				},
				"boot": {
					"$ref": "#/$defs/boot"
				}
			},
			"required": ["instance", "app", "package"],
			"additionalProperties": false
		},
		"expose": {
			"type": "object",
			"properties": {
				"agent": {
					"type": "boolean"
				},
				"palette": {
					"type": "boolean"
				},
				"mcp": {
					"const": false
				},
				"cli": {
					"const": false
				},
				"apps": false
			},
			"additionalProperties": false
		},
		"commandExpose": {
			"type": "object",
			"properties": {
				"agent": {
					"type": "boolean"
				},
				"palette": {
					"type": "boolean"
				},
				"mcp": {
					"const": false
				},
				"cli": {
					"const": false
				},
				"apps": {
					"type": "boolean"
				}
			},
			"additionalProperties": false
		},
		"commandOverride": {
			"type": "object",
			"properties": {
				"expose": {
					"$ref": "#/$defs/commandExpose"
				},
				"effects": {
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/effects"
				},
				"destructive": {
					"type": "boolean"
				},
				"preview": {
					"$ref": "#/$defs/preview"
				}
			},
			"additionalProperties": false
		},
		"preview": {
			"type": "object",
			"properties": {
				"command": {
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/commandName"
				},
				"input": {
					"type": "array",
					"minItems": 1,
					"maxItems": 16,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
					}
				}
			},
			"required": ["command", "input"],
			"additionalProperties": false
		},
		"boot": {
			"type": "object",
			"properties": {
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 80
				},
				"kind": {
					"enum": ["native", "view", "mounted"]
				},
				"icon": {
					"type": "string",
					"minLength": 1,
					"maxLength": 64
				},
				"order": {
					"type": "integer"
				},
				"scope_levels": {
					"type": "array",
					"minItems": 1,
					"items": {
						"enum": ["workspace", "project"]
					}
				},
				"rail": {
					"type": "boolean"
				},
				"gated": {
					"type": "boolean"
				},
				"parts": {
					"type": "array",
					"items": {
						"enum": ["sidebar", "inspector", "panel"]
					}
				},
				"layout": {
					"$ref": "https://afd.dev/loam/schemas/app-manifest.v2.json#/$defs/layout"
				},
				"refusal": {
					"type": ["object", "null"],
					"properties": {
						"code": {
							"type": "string",
							"pattern": "^[A-Z][A-Z0-9_]*$",
							"maxLength": 64
						},
						"message": {
							"type": "string",
							"maxLength": 2000
						},
						"suggestion": {
							"type": "string",
							"maxLength": 2000
						}
					},
					"required": ["code", "message", "suggestion"],
					"additionalProperties": false
				}
			},
			"required": [
				"title",
				"kind",
				"icon",
				"order",
				"scope_levels",
				"rail",
				"parts",
				"layout",
				"refusal"
			],
			"additionalProperties": false
		},
		"identity": {
			"type": "object",
			"properties": {
				"mode": {
					"enum": ["local", "provider"]
				},
				"organization": {
					"type": "string",
					"pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
				},
				"path": {
					"type": "string",
					"pattern": "^(?!\\.\\.?(/|$))(?!.*/\\.\\.?(/|$))[A-Za-z0-9._~-]+(/[A-Za-z0-9._~-]+)*$"
				},
				"methods": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"pattern": "^(passkey|password|oidc:[a-z0-9][a-z0-9-]{0,31})$"
					}
				}
			},
			"required": ["mode"],
			"additionalProperties": false,
			"if": {
				"properties": {
					"mode": {
						"const": "provider"
					}
				}
			},
			"then": {
				"properties": {
					"organization": true,
					"path": true,
					"methods": true
				},
				"required": ["organization", "path", "methods"]
			},
			"else": {
				"maxProperties": 1
			}
		},
		"host": {
			"type": "object",
			"properties": {
				"kind": {
					"enum": ["static", "hosted", "desktop"]
				},
				"kernel": {
					"const": "api/kernel"
				}
			},
			"required": ["kind"],
			"additionalProperties": false,
			"if": {
				"properties": {
					"kind": {
						"const": "hosted"
					}
				}
			},
			"then": {
				"properties": {
					"kernel": true
				},
				"required": ["kernel"]
			},
			"else": {
				"properties": {
					"kernel": false
				}
			}
		},
		"copilot": {
			"type": "object",
			"properties": {
				"default": {
					"type": "string",
					"pattern": "^[a-z][a-z0-9-]{0,31}$"
				},
				"providers": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string",
								"pattern": "^[a-z][a-z0-9-]{0,31}$"
							},
							"kind": {
								"enum": ["anthropic", "openai", "openai-compatible", "test"]
							},
							"model": {
								"type": "string",
								"pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$"
							}
						},
						"required": ["id", "kind", "model"],
						"additionalProperties": false
					}
				}
			},
			"required": ["default", "providers"],
			"additionalProperties": false
		}
	},
	"else": {
		"if": {
			"properties": {
				"deployment_version": {
					"const": 3
				}
			}
		},
		"then": {
			"properties": {
				"host": false,
				"copilot": false
			}
		}
	}
}
