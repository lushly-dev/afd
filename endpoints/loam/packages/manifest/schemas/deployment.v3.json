{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://afd.dev/loam/schemas/deployment.v3.json",
	"title": "Loam deployment file, version 3",
	"description": "The deployer's loam.deployment.toml, read as JSON: version 2 with the deployment's identity (phase 3 specification, 2.2), closed at every depth. Version 3 is needed only for [identity]. Only @lushly-dev/loam-cli reads it; the browser gets the projection, whose identity holds no secret, key, database or organization id.",
	"type": "object",
	"properties": {
		"deployment_version": {
			"const": 3
		},
		"workspace": {
			"$ref": "#/$defs/workspace"
		},
		"site": {
			"$ref": "#/$defs/site"
		},
		"sandbox": {
			"$ref": "#/$defs/sandbox"
		},
		"identity": {
			"$ref": "#/$defs/identity"
		},
		"apps": {
			"type": "object",
			"propertyNames": {
				"type": "string",
				"pattern": "^[a-z][a-z0-9]{0,31}$"
			},
			"additionalProperties": {
				"$ref": "#/$defs/instance"
			}
		}
	},
	"required": ["deployment_version", "apps"],
	"additionalProperties": false,
	"$defs": {
		"workspace": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
					"not": {
						"enum": [
							"apps",
							"assets",
							"mounts",
							"sandbox",
							"p",
							"~",
							"deployment.json",
							"index.html",
							"404.html"
						]
					}
				},
				"name": {
					"type": "string",
					"minLength": 1,
					"maxLength": 80
				}
			},
			"additionalProperties": false
		},
		"site": {
			"type": "object",
			"properties": {
				"base_path": {
					"type": "string",
					"pattern": "^/([A-Za-z0-9._~-]+/)*$",
					"not": {
						"type": "string",
						"pattern": "(^|/)\\.{1,2}/"
					}
				}
			},
			"additionalProperties": false
		},
		"sandbox": {
			"type": "object",
			"properties": {
				"origin": {
					"type": "string",
					"pattern": "^https?://[^/?#\\s]+$"
				}
			},
			"required": ["origin"],
			"additionalProperties": false
		},
		"identity": {
			"type": "object",
			"description": "The deployment's identity (phase 3 specification, 2.2). Each value is checked again by readDeployment, which refuses one out of shape as DEPLOYMENT_IDENTITY_INVALID.",
			"properties": {
				"mode": {
					"enum": ["local", "provider"]
				},
				"provider": {
					"const": "better-auth"
				},
				"organization": {
					"type": "string"
				},
				"path": {
					"type": "string"
				},
				"methods": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			},
			"additionalProperties": false
		},
		"instance": {
			"type": "object",
			"properties": {
				"app": {
					"type": "string",
					"pattern": "^[a-z][a-z0-9]{0,31}$"
				},
				"package": {
					"type": "string",
					"minLength": 1
				},
				"order": {
					"type": "integer"
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 80
				},
				"config": {
					"type": "object"
				},
				"prefix": {
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/domain"
				},
				"audience": {
					"enum": ["team", "person"]
				},
				"transport": {
					"enum": ["http", "stdio"]
				},
				"url": {
					"type": "string",
					"minLength": 1
				},
				"bearer_file": {
					"type": "string",
					"minLength": 1
				},
				"bearer_env": {
					"type": "string",
					"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
				},
				"command": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"cwd": {
					"type": "string",
					"minLength": 1
				},
				"projects": {
					"type": "array",
					"items": {
						"type": "string",
						"pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
					},
					"uniqueItems": true
				},
				"space": {
					"type": "object",
					"additionalProperties": {
						"type": "string",
						"minLength": 1
					}
				},
				"expose": {
					"$ref": "#/$defs/expose"
				},
				"commands": {
					"type": "object",
					"propertyNames": {
						"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/commandName"
					},
					"additionalProperties": {
						"$ref": "#/$defs/commandOverride"
					}
				}
			},
			"required": ["app", "package"],
			"additionalProperties": false
		},
		"expose": {
			"type": "object",
			"properties": {
				"agent": {
					"type": "boolean"
				},
				"palette": {
					"type": "boolean"
				},
				"mcp": {
					"const": false
				},
				"cli": {
					"const": false
				},
				"apps": false
			},
			"additionalProperties": false
		},
		"commandOverride": {
			"type": "object",
			"properties": {
				"expose": {
					"$ref": "#/$defs/expose"
				},
				"effects": {
					"$ref": "https://afd.dev/spec/plugin-manifest.core.v1.json#/$defs/effects"
				},
				"destructive": {
					"type": "boolean"
				}
			},
			"additionalProperties": false
		}
	}
}
