{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://afd.dev/loam/schemas/json-schema-shape.json",
	"title": "The shape of a JSON Schema 2020-12 document",
	"description": "The 2020-12 metaschema's keyword types in one recursive document, so the page's rules input-schema and config-schema carry a small validator instead of the metaschema's. Its test holds it equal to Ajv's metaschema over a table of schemas.",
	"type": ["object", "boolean"],
	"properties": {
		"$id": { "type": "string", "pattern": "^[^#]*#?$" },
		"$schema": { "type": "string" },
		"$ref": { "type": "string" },
		"$anchor": { "$ref": "#/$defs/anchor" },
		"$dynamicRef": { "type": "string" },
		"$dynamicAnchor": { "$ref": "#/$defs/anchor" },
		"$recursiveAnchor": { "$ref": "#/$defs/anchor" },
		"$recursiveRef": { "type": "string" },
		"$comment": { "type": "string" },
		"$defs": { "$ref": "#/$defs/map" },
		"$vocabulary": { "type": "object", "additionalProperties": { "type": "boolean" } },
		"definitions": { "$ref": "#/$defs/map" },
		"dependencies": {
			"type": "object",
			"additionalProperties": { "anyOf": [{ "$ref": "#" }, { "$ref": "#/$defs/names" }] }
		},
		"title": { "type": "string" },
		"description": { "type": "string" },
		"deprecated": { "type": "boolean" },
		"readOnly": { "type": "boolean" },
		"writeOnly": { "type": "boolean" },
		"examples": { "type": "array" },
		"type": {
			"anyOf": [
				{ "$ref": "#/$defs/typeName" },
				{
					"type": "array",
					"items": { "$ref": "#/$defs/typeName" },
					"minItems": 1,
					"uniqueItems": true
				}
			]
		},
		"enum": { "type": "array" },
		"const": true,
		"default": true,
		"multipleOf": { "type": "number", "exclusiveMinimum": 0 },
		"maximum": { "type": "number" },
		"exclusiveMaximum": { "type": "number" },
		"minimum": { "type": "number" },
		"exclusiveMinimum": { "type": "number" },
		"maxLength": { "$ref": "#/$defs/count" },
		"minLength": { "$ref": "#/$defs/count" },
		"pattern": { "type": "string" },
		"maxItems": { "$ref": "#/$defs/count" },
		"minItems": { "$ref": "#/$defs/count" },
		"uniqueItems": { "type": "boolean" },
		"maxContains": { "$ref": "#/$defs/count" },
		"minContains": { "$ref": "#/$defs/count" },
		"maxProperties": { "$ref": "#/$defs/count" },
		"minProperties": { "$ref": "#/$defs/count" },
		"required": { "$ref": "#/$defs/names" },
		"dependentRequired": { "type": "object", "additionalProperties": { "$ref": "#/$defs/names" } },
		"additionalProperties": { "$ref": "#" },
		"properties": { "$ref": "#/$defs/map" },
		"patternProperties": { "$ref": "#/$defs/map" },
		"propertyNames": { "$ref": "#" },
		"dependentSchemas": { "$ref": "#/$defs/map" },
		"items": { "$ref": "#" },
		"prefixItems": { "$ref": "#/$defs/list" },
		"contains": { "$ref": "#" },
		"allOf": { "$ref": "#/$defs/list" },
		"anyOf": { "$ref": "#/$defs/list" },
		"oneOf": { "$ref": "#/$defs/list" },
		"not": { "$ref": "#" },
		"if": { "$ref": "#" },
		"then": { "$ref": "#" },
		"else": { "$ref": "#" },
		"unevaluatedItems": { "$ref": "#" },
		"unevaluatedProperties": { "$ref": "#" },
		"format": { "type": "string" },
		"contentEncoding": { "type": "string" },
		"contentMediaType": { "type": "string" },
		"contentSchema": { "$ref": "#" }
	},
	"$defs": {
		"anchor": { "type": "string", "pattern": "^[A-Za-z_][-A-Za-z0-9._]*$" },
		"map": { "type": "object", "additionalProperties": { "$ref": "#" } },
		"list": { "type": "array", "items": { "$ref": "#" }, "minItems": 1 },
		"names": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
		"count": { "type": "integer", "minimum": 0 },
		"typeName": { "enum": ["array", "boolean", "integer", "null", "number", "object", "string"] }
	}
}
