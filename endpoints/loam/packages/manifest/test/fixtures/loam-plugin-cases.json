			"license": "MIT",
			"homepage": "https://afd.dev/loam/plugins/mail"
		},
		"apps": [
			{
				"id": "mail",
				"path": "apps/mail"
			},
			{
				"id": "mailapp",
				"path": "apps/mailapp"
			}
		],
		"engine": {
			"id": "loam-mail",
			"kind": "http-service",
			"mount_app": "mail",
			"service_mode": "login",
			"artifacts": {
				"darwin-arm64": {
					"path": "engines/darwin-arm64/loam-mail",
					"sha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
				},
				"windows-x64": {
					"path": "engines/windows-x64/loam-mail.exe",
					"sha256": "fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210"
				},
				"linux-x64": {
					"path": "engines/linux-x64/loam-mail",
					"sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
				}
			},
			"auth": {
				"mode": "approver"
			},
			"mount": {
				"audience": "person",
				"labels": "per-part",
				"approvals": "shell",
				"expose": {
					"agent": true,
					"palette": true
				},
				"commands": {
					"mail-draft-send": {
						"expose": {
							"agent": true,
							"apps": true
						},
						"preview": {
							"command": "mail-draft-show",
							"input": ["draft", "revision"]
						}
					},
