{
	"name": "@lushly-dev/loam-testing",
	"version": "0.1.0",
	"private": true,
	"description": "The test kit an app's own tests use: createAppTestKernel boots a headless kernel with only the app, and replays what it ran",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"clean": "rimraf dist coverage",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@lushly-dev/afd-core": "workspace:*",
		"@lushly-dev/local-db": "workspace:*",
		"@lushly-dev/loam-kernel": "workspace:*",
		"@lushly-dev/loam-sdk": "workspace:*"
	},
	"devDependencies": {
		"@lushly-dev/loam-cli": "workspace:*",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^4.1.12",
		"rimraf": "^6.1.3",
		"typescript": "^5.9.3",
		"vitest": "^4.1.12"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/lushly-dev/afd.git",
		"directory": "endpoints/loam/packages/testing"
	}
}
