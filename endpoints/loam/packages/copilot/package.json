{
	"name": "@lushly-dev/loam-copilot",
	"version": "0.1.0",
	"private": true,
	"description": "Loam's copilot runtime: the runtime adapter over TanStack AI, the runtime frame's bootstrap and worker, the ports' runtime halves, the test provider and the context builder; never imports the kernel",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=22.12.0"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./test-provider": {
			"types": "./dist/test-provider.d.ts",
			"import": "./dist/test-provider.js"
		}
	},
	"scripts": {
		"build": "tsc && node scripts/build-frame.mjs",
		"clean": "rimraf dist coverage",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@tanstack/ai": "1.4.0",
		"@tanstack/ai-anthropic": "1.1.1",
		"@tanstack/ai-openai": "1.1.1"
	},
	"devDependencies": {
		"@types/node": "^26.6.10",
		"@vitest/coverage-v8": "^5.1.2",
		"rimraf": "^6.1.4",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.1.2"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/lushly-dev/afd.git",
		"directory": "endpoints/loam/packages/copilot"
	}
}
