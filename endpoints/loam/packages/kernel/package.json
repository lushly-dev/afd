{
	"name": "@lushly-dev/loam-kernel",
	"version": "0.1.0",
	"private": true,
	"description": "Loam's kernel: registries, shell commands, layout model, palette index, journal and replay; no DOM dependency",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=22.12.0"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"import": "./dist/testing.js"
		},
		"./palette": {
			"types": "./dist/palette-index.d.ts",
			"import": "./dist/palette-index.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"clean": "rimraf dist coverage",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@lushly-dev/afd-auth": "workspace:*",
		"@lushly-dev/afd-core": "workspace:*",
		"@lushly-dev/afd-server": "workspace:*",
		"@lushly-dev/afd-view-state": "workspace:*",
		"@lushly-dev/local-db": "workspace:*",
		"@lushly-dev/loam-manifest": "workspace:*",
		"@lushly-dev/loam-sdk": "workspace:*",
		"zod": "^4.6.6"
	},
	"devDependencies": {
		"@lushly-dev/afd-client": "workspace:*",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^4.1.12",
		"fake-indexeddb": "^6.2.7",
		"rimraf": "^6.1.3",
		"typescript": "^7.0.2",
		"vitest": "^4.1.12"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/lushly-dev/afd.git",
		"directory": "endpoints/loam/packages/kernel"
	}
}
