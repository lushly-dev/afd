{
	"name": "@lushly-dev/loam-kernel",
	"version": "0.1.0",
	"private": true,
	"description": "Loam's kernel: registries, shell commands, layout model, journal and replay; no DOM dependency",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
