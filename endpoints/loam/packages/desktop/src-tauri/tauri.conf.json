{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Loam",
	"version": "0.1.0",
	"identifier": "dev.lushly.loam",
	"build": {
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": false,
		"windows": [],
		"security": {
			"capabilities": ["main", "host-setup"],
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "Productivity",
		"shortDescription": "Loam agent-first desktop shell",
		"fileAssociations": [
			{
				"ext": ["loam-plugin"],
				"name": "Loam Plugin",
				"description": "Loam desktop plugin bundle",
				"mimeType": "application/vnd.loam.plugin+zip",
				"role": "Viewer"
			}
		],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"updater": {
			"pubkey": "",
			"endpoints": [],
			"requireSignedVersion": true
		}
	}
}
