{
	"name": "@lushly-dev/loam-app-hello",
	"version": "0.1.0",
	"private": true,
	"description": "Loam's reference app: one handler module, native and a sandboxed view, and mounted from a server",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"build": "vite build && vite build --mode view-main && vite build --mode view-handlers",
		"clean": "rimraf dist coverage",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"test": "vitest run",
		"lint:tokens": "loam-lint-tokens \"src/**/*.ts\"",
		"pack": "loam app pack . --manifest manifests/native.toml --out dist/package",
		"pack:view": "loam app pack . --manifest manifests/view.toml --out dist/package-view",
		"pack:mounted": "loam app pack . --manifest manifests/mounted.toml --out dist/package-mounted"
	},
	"dependencies": {
		"@lushly-dev/fast-element": "workspace:*",
		"@lushly-dev/loam-sdk": "workspace:*"
	},
	"devDependencies": {
		"@lushly-dev/loam-cli": "workspace:*",
		"@lushly-dev/loam-testing": "workspace:*",
		"@lushly-dev/loam-theme": "workspace:*",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.0",
		"rimraf": "^6.1.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.1.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/lushly-dev/afd.git",
		"directory": "endpoints/loam/apps/hello"
	}
}
