{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"required": ["document"],
	"properties": {
		"document": { "type": "string", "minLength": 1, "maxLength": 128 },
		"nodes": {
			"type": "array",
			"minItems": 1,
			"maxItems": 200,
			"items": { "type": "string", "minLength": 1, "maxLength": 256 }
		}
	}
}
