{
	"type": "object",
	"additionalProperties": false,
	"required": ["proposals"],
	"properties": {
		"space": {
			"type": "string",
			"description": "The space; default: the workspace's default space"
		},
		"review": {
			"type": "string",
			"description": "The review; absent, your newest open one; new, another",
			"maxLength": 28
		},
		"name": {
			"type": "string",
			"minLength": 1,
			"maxLength": 64,
			"description": "A label for a new review"
		},
		"idempotencyKey": {
			"type": "string",
			"minLength": 1,
			"maxLength": 256,
			"description": "Send the same key again to repeat a call safely: what the first call wrote is returned, and completed if it stopped part way"
		},
		"proposals": {
			"type": "array",
			"minItems": 1,
			"maxItems": 500,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["decide", "reason"],
				"properties": {
					"decide": {
						"type": "string",
						"enum": ["affirm", "decline", "reword", "duplicate", "undo"]
					},
					"idea": {
						"type": "string"
					},
					"version": {
						"type": "integer",
						"minimum": 1
					},
					"statement": {
						"type": "string",
						"minLength": 1
					},
					"keep": {
						"type": "string"
					},
					"target": {
						"type": "string"
					},
					"reason": {
						"type": "string",
						"minLength": 1,
						"maxLength": 200
					},
					"group": {
						"type": "string",
						"minLength": 1,
						"maxLength": 64
					},
					"confidence": {
						"type": "string",
						"enum": ["high", "medium", "low"]
					}
				}
			}
		}
	}
}
