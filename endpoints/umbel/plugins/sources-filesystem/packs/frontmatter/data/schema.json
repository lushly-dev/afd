{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Umbel document frontmatter",
	"description": "The Open Knowledge Format v0.2 keys and Umbel's extension keys. Any other key is allowed and kept.",
	"type": "object",
	"$defs": {
		"actor": {
			"type": "string",
			"minLength": 1
		},
		"datetime": {
			"type": "string",
			"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$"
		},
		"attestation": {
			"type": "object",
			"required": ["by", "at"],
			"properties": {
				"by": { "$ref": "#/$defs/actor" },
				"at": { "$ref": "#/$defs/datetime" }
			}
		},
		"strings": {
			"type": "array",
			"items": { "type": "string" }
		}
	},
	"properties": {
		"type": { "type": "string", "minLength": 1 },
		"title": { "type": "string" },
		"description": { "type": "string" },
		"resource": { "type": "string" },
		"tags": { "$ref": "#/$defs/strings" },
		"sources": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["resource"],
				"properties": {
					"resource": { "type": "string", "minLength": 1 },
					"id": { "type": "string" },
					"title": { "type": "string" },
					"author": { "type": "string" },
					"last_modified": { "type": "string" }
				}
			}
		},
		"generated": { "$ref": "#/$defs/attestation" },
		"verified": {
			"oneOf": [
				{ "$ref": "#/$defs/attestation" },
				{ "type": "array", "items": { "$ref": "#/$defs/attestation" } }
			]
		},
		"status": { "enum": ["draft", "stable", "deprecated"] },
		"stale_after": { "$ref": "#/$defs/datetime" },
		"okf_version": { "type": ["string", "number"] },
		"access": {
			"oneOf": [
				{ "type": "string" },
				{ "type": "array", "minItems": 1, "items": { "type": "string" } }
			]
		},
		"sensitivity": { "enum": ["public", "internal", "confidential", "restricted"] },
		"owners": { "$ref": "#/$defs/strings" },
		"aliases": { "$ref": "#/$defs/strings" },
		"superseded_by": { "type": "string" }
	},
	"additionalProperties": true
}
