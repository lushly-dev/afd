{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://afd.dev/umbel/schemas/proposal.v3.json",
	"title": "Umbel proposal record, version 3",
	"description": "A change to the knowledge base, proposed and then decided (D62, D17, D92), version 3 (phase 5 sections 2.4 and 7.3, D116): version 2 with a provenance envelope version 3 and a decision that records how its person was proven. channel gains mcp-elicitation, a decision made over MCP through the person page, and every person's decision carries assurance: { level: terminal, method: cli-terminal } at the CLI, and { level: verified, method: person-page, namespace, authTime, acr } over MCP; a policy decision carries none. A decision's reason carries reasonSource beside it (phase 5 step 6): person at a terminal, client over MCP, where the asking client wrote it and the person read it on the person page. Every version 2 field and rule keeps its meaning; version 1 and 2 records stay in their own version when decided, withdrawn or applied, and new proposals are version 3. Every version 1 field keeps its meaning; a version 1 record stays version 1 when it is decided, withdrawn or applied, and new proposals are version 2. The envelope is version 3 with authority null. drafter names the curator instance a drafted proposal came from: plugin, instance, pipeline and run are attested by the host's pipeline table; mode, candidate and promotedBy, like every memory evidence entry, are verified by the knowledge plugin against the memory store (phase 4 section 3.2). Memory evidence, a memory derivedFrom, a conflictSet and a drafter's withdrawal need a drafter. A redacted proposal (a source was forgotten) keeps no content, diff, verification note, decision reason, evidence excerpt, memory evidence beyond its reference, or derivedFrom, and its changeHash and the envelope's contentHash are sha256 of the canonical JSON { \"redacted\": \"<proposal id>\" }. Any draft that was not applied may be redacted: a withdrawn one (whoever withdrew it), a rejected one, and an approved one whose apply never landed, each keeping its decision or withdrawal; a pending one is withdrawn first, and an applied one never is. Rules that need more than a schema, such as changeHash equalling the envelope's contentHash, each derivedFrom entry matching a memory evidence entry, and the drafter's claims matching the store, are checked by the knowledge plugin.",
	"type": "object",
	"required": [
		"version",
		"id",
		"idempotencyKey",
		"changeHash",
		"space",
		"area",
		"state",
		"change",
		"diff",
		"rationale",
		"evidence",
		"provenance",
		"policy",
		"exception",
		"proposer",
		"confidence",
		"decision",
		"result",
		"flags",
		"createdAt",
		"updatedAt",
		"drafter",
		"conflictSet",
		"withdrawal",
		"redacted"
	],
	"additionalProperties": false,
	"properties": {
		"version": {
			"const": 3
		},
		"id": {
			"description": "p- and the first 20 hex of SHA-256 of <space>\\0<proposer actor string>\\0<idempotency_key>.",
			"type": "string",
			"pattern": "^p-[0-9a-f]{20}$"
		},
		"idempotencyKey": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128,
			"pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
		},
		"changeHash": {
			"description": "sha256 of the canonical JSON of change, rationale and evidence; for a redacted proposal, of { \"redacted\": \"<proposal id>\" }.",
			"type": "string",
			"pattern": "^sha256:[0-9a-f]{64}$"
		},
		"space": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]{0,62}$"
		},
		"area": {
			"description": "The area id that governs the target (phase 2 section 9.2).",
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]{0,62}$"
		},
		"state": {
			"enum": ["pending", "approved", "applied", "rejected", "withdrawn"]
		},
		"change": {
			"type": "object",
			"required": ["op", "doc", "baseHash"],
			"additionalProperties": false,
			"properties": {
				"op": {
					"enum": ["create", "update", "deprecate", "verify"]
				},
				"doc": {
					"type": "string",
					"minLength": 1,
					"maxLength": 512
				},
				"baseHash": {
					"description": "null only for create.",
					"oneOf": [
						{
							"type": "null"
						},
						{
							"type": "string",
							"pattern": "^sha256:[0-9a-f]{64}$"
						}
					]
				},
				"content": {
					"description": "The whole new file, for create and update, at most max_file_bytes; removed by a redaction.",
					"type": "string"
				},
				"supersededBy": {
					"type": "string",
					"minLength": 1
				},
				"verification": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"note": {
							"type": "string"
						},
						"staleAfter": {
							"type": "string"
						}
					}
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"op": {
								"const": "create"
							}
						},
						"required": ["op"]
					},
					"then": {
						"properties": {
							"baseHash": {
								"type": "null"
							}
						}
					},
					"else": {
						"properties": {
							"baseHash": {
								"type": "string",
								"pattern": "^sha256:[0-9a-f]{64}$"
							}
						}
					}
				}
			]
		},
		"diff": {
			"description": "A unified diff (3 lines of context) computed at submission; for deprecate and verify, the frontmatter change the apply step will write. Empty once redacted.",
			"type": "string"
		},
		"rationale": {
			"type": "string",
			"minLength": 1,
			"maxLength": 4000
		},
		"evidence": {
			"type": "array",
			"minItems": 1,
			"maxItems": 32,
			"items": {
				"oneOf": [
					{
						"$ref": "#/$defs/evidence"
					},
					{
						"$ref": "#/$defs/memoryEvidence"
					},
					{
						"$ref": "#/$defs/erasedEvidence"
					}
				]
			}
		},
		"provenance": {
			"description": "Envelope version 3. authority is null, as for every record; derivedFrom names a drafted proposal's memory sources, and is null otherwise.",
			"allOf": [
				{
					"$ref": "provenance-envelope.v3.json"
				},
				{
					"properties": {
						"authority": {
							"type": "null"
						},
						"derivedFrom": {
							"oneOf": [
								{
									"type": "null"
								},
								{
									"type": "array",
									"minItems": 1,
									"maxItems": 32,
									"items": {
										"type": "object",
										"required": ["kind", "id", "contentHash"],
										"additionalProperties": false,
										"properties": {
											"kind": {
												"const": "memory"
											},
											"id": {
												"type": "string",
												"pattern": "^mem-[0-9a-f]{24}$"
											},
											"contentHash": {
												"type": "string",
												"pattern": "^sha256:[0-9a-f]{64}$"
											}
										}
									}
								}
							]
						}
					}
				}
			]
		},
		"policy": {
			"type": "object",
			"required": ["area", "version", "rule"],
			"additionalProperties": false,
			"properties": {
				"area": {
					"type": "string",
					"pattern": "^[a-z][a-z0-9-]{0,62}$"
				},
				"version": {
					"description": "sha256 of the canonical JSON of the area's policy.",
					"type": "string",
					"pattern": "^sha256:[0-9a-f]{64}$"
				},
				"rule": {
					"description": "person (a person's decision at the CLI or over MCP), or auto:<rule id> for an area's deterministic rule (phase 4 section 8.3).",
					"type": "string",
					"pattern": "^(person|auto:[a-z][a-z0-9-]{0,62})$"
				}
			}
		},
		"exception": {
			"enum": [null, "self-approval"]
		},
		"proposer": {
			"type": "object",
			"required": ["actor", "principal"],
			"additionalProperties": false,
			"properties": {
				"actor": {
					"$ref": "#/$defs/actor"
				},
				"principal": {
					"$ref": "#/$defs/principal"
				},
				"run": {
					"type": "string",
					"maxLength": 128
				}
			}
		},
		"confidence": {
			"type": ["number", "null"],
			"minimum": 0,
			"maximum": 1
		},
		"decision": {
			"oneOf": [
				{
					"type": "null"
				},
				{
					"type": "object",
					"required": ["by", "principal", "at", "traceId", "proposerKind", "channel"],
					"additionalProperties": false,
					"properties": {
						"by": {
							"$ref": "#/$defs/actor"
						},
						"principal": {
							"$ref": "#/$defs/principal"
						},
						"at": {
							"type": "string",
							"minLength": 1
						},
						"reason": {
							"type": "string",
							"maxLength": 2000
						},
						"traceId": {
							"type": "string",
							"minLength": 1
						},
						"proposerKind": {
							"enum": ["human", "agent", "service", "script", "test"]
						},
						"channel": {
							"description": "terminal: a person at the CLI; mcp-elicitation: a person on the person page, reached over MCP (7.3); policy: an area's auto rule.",
							"enum": ["terminal", "mcp-elicitation", "policy"]
						},
						"assurance": {
							"$ref": "provenance-envelope.v3.json#/$defs/assurance"
						},
						"reasonSource": {
							"description": "Who wrote reason (phase 5 step 6): person, the person who decided at a terminal; client, the MCP client that asked, whose words the person read on the person page and confirmed. Present exactly when reason is, and removed with it by a redaction.",
							"enum": ["person", "client"]
						}
					},
					"dependentRequired": {
						"reason": ["reasonSource"],
						"reasonSource": ["reason"]
					},
					"allOf": [
						{
							"if": {
								"properties": {
									"channel": {
										"const": "policy"
									}
								},
								"required": ["channel"]
							},
							"then": {
								"properties": {
									"by": {
										"required": ["kind", "id"],
										"properties": {
											"kind": {
												"const": "service"
											},
											"id": {
												"type": "string",
												"pattern": "^policy:[a-z][a-z0-9-]{0,62}$"
											}
										}
									}
								}
							},
							"else": {
								"properties": {
									"by": {
										"properties": {
											"kind": {
												"const": "human"
											}
										}
									}
								}
							}
						},
						{
							"if": {
								"properties": {
									"channel": {
										"const": "terminal"
									}
								},
								"required": ["channel"]
							},
							"then": {
								"required": ["assurance"],
								"properties": {
									"assurance": {
										"properties": {
											"level": {
												"const": "terminal"
											}
										}
									},
									"reasonSource": {
										"const": "person"
									}
								}
							}
						},
						{
							"if": {
								"properties": {
									"channel": {
										"const": "mcp-elicitation"
									}
								},
								"required": ["channel"]
							},
							"then": {
								"required": ["assurance"],
								"properties": {
									"assurance": {
										"properties": {
											"level": {
												"const": "verified"
											}
										}
									},
									"reasonSource": {
										"const": "client"
									}
								}
							}
						},
						{
							"if": {
								"properties": {
									"channel": {
										"const": "policy"
									}
								},
								"required": ["channel"]
							},
							"then": {
								"not": {
									"required": ["assurance"]
								}
							}
						}
					]
				}
			]
		},
		"result": {
			"oneOf": [
				{
					"type": "null"
				},
				{
					"type": "object",
					"required": ["rev", "contentHash", "path"],
					"additionalProperties": false,
					"properties": {
						"rev": {
							"type": "integer",
							"minimum": 1
						},
						"contentHash": {
							"type": "string",
							"pattern": "^sha256:[0-9a-f]{64}$"
						},
						"path": {
							"type": "string",
							"minLength": 1
						}
					}
				},
				{
					"type": "object",
					"required": ["error"],
					"additionalProperties": false,
					"properties": {
						"error": {
							"type": "string",
							"minLength": 1
						}
					}
				}
			]
		},
		"flags": {
			"description": "The write scan's flags on the proposed content.",
			"type": "array",
			"uniqueItems": true,
			"items": {
				"type": "string",
				"pattern": "^[a-z][a-z0-9-]*$"
			}
		},
		"createdAt": {
			"type": "string",
			"minLength": 1,
			"description": "ISO 8601, from the command context's clock."
		},
		"updatedAt": {
			"type": "string",
			"minLength": 1,
			"description": "ISO 8601, from the command context's clock."
		},
		"drafter": {
			"description": "null, or the curator instance that drafted the proposal.",
			"oneOf": [
				{
					"type": "null"
				},
				{
					"$ref": "#/$defs/drafter"
				}
			]
		},
		"conflictSet": {
			"description": "null, or the conflict set a drafted alternative belongs to (phase 4 section 4.4).",
			"oneOf": [
				{
					"type": "null"
				},
				{
					"type": "string",
					"pattern": "^k-[0-9a-f]{20}$"
				}
			]
		},
		"withdrawal": {
			"description": "null unless the state is withdrawn: who withdrew it, why and when.",
			"oneOf": [
				{
					"type": "null"
				},
				{
					"type": "object",
					"required": ["by", "reason", "at"],
					"additionalProperties": false,
					"properties": {
						"by": {
							"enum": ["drafter", "proposer"]
						},
						"reason": {
							"enum": ["source-erased", "source-changed", "superseded-alternative", "retracted"]
						},
						"at": {
							"type": "string",
							"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
						}
					},
					"if": {
						"properties": {
							"by": {
								"const": "proposer"
							}
						},
						"required": ["by"]
					},
					"then": {
						"properties": {
							"reason": {
								"const": "retracted"
							}
						}
					}
				}
			]
		},
		"redacted": {
			"description": "null, or when a forgotten source's text was removed (phase 4 section 9.1).",
			"oneOf": [
				{
					"type": "null"
				},
				{
					"type": "object",
					"required": ["at", "reason"],
					"additionalProperties": false,
					"properties": {
						"at": {
							"type": "string",
							"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
						},
						"reason": {
							"const": "source-erased"
						}
					}
				}
			]
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"evidence": {
						"contains": {
							"properties": {
								"kind": {
									"const": "memory"
								}
							},
							"required": ["kind"]
						}
					}
				},
				"required": ["evidence"]
			},
			"then": {
				"properties": {
					"drafter": {
						"type": "object"
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"conflictSet": {
						"type": "string"
					}
				},
				"required": ["conflictSet"]
			},
			"then": {
				"properties": {
					"drafter": {
						"type": "object"
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"provenance": {
						"properties": {
							"derivedFrom": {
								"type": "array"
							}
						},
						"required": ["derivedFrom"]
					}
				},
				"required": ["provenance"]
			},
			"then": {
				"properties": {
					"drafter": {
						"type": "object"
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"withdrawal": {
						"type": "object",
						"properties": {
							"by": {
								"const": "drafter"
							}
						},
						"required": ["by"]
					}
				},
				"required": ["withdrawal"]
			},
			"then": {
				"properties": {
					"drafter": {
						"type": "object"
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"state": {
						"const": "withdrawn"
					}
				},
				"required": ["state"]
			},
			"then": {
				"properties": {
					"withdrawal": {
						"type": "object"
					}
				}
			},
			"else": {
				"properties": {
					"withdrawal": {
						"type": "null"
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"state": {
						"enum": ["pending", "applied"]
					}
				},
				"required": ["state"]
			},
			"then": {
				"properties": {
					"redacted": {
						"type": "null"
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"redacted": {
						"type": "object"
					}
				},
				"required": ["redacted"]
			},
			"then": {
				"properties": {
					"change": {
						"not": {
							"required": ["content"]
						},
						"properties": {
							"verification": {
								"not": {
									"required": ["note"]
								}
							}
						}
					},
					"diff": {
						"const": ""
					},
					"decision": {
						"not": {
							"type": "object",
							"required": ["reason"]
						}
					},
					"evidence": {
						"items": {
							"allOf": [
								{
									"not": {
										"properties": {
											"kind": {
												"const": "memory"
											}
										},
										"required": ["kind", "principal"]
									}
								},
								{
									"not": {
										"required": ["excerpt"]
									}
								}
							]
						}
					},
					"provenance": {
						"properties": {
							"derivedFrom": {
								"type": "null"
							}
						}
					}
				}
			},
			"else": {
				"properties": {
					"change": {
						"allOf": [
							{
								"if": {
									"properties": {
										"op": {
											"enum": ["create", "update"]
										}
									},
									"required": ["op"]
								},
								"then": {
									"required": ["content"]
								}
							}
						]
					},
					"evidence": {
						"items": {
							"not": {
								"required": ["erased"]
							}
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"policy": {
						"properties": {
							"rule": {
								"type": "string",
								"pattern": "^auto:"
							}
						}
					}
				},
				"required": ["policy"]
			},
			"then": {
				"properties": {
					"decision": {
						"oneOf": [
							{
								"type": "null"
							},
							{
								"type": "object",
								"properties": {
									"channel": {
										"const": "policy"
									}
								}
							}
						]
					}
				}
			},
			"else": {
				"properties": {
					"decision": {
						"oneOf": [
							{
								"type": "null"
							},
							{
								"type": "object",
								"properties": {
									"channel": {
										"enum": ["terminal", "mcp-elicitation"]
									}
								}
							}
						]
					}
				}
			}
		}
	],
	"$defs": {
		"actor": {
			"description": "AFD's Actor; it follows AFD's contract version.",
			"type": "object",
			"required": ["kind"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"enum": ["human", "agent", "service", "script", "test"]
				},
				"id": {
					"type": "string"
				},
				"label": {
					"type": "string"
				},
				"onBehalfOf": {
					"type": "string"
				}
			}
		},
		"principal": {
			"description": "<kind>:<id>: kind is human, agent, service or script; the id is 1 to 128 characters without a control character.",
			"type": "string",
			"pattern": "^(human|agent|service|script):[^\\u0000-\\u001f\\u007f-\\u009f]{1,128}$"
		},
		"evidence": {
			"description": "Version 1's evidence kinds.",
			"type": "object",
			"required": ["kind", "ref"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"enum": ["document", "url", "text", "record"]
				},
				"ref": {
					"type": "string",
					"minLength": 1
				},
				"contentHash": {
					"type": "string",
					"pattern": "^sha256:[0-9a-f]{64}$"
				},
				"excerpt": {
					"type": "string",
					"maxLength": 1000
				}
			}
		},
		"memoryEvidence": {
			"description": "A memory record a drafted proposal cites (D81): the fields copied from the record, each verified against the memory store when the proposal is submitted and again at approve.",
			"type": "object",
			"required": [
				"kind",
				"ref",
				"principal",
				"contentHash",
				"class",
				"authority",
				"origin",
				"constraints",
				"access",
				"sensitivity",
				"confirmation",
				"observations"
			],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "memory"
				},
				"ref": {
					"description": "<mem id>@<recordVersion>.",
					"type": "string",
					"pattern": "^mem-[0-9a-f]{24}@[1-9][0-9]{0,9}$"
				},
				"principal": {
					"$ref": "#/$defs/principal"
				},
				"contentHash": {
					"type": "string",
					"pattern": "^sha256:[0-9a-f]{64}$"
				},
				"class": {
					"description": "Only semantic and procedural records settle (D15).",
					"enum": ["semantic", "procedural"]
				},
				"authority": {
					"description": "transcript never settles (owner decision 9); document and external are not memory authorities.",
					"enum": ["person", "agent", "tool", "import"]
				},
				"origin": {
					"enum": ["user-stated", "agent-inferred", "document-derived"]
				},
				"constraints": {
					"oneOf": [
						{
							"type": "null"
						},
						{
							"type": "array",
							"maxItems": 16,
							"items": {
								"type": "string",
								"maxLength": 200
							}
						}
					]
				},
				"access": {
					"description": "An access set: never empty.",
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"pattern": "^(space|group:[a-z][a-z0-9-]{0,62}|principal:(human|agent|service|script):[^\\u0000-\\u001f\\u007f-\\u009f]{1,128})$"
					}
				},
				"sensitivity": {
					"enum": ["public", "internal", "confidential", "restricted"]
				},
				"confirmation": {
					"oneOf": [
						{
							"type": "null"
						},
						{
							"type": "object",
							"required": ["by", "at", "priorAuthority"],
							"additionalProperties": false,
							"properties": {
								"by": {
									"$ref": "#/$defs/principal"
								},
								"at": {
									"type": "string",
									"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
								},
								"priorAuthority": {
									"enum": [
										"person",
										"agent",
										"tool",
										"transcript",
										"import",
										"document",
										"external"
									]
								}
							}
						}
					]
				},
				"observations": {
					"description": "sessions: this record's observed sessions; principals: the distinct principals among the proposal's sources. Neither counts writes.",
					"type": "object",
					"required": ["sessions", "principals"],
					"additionalProperties": false,
					"properties": {
						"sessions": {
							"type": "integer",
							"minimum": 0
						},
						"principals": {
							"type": "integer",
							"minimum": 1
						}
					}
				},
				"excerpt": {
					"description": "The record's text cut at 1000 characters.",
					"type": "string",
					"maxLength": 1000
				}
			}
		},
		"erasedEvidence": {
			"description": "A memory evidence entry after its source was forgotten: only the reference stays.",
			"type": "object",
			"required": ["kind", "ref", "erased"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "memory"
				},
				"ref": {
					"type": "string",
					"pattern": "^mem-[0-9a-f]{24}@[1-9][0-9]{0,9}$"
				},
				"erased": {
					"const": true
				}
			}
		},
		"drafter": {
			"type": "object",
			"required": ["plugin", "instance", "pipeline", "run", "mode"],
			"additionalProperties": false,
			"properties": {
				"plugin": {
					"description": "Attested by the host: the drafting plugin's id.",
					"type": "string",
					"pattern": "^[a-z][a-z0-9]{0,31}$"
				},
				"instance": {
					"description": "Attested by the host: the drafting instance, one of the knowledge instance's drafters.",
					"type": "string",
					"pattern": "^[a-z][a-z0-9-]{0,31}$"
				},
				"pipeline": {
					"description": "Attested by the host: the pipeline the submitting step ran in.",
					"type": "string",
					"pattern": "^[a-z][a-z0-9]*(-[a-z][a-z0-9]*)+$"
				},
				"run": {
					"description": "Attested by the host: the pipeline call's trace id.",
					"type": "string",
					"pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]{1,128}$"
				},
				"mode": {
					"description": "Verified: promoted when the target's readers are wider than the sources'.",
					"enum": ["scheduled", "promoted"]
				},
				"candidate": {
					"description": "Verified against its derivation from the space, the caller and the lowest source id.",
					"type": "string",
					"pattern": "^c-[0-9a-f]{20}$"
				},
				"promotedBy": {
					"description": "Verified: the principal of every source, who consented at a terminal.",
					"$ref": "#/$defs/principal"
				}
			},
			"if": {
				"properties": {
					"mode": {
						"const": "promoted"
					}
				},
				"required": ["mode"]
			},
			"then": {
				"required": ["candidate", "promotedBy"]
			},
			"else": {
				"not": {
					"required": ["promotedBy"]
				}
			}
		}
	}
}
