{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://afd.dev/umbel/schemas/capture.v1.json",
	"title": "Umbel capture contract, version 1",
	"description": "The input of memory-capture (phase 3 section 10.1, D79): what a harness adapter, a CI step or a person sends for one window of a session, or one group of its parts. There is no share field: capture is always private. The principal and agent are never in the contract: the host fills them. idempotencyKey is derived from position, not content. Rules that need more than a schema, such as the field caps of section 4 and the secrets pack, are checked by the memory plugin.",
	"type": "object",
	"required": ["version", "harness", "event", "idempotencyKey"],
	"additionalProperties": false,
	"properties": {
		"version": {
			"const": 1
		},
		"space": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]{0,62}$"
		},
		"harness": {
			"type": "object",
			"required": ["name"],
			"additionalProperties": false,
			"properties": {
				"name": {
					"type": "string",
					"pattern": "^[a-z][a-z0-9-]{0,63}$"
				},
				"version": {
					"type": "string",
					"minLength": 1,
					"maxLength": 64
				}
			}
		},
		"event": {
			"enum": ["tool-use", "stop", "pre-compact", "session-end", "manual"]
		},
		"session": {
			"oneOf": [
				{
					"type": "null"
				},
				{
					"type": "string",
					"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
				}
			]
		},
		"project": {
			"oneOf": [
				{
					"type": "null"
				},
				{
					"type": "string",
					"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
				}
			]
		},
		"idempotencyKey": {
			"type": "string",
			"minLength": 1,
			"maxLength": 256
		},
		"captureKey": {
			"description": "The prefix a forget of these records will erase. When absent, a forget leaves no prefix.",
			"type": "string",
			"minLength": 1,
			"maxLength": 256
		},
		"window": {
			"type": "integer",
			"minimum": 0
		},
		"episodes": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["subject", "text"],
				"additionalProperties": false,
				"properties": {
					"subject": {
						"type": "string",
						"minLength": 1,
						"maxLength": 256
					},
					"text": {
						"type": "string",
						"minLength": 1
					},
					"startedAt": {
						"type": "string",
						"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
					},
					"part": {
						"type": "integer",
						"minimum": 0
					},
					"turns": {
						"type": "array",
						"minItems": 2,
						"maxItems": 2,
						"items": {
							"type": "integer",
							"minimum": 0
						}
					}
				}
			}
		},
		"decisions": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["subject", "text"],
				"additionalProperties": false,
				"properties": {
					"subject": {
						"type": "string",
						"minLength": 1,
						"maxLength": 256
					},
					"text": {
						"type": "string",
						"minLength": 1
					},
					"rationale": {
						"type": "string"
					},
					"origin": {
						"enum": ["user-stated", "agent-inferred"]
					},
					"constraints": {
						"type": "array",
						"maxItems": 16,
						"items": {
							"type": "string",
							"maxLength": 200
						}
					}
				}
			}
		},
		"artifacts": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["kind", "resource"],
				"additionalProperties": false,
				"properties": {
					"kind": {
						"type": "string",
						"pattern": "^[a-z][a-z0-9-]{0,31}$"
					},
					"resource": {
						"description": "A relative path or a URL, never an absolute path.",
						"type": "string",
						"minLength": 1,
						"pattern": "^[^/\\\\\\u0000]",
						"not": {
							"pattern": "^[A-Za-z]:[/\\\\]"
						}
					},
					"title": {
						"oneOf": [
							{
								"type": "null"
							},
							{
								"type": "string",
								"maxLength": 256
							}
						]
					},
					"summary": {
						"oneOf": [
							{
								"type": "null"
							},
							{
								"type": "string"
							}
						]
					}
				}
			}
		}
	}
}
