{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://afd.dev/umbel/schemas/eval-report.v1.json",
	"title": "Umbel eval report, version 1",
	"description": "What knowledge-eval returns (D65): recall@k, nDCG@k and MRR@k overall and per kind with graph expansion on and off, the unanswerable rate, leaks, latency, and the ranked document ids and scores of every query so a run can be diffed. Scores are rounded to 4 decimals. Latency is reported, never gated.",
	"type": "object",
	"required": [
		"version",
		"k",
		"spaces",
		"corpusDigest",
		"indexApplied",
		"rankingDigest",
		"hostVersion",
		"queries",
		"metrics",
		"unanswerable",
		"leaks",
		"latency",
		"results"
	],
	"additionalProperties": false,
	"properties": {
		"version": {
			"const": 1
		},
		"k": {
			"type": "integer",
			"minimum": 1
		},
		"spaces": {
			"type": "array",
			"minItems": 1,
			"maxItems": 8,
			"uniqueItems": true,
			"items": {
				"type": "string",
				"pattern": "^[a-z][a-z0-9-]{0,62}$"
			}
		},
		"corpusDigest": {
			"description": "sha256 over the sorted ids and content hashes of the evaluated spaces' documents.",
			"type": "string",
			"pattern": "^sha256:[0-9a-f]{64}$"
		},
		"indexApplied": {
			"description": "Each evaluated space's index applied revision.",
			"type": "object",
			"propertyNames": {
				"type": "string",
				"pattern": "^[a-z][a-z0-9-]{0,62}$"
			},
			"additionalProperties": {
				"type": "integer",
				"minimum": 0
			}
		},
		"rankingDigest": {
			"description": "sha256 of the pack ranking data the run used.",
			"type": "string",
			"pattern": "^sha256:[0-9a-f]{64}$"
		},
		"hostVersion": {
			"type": "string",
			"minLength": 1
		},
		"queries": {
			"type": "object",
			"required": ["total", "answerable", "unanswerable", "permission", "skipped"],
			"additionalProperties": false,
			"properties": {
				"total": {
					"type": "integer",
					"minimum": 0
				},
				"answerable": {
					"type": "integer",
					"minimum": 0
				},
				"unanswerable": {
					"type": "integer",
					"minimum": 0
				},
				"permission": {
					"type": "integer",
					"minimum": 0
				},
				"skipped": {
					"type": "integer",
					"minimum": 0
				}
			}
		},
		"metrics": {
			"type": "object",
			"required": ["overall", "byKind"],
			"additionalProperties": false,
			"properties": {
				"overall": {
					"description": "Metrics at k with graph expansion on and off; only the settings the run asked for.",
					"type": "object",
					"additionalProperties": false,
					"minProperties": 1,
					"properties": {
						"on": {
							"type": "object",
							"required": ["queries", "recall", "ndcg", "mrr"],
							"additionalProperties": false,
							"properties": {
								"queries": {
									"type": "integer",
									"minimum": 0
								},
								"recall": {
									"type": "number",
									"minimum": 0,
									"maximum": 1
								},
								"ndcg": {
									"type": "number",
									"minimum": 0,
									"maximum": 1
								},
								"mrr": {
									"type": "number",
									"minimum": 0,
									"maximum": 1
								}
							}
						},
						"off": {
							"type": "object",
							"required": ["queries", "recall", "ndcg", "mrr"],
							"additionalProperties": false,
							"properties": {
								"queries": {
									"type": "integer",
									"minimum": 0
								},
								"recall": {
									"type": "number",
									"minimum": 0,
									"maximum": 1
								},
								"ndcg": {
									"type": "number",
									"minimum": 0,
									"maximum": 1
								},
								"mrr": {
									"type": "number",
									"minimum": 0,
									"maximum": 1
								}
							}
						}
					}
				},
				"byKind": {
					"type": "object",
					"propertyNames": {
						"enum": ["exact", "alias", "phrase", "field", "multi-hop", "cross-space"]
					},
					"additionalProperties": {
						"description": "Metrics at k with graph expansion on and off; only the settings the run asked for.",
						"type": "object",
						"additionalProperties": false,
						"minProperties": 1,
						"properties": {
							"on": {
								"type": "object",
								"required": ["queries", "recall", "ndcg", "mrr"],
								"additionalProperties": false,
								"properties": {
									"queries": {
										"type": "integer",
										"minimum": 0
									},
									"recall": {
										"type": "number",
										"minimum": 0,
										"maximum": 1
									},
									"ndcg": {
										"type": "number",
										"minimum": 0,
										"maximum": 1
									},
									"mrr": {
										"type": "number",
										"minimum": 0,
										"maximum": 1
									}
								}
							},
							"off": {
								"type": "object",
								"required": ["queries", "recall", "ndcg", "mrr"],
								"additionalProperties": false,
								"properties": {
									"queries": {
										"type": "integer",
										"minimum": 0
									},
									"recall": {
										"type": "number",
										"minimum": 0,
										"maximum": 1
									},
									"ndcg": {
										"type": "number",
										"minimum": 0,
										"maximum": 1
									},
									"mrr": {
										"type": "number",
										"minimum": 0,
										"maximum": 1
									}
								}
							}
						}
					}
				}
			}
		},
		"unanswerable": {
			"type": "object",
			"required": ["emptyRate", "meanTopScore"],
			"additionalProperties": false,
			"properties": {
				"emptyRate": {
					"type": ["number", "null"],
					"minimum": 0,
					"maximum": 1
				},
				"meanTopScore": {
					"type": ["number", "null"],
					"minimum": 0
				}
			}
		},
		"leaks": {
			"description": "Returned documents the query's principal may not read, plus hits outside the query's spaces. Must be 0.",
			"type": "integer",
			"minimum": 0
		},
		"latency": {
			"type": "object",
			"required": ["p50Ms", "p95Ms"],
			"additionalProperties": false,
			"properties": {
				"p50Ms": {
					"type": "number",
					"minimum": 0
				},
				"p95Ms": {
					"type": "number",
					"minimum": 0
				}
			}
		},
		"results": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["id", "kind", "skipped", "runs"],
				"additionalProperties": false,
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^q-[0-9]{4,}$"
					},
					"kind": {
						"enum": [
							"exact",
							"alias",
							"phrase",
							"field",
							"multi-hop",
							"cross-space",
							"unanswerable",
							"permission"
						]
					},
					"skipped": {
						"description": "A query whose spaces are not all in the call's spaces is skipped, never run.",
						"type": "boolean"
					},
					"runs": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"on": {
								"type": "array",
								"items": {
									"type": "object",
									"required": ["space", "doc", "score"],
									"additionalProperties": false,
									"properties": {
										"space": {
											"type": "string",
											"pattern": "^[a-z][a-z0-9-]{0,62}$"
										},
										"doc": {
											"type": "string",
											"minLength": 1
										},
										"score": {
											"type": "number"
										}
									}
								}
							},
							"off": {
								"type": "array",
								"items": {
									"type": "object",
									"required": ["space", "doc", "score"],
									"additionalProperties": false,
									"properties": {
										"space": {
											"type": "string",
											"pattern": "^[a-z][a-z0-9-]{0,62}$"
										},
										"doc": {
											"type": "string",
											"minLength": 1
										},
										"score": {
											"type": "number"
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
