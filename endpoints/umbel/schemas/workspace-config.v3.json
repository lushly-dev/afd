{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://afd.dev/umbel/schemas/workspace-config.v3.json",
	"title": "Umbel workspace configuration, version 3",
	"description": "umbel.toml read as JSON. Version 3 is version 2 with collections per space (replacing the reserved content_roots, which version 3 refuses), readers per space, [access.groups] and [store] (D52); the host reads versions 1 and 2 as version 3 with no collections (workspace-config.v1.json, workspace-config.v2.json). Every key but config_version has a default baked into the binary. Reserved keys (spaces.<id>.backend, events.retention, plugins.<id>.grants) are accepted here and flagged by the doctor. Rules that need more than a schema, such as a loopback IP in http.bind, a declared default_space, an instance table for each id in plugins.enabled, spaces that are declared and prefixes that are unique, collection ids that are unique and roots that do not overlap and resolve inside the workspace, and a group named in an access token or in readers that [access.groups] declares, are checked when the host opens the workspace.",
	"type": "object",
	"required": ["config_version"],
	"additionalProperties": false,
	"properties": {
		"config_version": {
			"const": 3
		},
		"name": {
			"type": "string",
			"minLength": 1
		},
		"default_space": {
			"$ref": "#/$defs/spaceId"
		},
		"profile": {
			"enum": ["team"]
		},
		"spaces": {
			"type": "object",
			"propertyNames": {
				"$ref": "#/$defs/spaceId"
			},
			"additionalProperties": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"title": {
						"type": "string",
						"minLength": 1
					},
					"readers": {
						"description": "Who may read the space: \"*\", a principal string or group:<id>. Default [\"*\"].",
						"type": "array",
						"minItems": 1,
						"items": {
							"$ref": "#/$defs/reader"
						}
					},
					"collections": {
						"description": "The space's content roots (D52), keyed by collection id.",
						"type": "object",
						"propertyNames": {
							"$ref": "#/$defs/collectionId"
						},
						"additionalProperties": {
							"$ref": "#/$defs/collection"
						}
					},
					"backend": {
						"description": "Reserved (phase 6).",
						"type": "string"
					}
				}
			}
		},
		"access": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"groups": {
					"description": "Access groups, keyed by group id.",
					"type": "object",
					"propertyNames": {
						"$ref": "#/$defs/groupId"
					},
					"additionalProperties": {
						"type": "object",
						"additionalProperties": false,
						"required": ["members"],
						"properties": {
							"members": {
								"description": "Principal strings, or \"*\".",
								"type": "array",
								"items": {
									"$ref": "#/$defs/member"
								}
							}
						}
					}
				}
			}
		},
		"store": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"lock_timeout_ms": {
					"description": "SQLite busy timeout and tantivy writer wait. Default 5000.",
					"type": "integer",
					"minimum": 100,
					"maximum": 600000
				}
			}
		},
		"plugins": {
			"type": "object",
			"description": "enabled lists the instance ids in load order; every other key is an instance table named in it.",
			"properties": {
				"enabled": {
					"description": "Instance ids, in load order.",
					"type": "array",
					"uniqueItems": true,
					"items": {
						"$ref": "#/$defs/instanceId"
					}
				}
			},
			"propertyNames": {
				"$ref": "#/$defs/instanceIdOrList"
			},
			"additionalProperties": {
				"$ref": "#/$defs/instance"
			}
		},
		"mcp": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"first_class_tools": {
					"type": "array",
					"minItems": 1,
					"maxItems": 8,
					"items": {
						"type": "string",
						"pattern": "^[a-z][a-z0-9]*(-[a-z][a-z0-9]*)+$"
					}
				},
				"tools_list_ttl_ms": {
					"type": "integer",
					"minimum": 0
				},
				"confirmations": {
					"enum": ["enforce", "require-human", "off"]
				},
				"instructions": {
					"type": "string"
				}
			}
		},
		"http": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"bind": {
					"description": "A loopback socket address.",
					"type": "string",
					"pattern": "^(127(\\.[0-9]{1,3}){3}|\\[::1\\]):[0-9]{1,5}$"
				},
				"path": {
					"description": "Starts with /, is not / and not /health, and has no query, fragment or .. segment.",
					"type": "string",
					"pattern": "^/[^?#]+$",
					"not": {
						"anyOf": [
							{
								"const": "/health"
							},
							{
								"pattern": "(^|/)\\.\\.(/|$)"
							}
						]
					}
				},
				"allowed_hosts": {
					"description": "Host names or IP literals, optionally with a port; no wildcard.",
					"type": "array",
					"items": {
						"type": "string",
						"pattern": "^[^*\\s/?#@]+$"
					}
				},
				"allowed_origins": {
					"description": "Exact http or https origins; no wildcard and not null.",
					"type": "array",
					"items": {
						"type": "string",
						"pattern": "^https?://[^*\\s/?#@]+$"
					}
				},
				"max_body_bytes": {
					"type": "integer",
					"minimum": 1024,
					"maximum": 16777216
				}
			}
		},
		"journal": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"record_failures": {
					"type": "boolean"
				},
				"lock_timeout_ms": {
					"type": "integer",
					"minimum": 100,
					"maximum": 600000
				}
			}
		},
		"events": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"retention": {
					"description": "Reserved; phase 0 keeps every event.",
					"type": "string"
				}
			}
		},
		"log": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"level": {
					"enum": ["error", "warn", "info", "debug", "trace"]
				},
				"format": {
					"enum": ["text", "json"]
				}
			}
		},
		"principal": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"local_id": {
					"type": "string",
					"minLength": 1,
					"maxLength": 128
				},
				"on_behalf_of": {
					"type": "string",
					"minLength": 1
				}
			}
		}
	},
	"$defs": {
		"spaceId": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]{0,62}$"
		},
		"instanceId": {
			"description": "Not \"enabled\": [plugins.enabled] would collide with the list.",
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]{0,31}$",
			"not": {
				"const": "enabled"
			}
		},
		"envName": {
			"type": "string",
			"pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
		},
		"limits": {
			"description": "A component's per-call limits, within the host caps (specification section 6.2).",
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"fuel": {
					"type": "integer",
					"minimum": 1,
					"maximum": 20000000000
				},
				"timeout_ms": {
					"type": "integer",
					"minimum": 1,
					"maximum": 60000
				},
				"memory_bytes": {
					"type": "integer",
					"minimum": 65536,
					"maximum": 1073741824
				},
				"table_elements": {
					"type": "integer",
					"minimum": 1,
					"maximum": 1000000
				}
			}
		},
		"instance": {
			"description": "One plugin instance. The keys that apply depend on the plugin's kind, which only its manifest knows; the host checks that at load and the doctor checks it in plugins.sources.",
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"source": {
					"description": "compiled:<id>, or a relative directory inside the workspace that holds umbel-plugin.toml. Default: compiled:<instance id> when the binary has it, plugins/<instance id> when that directory exists.",
					"type": "string",
					"minLength": 1,
					"anyOf": [
						{
							"pattern": "^compiled:[a-z][a-z0-9]{0,31}$"
						},
						{
							"pattern": "^[^/\\\\\\u0000][^\\\\\\u0000]*$",
							"not": {
								"anyOf": [
									{
										"pattern": "^compiled:"
									},
									{
										"pattern": "(^|/)\\.\\.(/|$)"
									}
								]
							}
						}
					]
				},
				"required": {
					"description": "Default true, and false for an HTTP mount.",
					"type": "boolean"
				},
				"spaces": {
					"description": "Default: every declared space.",
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"$ref": "#/$defs/spaceId"
					}
				},
				"deny": {
					"description": "Grants withheld from the plugin.",
					"type": "array",
					"uniqueItems": true,
					"items": {
						"enum": [
							"config",
							"log",
							"packs",
							"events",
							"clock",
							"random",
							"documents",
							"index",
							"graph",
							"memory",
							"http",
							"secrets"
						]
					}
				},
				"config": {
					"description": "Validated against the plugin manifest's configuration schema.",
					"type": "object"
				},
				"limits": {
					"$ref": "#/$defs/limits"
				},
				"prefix": {
					"description": "Mounted only: replaces the plugin's domain for this instance.",
					"type": "string",
					"pattern": "^[a-z][a-z0-9]{0,31}$",
					"not": {
						"enum": [
							"workspace",
							"space",
							"event",
							"plugin",
							"skill",
							"afd",
							"store",
							"init",
							"serve",
							"help",
							"docs",
							"schema",
							"call",
							"batch"
						]
					}
				},
				"url": {
					"description": "HTTP mounts only, required there: https, or http on a loopback address.",
					"type": "string",
					"pattern": "^(https://[^\\s@/?#]+|http://(localhost|127(\\.[0-9]{1,3}){3}|\\[::1\\])(:[0-9]{1,5})?)([/?#]\\S*)?$"
				},
				"bearer_env": {
					"description": "HTTP mounts only: the environment variable that holds the deployer's own bearer token.",
					"$ref": "#/$defs/envName"
				},
				"connect_timeout_ms": {
					"type": "integer",
					"minimum": 1,
					"maximum": 60000
				},
				"timeout_ms": {
					"type": "integer",
					"minimum": 1,
					"maximum": 300000
				},
				"max_result_bytes": {
					"type": "integer",
					"minimum": 1,
					"maximum": 16777216
				},
				"env": {
					"description": "Stdio mounts only: added to PATH and the manifest's env, overriding it.",
					"type": "object",
					"propertyNames": {
						"$ref": "#/$defs/envName"
					},
					"additionalProperties": {
						"type": "string"
					}
				},
				"grants": {
					"description": "Reserved (D42): the per-instance allow-list of the future write, http and secrets grants.",
					"type": "object",
					"additionalProperties": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"allow": {
								"type": "array",
								"items": {
									"type": "string"
								}
							}
						}
					}
				}
			}
		},
		"instanceIdOrList": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]{0,31}$"
		},
		"groupId": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]{0,62}$"
		},
		"collectionId": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]{0,62}$"
		},
		"principalString": {
			"description": "<kind>:<id>: kind is human, agent, service or script; the id is 1 to 128 characters without a control character and may hold colons.",
			"type": "string",
			"pattern": "^(human|agent|service|script):[^\\u0000-\\u001f\\u007f-\\u009f]{1,128}$"
		},
		"reader": {
			"description": "\"*\", a principal string or group:<id>.",
			"oneOf": [
				{
					"const": "*"
				},
				{
					"$ref": "#/$defs/principalString"
				},
				{
					"type": "string",
					"pattern": "^group:[a-z][a-z0-9-]{0,62}$"
				}
			]
		},
		"member": {
			"oneOf": [
				{
					"const": "*"
				},
				{
					"$ref": "#/$defs/principalString"
				}
			]
		},
		"accessToken": {
			"description": "space, group:<id> or principal:<kind>:<id>.",
			"type": "string",
			"pattern": "^(space|group:[a-z][a-z0-9-]{0,62}|principal:(human|agent|service|script):[^\\u0000-\\u001f\\u007f-\\u009f]{1,128})$"
		},
		"collection": {
			"type": "object",
			"additionalProperties": false,
			"required": ["root"],
			"properties": {
				"root": {
					"description": "Relative to the workspace, with / separators, no .. segment, resolving inside the workspace. The root itself may be a symbolic link to a directory inside the workspace.",
					"type": "string",
					"pattern": "^[^/\\\\\\u0000][^\\\\\\u0000]*$",
					"not": {
						"pattern": "(^|/)\\.\\.(/|$)"
					}
				},
				"kind": {
					"description": "Default markdown.",
					"enum": ["markdown", "code"]
				},
				"include": {
					"description": "Globset patterns. Default by kind: markdown **/*.md; code **/*.rs, **/*.py, **/*.ts, **/*.tsx, **/*.js, **/*.jsx, **/*.mjs.",
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1,
						"maxLength": 512,
						"pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
					}
				},
				"exclude": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1,
						"maxLength": 512,
						"pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
					}
				},
				"access": {
					"description": "The default access set of the collection's documents. Default [\"space\"].",
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/accessToken"
					}
				},
				"sensitivity": {
					"description": "Default internal.",
					"enum": ["public", "internal", "confidential", "restricted"]
				},
				"default_type": {
					"description": "The type of a file without frontmatter or without type. Default document (code for a code collection).",
					"type": "string",
					"minLength": 1,
					"maxLength": 128,
					"pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
				},
				"strict": {
					"description": "Skip a file whose frontmatter fails the schema. Default false.",
					"type": "boolean"
				},
				"max_file_bytes": {
					"description": "Default 1048576.",
					"type": "integer",
					"minimum": 1,
					"maximum": 16777216
				}
			}
		}
	}
}
