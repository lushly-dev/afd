{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://afd.dev/umbel/schemas/provenance-envelope.v0.json",
	"title": "Umbel provenance envelope, version 0",
	"description": "Where a record came from, carried on every event. Reserved, and refused by version 0: sources, generated, contentHash, derivedFrom, access, sensitivity, redactions, delegationChain, tenant.",
	"type": "object",
	"required": [
		"version",
		"origin",
		"space",
		"agent",
		"principal",
		"session",
		"traceId",
		"observedAt",
		"validFrom",
		"validUntil",
		"confidence",
		"authority"
	],
	"additionalProperties": false,
	"properties": {
		"version": { "const": 0 },
		"origin": { "enum": ["user-stated", "agent-inferred", "document-derived", "unspecified"] },
		"space": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
		"agent": {
			"description": "The actor when its kind is agent, service or script; otherwise null.",
			"oneOf": [{ "type": "null" }, { "$ref": "#/$defs/actor" }]
		},
		"principal": { "description": "The person the call acted for.", "type": ["string", "null"] },
		"session": { "type": ["string", "null"] },
		"traceId": { "type": ["string", "null"] },
		"observedAt": { "type": "string", "minLength": 1, "description": "ISO 8601" },
		"validFrom": { "type": ["string", "null"], "description": "ISO 8601" },
		"validUntil": { "type": ["string", "null"], "description": "ISO 8601" },
		"confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
		"authority": { "type": ["string", "null"] }
	},
	"$defs": {
		"actor": {
			"description": "AFD's Actor; it follows AFD's contract version.",
			"type": "object",
			"required": ["kind"],
			"additionalProperties": false,
			"properties": {
				"kind": { "enum": ["human", "agent", "service", "script", "test"] },
				"id": { "type": "string" },
				"label": { "type": "string" },
				"onBehalfOf": { "type": "string" }
			}
		}
	}
}
