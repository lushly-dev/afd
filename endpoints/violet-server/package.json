{
	"name": "@lushly-dev/violet-server",
	"version": "0.2.0",
	"license": "MIT",
	"author": "Falkicon",
	"repository": {
		"type": "git",
		"url": "https://github.com/lushly-dev/afd.git",
		"directory": "endpoints/violet-server"
	},
	"homepage": "https://github.com/lushly-dev/afd#readme",
	"bugs": {
		"url": "https://github.com/lushly-dev/afd/issues"
	},
	"publishConfig": {
		"access": "public",
		"bin": {
			"violet-mcp": "./dist/bin.js"
		}
	},
	"keywords": [
		"violet",
		"design-tokens",
		"mcp",
		"rest-api",
		"agent-first"
	],
	"engines": {
		"node": ">=24"
	},
	"description": "Violet Design MCP Server - AI agent interface",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./server": {
			"import": "./dist/server.js",
			"types": "./dist/server.d.ts"
		},
		"./api": {
			"import": "./dist/api.js",
			"types": "./dist/api.d.ts"
		}
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"api": "node dist/api.js",
		"api:dev": "tsc && node dist/api.js",
		"lint": "biome check src/",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"clean": "rm -rf dist *.tsbuildinfo"
	},
	"dependencies": {
		"@lushly-dev/violet-afd": "workspace:*",
		"@lushly-dev/violet-core": "workspace:*",
		"@modelcontextprotocol/sdk": "^1.31.0",
		"nanoid": "^6.0.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.0",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	]
}
