		{
			"description": "HTTPS URL with percent-encoded dot-segment is rejected for CIMD",
			"clientId": "https://afd.dev/oauth/%2e%2e/client.json",
			"valid": false
		},
		{
			"description": "HTTPS URL with slash-only path is rejected for CIMD",
			"clientId": "https://afd.dev//",
			"valid": false
