			"valid": true
		}
	],
	"resourceValidation": [
		{
			"description": "canonical resource strips query and fragment and lowercases scheme and host",
			"serverUrl": "HTTPS://Loam.Example.COM:8443/mcp?foo=bar#sec",
			"expectedCanonical": "https://loam.example.com:8443/mcp"
		},
		{
			"description": "same-origin resource_metadata accepted",
			"serverUrl": "https://loam.example.com/mcp",
			"resourceMetadata": "https://LOAM.EXAMPLE.COM/.well-known/oauth-protected-resource/mcp",
			"sameOrigin": true
		},
		{
			"description": "cross-origin resource_metadata rejected",
			"serverUrl": "https://loam.example.com/mcp",
			"resourceMetadata": "https://evil.example.com/.well-known/oauth-protected-resource/mcp",
			"sameOrigin": false
		},
		{
			"description": "scheme downgrade on resource_metadata rejected",
			"serverUrl": "https://loam.example.com/mcp",
			"resourceMetadata": "http://loam.example.com/.well-known/oauth-protected-resource/mcp",
			"sameOrigin": false
		},
		{
			"description": "port mismatch on resource_metadata rejected",
			"serverUrl": "https://loam.example.com/mcp",
			"resourceMetadata": "https://loam.example.com:8443/.well-known/oauth-protected-resource/mcp",
			"sameOrigin": false
		}
	],
	"redaction": [
		{
			"description": "OAuth callback URL redacts code and code_verifier",
			"kind": "url",
			"input": "http://127.0.0.1:43210/callback?code=authcode-secret&state=abc&code_verifier=pkce-secret",
			"expected": "http://127.0.0.1:43210/callback?code=***&state=abc&code_verifier=***"
		},
		{
			"description": "Authorization header value is redacted",
			"kind": "header",
			"name": "Authorization",
			"value": "Bearer eyJhbGciOiJFZERTQSJ9.secret.sig",
			"expected": "[redacted]"
		},
		{
			"description": "lowercase authorization header is redacted",
			"kind": "header",
			"name": "authorization",
			"value": "Basic dXNlcjpwYXNz",
			"expected": "[redacted]"
		},
		{
			"description": "Cookie header is redacted",
			"kind": "header",
			"name": "Cookie",
			"value": "__Secure-session=secret",
			"expected": "[redacted]"
		},
		{
			"description": "non-sensitive header is preserved",
			"kind": "header",
			"name": "X-Tenant",
			"value": "acme",
			"expected": "acme"
		}
	]
}
