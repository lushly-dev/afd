		{
			"description": "HTTPS URL with percent-encoded path separator is rejected for CIMD",
			"clientId": "https://afd.dev/oauth%2Fcli-client.json",
			"valid": false
		},
		{
			"description": "HTTPS URL with malformed percent-escape is rejected for CIMD",
			"clientId": "https://afd.dev/oauth/%ZZ/client.json",
			"valid": false
		},
		{
			"description": "HTTPS URL with IP-literal host and valid path is syntactically valid CIMD (fetch SSRF policy belongs to the AS)",
