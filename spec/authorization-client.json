			"clientId": "https://afd.dev",
			"valid": false
		},
		{
			"description": "HTTPS URL with root slash only is rejected for CIMD",
			"clientId": "https://afd.dev/",
			"valid": false
		},
		{
			"description": "HTTPS URL with query string is rejected for CIMD",
			"clientId": "https://afd.dev/oauth/client.json?v=1",
			"valid": false
		},
		{
			"description": "HTTPS URL with fragment is rejected for CIMD",
			"clientId": "https://afd.dev/oauth/client.json#top",
			"valid": false
		},
		{
			"description": "HTTPS URL with userinfo is rejected for CIMD",
			"clientId": "https://user@afd.dev/oauth/client.json",
			"valid": false
		},
