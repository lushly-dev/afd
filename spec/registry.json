	"parts": [
		{
			"file": "spec/protocol-conformance.json",
			"sections": {
				"streamSupport": "streaming",
				"streamCases": "streaming"
			},
			"entries": [
				{
					"path": "tests",
					"key": "name",
					"owners": {
						"contexts": [
							"context_list_configured",
							"context_legacy_enter_allows_read",
							"context_legacy_enter_blocks_edit",
							"context_legacy_unknown_context",
							"context_modern_meta_allows_read",
							"context_modern_meta_blocks_edit_statelessly"
						]
					}
				}
			]
		},
		{
			"file": "spec/vectors/dispatch.json",
			"entries": [
				{
					"path": "cases",
					"key": "id",
					"owners": {
						"contexts": ["out-of-context", "out-of-context-before-validation"],
						"approvals": ["approval-required"],
						"confirmations": ["mcp-confirmation-required", "mcp-confirmation-acknowledged"]
					}
				}
			]
		},
		{
			"file": "spec/vectors/journal-seams.json",
