			}
		},
		{
			"file": "spec/vectors/tool-strategies.json",
			"sections": {
				"contextTools": "contexts",
				"contexts": "contexts"
			},
			"entries": [
				{
					"path": "servers",
					"key": "id",
					"owners": {
						"contexts": ["contexts"]
					}
				},
				{
					"path": "servers[id=no-contexts]/calls",
					"key": "tool",
					"owners": {
						"confirmations": ["note-delete"]
					}
				},
				{
					"path": "constructionFailures",
					"key": "id",
					"owners": {
						"contexts": ["context-tool"]
					}
				}
			]
		}
	],
