{
	"description": "Idempotency keys (spec/idempotency.md): what a command declares (D1, D2), the key (K1 to K6), the engine's step (S1 to S11, S13), retrying (R1 to R3) and the journal. Specification-authored. A language listed in `gaps` loads this file, checks that it is still listed, and skips every case with its issue as the reason; TypeScript runs every case.",
	"gaps": {
		"python": "https://github.com/lushly-dev/afd/issues/2676",
		"rust": "https://github.com/lushly-dev/afd/issues/2676",
		"cpp": "https://github.com/lushly-dev/afd/issues/2676"
	},
	"metaKey": "dev.afd/idempotencyKey",
	"declaration": {
		"cases": [
			{
				"description": "natural reports the idempotent hint",
				"rule": "D2",
				"command": {
					"mutation": true,
					"idempotency": "natural"
				},
				"expect": {
					"metaIdempotency": "natural",
					"idempotentHint": true
				}
			},
			{
				"description": "keyed is reported and sets no hint",
				"rule": "D2",
				"command": {
					"mutation": true,
					"idempotency": "keyed"
				},
				"expect": {
					"metaIdempotency": "keyed",
					"idempotentHint": null
				}
			},
			{
				"description": "an undeclared mutation reports neither",
				"rule": "D1",
				"command": {
					"mutation": true
				},
				"expect": {
					"metaIdempotency": null,
					"idempotentHint": null
				}
			},
			{
				"description": "a command that is not a mutation is not thereby natural",
				"rule": "D1",
				"command": {},
				"expect": {
					"metaIdempotency": null,
					"idempotentHint": null
				}
			}
		]
	},
	"key": {
		"form": [
			{
				"description": "one character",
				"key": "a",
				"valid": true
			},
			{
				"description": "every kind of allowed character",
				"key": "Order-2026.11_26~retry1",
				"valid": true
			},
			{
				"description": "200 characters",
				"repeat": "k",
				"times": 200,
				"valid": true
			},
			{
				"description": "201 characters",
				"repeat": "k",
				"times": 201,
				"valid": false
			},
			{
				"description": "the empty string",
				"key": "",
				"valid": false
			},
			{
				"description": "a colon, which derived keys use",
				"key": "a:b",
				"valid": false
			},
			{
				"description": "a space",
				"key": "a b",
				"valid": false
			},
			{
				"description": "a slash",
				"key": "a/b",
				"valid": false
			},
			{
				"description": "a letter outside ASCII",
				"key": "café",
				"valid": false
			},
			{
				"description": "a number, not a string",
				"key": 42,
				"valid": false
			}
		],
		"derived": [
			{
				"base": "k1",
				"kind": "batch",
				"index": 0,
				"expected": "k1:0"
			},
			{
				"base": "k1",
				"kind": "batch",
				"index": 12,
				"expected": "k1:12"
			},
			{
				"base": "k1",
				"kind": "pipeline",
				"index": 0,
				"expected": "k1:step:0"
			},
			{
				"base": "k1",
				"kind": "pipeline",
				"index": 3,
				"expected": "k1:step:3"
			}
		],
		"delivery": [
			{
				"description": "a key in _meta reaches the handler of a command that declares nothing",
				"rule": "K3",
				"via": "meta",
				"key": "k1",
				"expect": {
					"success": true,
					"handlerSeesKey": "k1"
				}
			},
			{
				"description": "a key in a meta-tool's meta argument reaches the handler",
				"rule": "K1",
				"via": "meta-argument",
				"key": "k1",
				"expect": {
					"success": true,
					"handlerSeesKey": "k1"
				}
			},
			{
				"description": "a key an in-process caller sets on the context reaches the handler",
				"rule": "K1",
				"via": "context",
				"key": "k1",
				"expect": {
					"success": true,
					"handlerSeesKey": "k1"
				}
			},
			{
				"description": "a call without a key gives the handler none",
				"rule": "K3",
				"via": "meta",
				"expect": {
					"success": true,
					"handlerSeesKey": null
				}
			},
			{
				"description": "an input member with the key's name is not the key",
				"rule": "K1",
				"via": "input",
				"key": "k1",
				"expect": {
					"success": true,
					"handlerSeesKey": null
				}
			},
			{
				"description": "an invalid key fails the call before the handler and names the _meta key",
				"rule": "K2",
				"via": "meta",
				"key": "a:b",
				"expect": {
					"success": false,
					"code": "VALIDATION_ERROR",
					"handlerRuns": 0,
					"detailsMeta": "dev.afd/idempotencyKey"
				}
			},
			{
				"description": "each batch item's handler sees its derived key",
				"rule": "K4",
				"via": "meta",
				"kind": "batch",
				"key": "k1",
				"items": 2,
				"expect": {
					"handlerSeesKeys": ["k1:0", "k1:1"]
				}
			},
			{
				"description": "each pipeline step's handler sees its derived key",
				"rule": "K4",
				"via": "meta",
				"kind": "pipeline",
				"key": "k1",
				"items": 2,
				"expect": {
					"handlerSeesKeys": ["k1:step:0", "k1:step:1"]
				}
			},
			{
				"description": "null is no key, and the call runs without one",
				"rule": "K2",
				"via": "meta",
				"key": null,
				"keyIsNull": true,
				"expect": {
					"success": true,
					"handlerSeesKey": null
				}
			},
			{
				"description": "a caller cannot supply a key shaped like a derived one, on the context either",
				"rule": "K2",
				"via": "context",
				"key": "k1:0",
				"expect": {
					"success": false,
					"code": "VALIDATION_ERROR",
					"handlerRuns": 0,
					"detailsMeta": "dev.afd/idempotencyKey"
				}
			},
			{
				"description": "a nested call does not inherit the key the handler was given",
				"rule": "K6",
				"via": "meta",
				"key": "k1",
				"nested": true,
				"expect": {
					"success": true,
					"handlerSeesKey": "k1",
					"nestedHandlerSeesKey": null
				}
			}
		]
	},
	"step": {
		"setup": {
			"options": {
				"ttlMs": 86400000,
				"leaseMs": 60000
			},
			"clock": "The step's clock is the harness's. It starts at 0 and a call's `at` sets it, in milliseconds, before that call is made.",
			"commands": [
				{
					"name": "order-place",
					"mutation": true,
					"idempotency": "keyed",
					"handler": "Returns success with data { \"placed\": n }, where n counts the handlers that have started in the case, this one included, taken when this handler starts."
				},
				{
					"name": "order-refuse",
					"mutation": true,
					"idempotency": "keyed",
					"handler": "Returns a failure with code CONFLICT, retryable false."
				},
				{
					"name": "order-flaky",
					"mutation": true,
					"idempotency": "keyed",
					"handler": "The first time it runs in a case it returns a failure with code TRANSIENT_ERROR, retryable true. After that it returns what order-place returns."
				},
				{
					"name": "order-timeout",
					"mutation": true,
					"idempotency": "keyed",
					"handler": "Returns a failure with code TIMEOUT, retryable true."
				},
				{
					"name": "order-throw",
					"mutation": true,
					"idempotency": "keyed",
					"handler": "Throws, or panics, where the language can. A language or build that cannot skips the cases that use it."
				},
				{
					"name": "order-approve",
					"mutation": true,
					"idempotency": "keyed",
					"approval": "required",
					"handler": "As order-place."
				},
				{
					"name": "order-set",
					"mutation": true,
					"idempotency": "natural",
					"handler": "As order-place."
				},
				{
					"name": "order-note",
					"mutation": true,
					"handler": "As order-place."
				},
				{
					"name": "order-claims-replay",
					"mutation": true,
					"idempotency": "keyed",
					"handler": "As order-place, with metadata { \"idempotentReplay\": true, \"note\": \"kept\" } on its result."
				},
				{
					"name": "order-task",
					"mutation": true,
					"idempotency": "keyed",
					"task": "optional",
					"handler": "As order-place. It breaks D5 on purpose: a command that may run as a task must answer repeats in its handler, and this one does not, so the case shows a repeat applied twice."
				}
			],
			"actors": {
				"agent": {
					"kind": "agent",
					"id": "advisor"
				},
				"other": {
					"kind": "agent",
					"id": "reviewer"
				}
			},
			"input": "Every command takes { \"sku\": string, \"count\"?: integer } and its schema keeps both members.",
			"contextFields": "One declared context field, `project`, a string, not required. A call's `context` gives its values."
		},
		"cases": [
			{
				"description": "the first call runs and a repeat is answered from the store",
				"rule": "S5",
				"calls": [
					{
						"command": "order-place",
						"input": {
							"sku": "a"
						},
						"key": "k1",
						"expect": {
							"success": true,
							"data": {
								"placed": 1
							},
							"replay": false
						}
					},
					{
						"command": "order-place",
						"input": {
							"sku": "a"
						},
						"key": "k1",
						"expect": {
							"success": true,
							"data": {
								"placed": 1
							},
							"replay": true
						}
					}
				],
				"handlerRuns": 1
			},
			{
				"description": "another key runs the handler again",
				"rule": "K5",
				"calls": [
					{
						"command": "order-place",
						"input": {
							"sku": "a"
						},
						"key": "k1",
						"expect": {
							"success": true,
							"data": {
								"placed": 1
							},
							"replay": false
						}
					},
					{
						"command": "order-place",
						"input": {
							"sku": "a"
						},
						"key": "k2",
						"expect": {
							"success": true,
							"data": {
								"placed": 2
							},
							"replay": false
						}
					}
				],
				"handlerRuns": 2
			},
			{
				"description": "a keyed command without a key runs every time",
				"rule": "S2",
