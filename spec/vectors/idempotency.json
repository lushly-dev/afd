	"timeoutRecovery": {
		"setup": "A server with the engine's step, unless `withStep` is false, and a handler that outlives the call's deadline, so the engine gives the caller TIMEOUT.",
		"cases": [
			{
				"description": "a keyed call that carried a key may be repeated",
				"rule": "R3",
				"command": {
					"mutation": true,
					"idempotency": "keyed"
				},
				"key": true,
				"expect": {
					"code": "TIMEOUT",
					"retryable": true,
					"recovery": {
						"kind": "retry"
					}
				}
			},
			{
				"description": "a keyed call without a key carries no recovery",
				"rule": "R3",
				"command": {
					"mutation": true,
					"idempotency": "keyed"
				},
				"key": false,
				"expect": {
					"code": "TIMEOUT",
					"retryable": true,
					"recovery": null
				}
			},
			{
				"description": "a key on an undeclared mutation carries no recovery",
				"rule": "R3",
				"command": {
					"mutation": true
				},
				"key": true,
				"expect": {
					"code": "TIMEOUT",
					"retryable": true,
					"recovery": null
				}
			},
			{
				"description": "without the step, a keyed call that carried a key carries no recovery",
				"rule": "R3",
				"command": {
					"mutation": true,
					"idempotency": "keyed"
				},
				"key": true,
				"withStep": false,
				"expect": {
					"code": "TIMEOUT",
					"retryable": true,
					"recovery": null
				}
			}
		]
	},
	"journal": {
		"cases": [
			{
				"description": "an entry for a call that carried a key records it, and the digest hashes it as a member",
				"key": "k1",
				"expect": {
					"entryIdempotencyKey": "k1",
					"digestHashHasMember": true
				}
			},
			{
				"description": "an entry for a call without a key has no such member",
				"expect": {
					"entryIdempotencyKey": null
				}
			},
			{
				"description": "replay gives the handler the recorded key",
				"key": "k1",
				"replay": true,
				"expect": {
					"handlerSeesKey": "k1",
					"status": "same"
				}
			},
			{
				"description": "a batch's derived keys are recorded as derived and restored on replay",
				"kind": "batch",
				"key": "b1",
				"items": 2,
				"replay": true,
				"expect": {
					"entryIdempotencyKeys": ["b1:0", "b1:1"],
					"handlerSeesKeys": ["b1:0", "b1:1"]
				}
			}
		]
	}
}
