					{
						"command": "order-place",
						"input": {
							"sku": "a"
						},
						"expect": {
							"success": true,
							"data": {
								"placed": 1
							},
							"replay": false
						}
					},
					{
						"command": "order-place",
						"input": {
							"sku": "a"
						},
						"expect": {
							"success": true,
							"data": {
								"placed": 2
							},
							"replay": false
						}
					}
				],
				"handlerRuns": 2
			},
			{
				"description": "the same key with another input is refused",
				"rule": "S5",
				"calls": [
					{
						"command": "order-place",
