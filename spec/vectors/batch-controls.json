		{
			"name": "a failure stops the pipeline; later steps are skipped without an error",
			"handlers": {
				"fail-now": {
					"fail": {
						"code": "EXPECTED",
						"message": "failed on purpose"
					}
				},
				"then-run": {}
			},
			"request": {
				"steps": [
					{
						"command": "fail-now"
					},
					{
						"command": "then-run"
					}
				]
			},
			"expected": {
				"calls": [
					{
						"command": "fail-now",
						"input": {}
					}
				],
				"completedSteps": 0,
				"totalSteps": 2,
				"steps": [
					{
						"index": 0,
						"command": "fail-now",
						"status": "failure",
						"error": {
							"code": "EXPECTED",
							"message": "failed on purpose"
						}
					},
					{
						"index": 1,
						"command": "then-run",
						"status": "skipped"
					}
				]
			}
		},
