	"constraints": {
		"studio": [
			{
				"id": "space-ramp",
				"name": "Spacing tokens use ref.space.*",
				"applyTo": "space.*",
				"severity": "error",
				"config": {
					"type": "ramp",
					"ramp": "ref.space.*",
					"requireOffRampReason": true,
					"repeatThreshold": 2
				}
			},
			{
				"id": "type-size-ramp",
				"name": "Type sizes use ref.type.*.size and pair with line height",
