{
	"$comment": "Draft process manifest for the Factory Gateway (see the proposal's 'Keeping the process current'). The check that reads it is built in G1; until a milestone's 'landed' is true, nothing is enforced for it. Paths are relative to each repository's root.",
	"version": 1,
	"milestones": {
		"G0": {
			"landed": false,
			"afd": [
				{ "path": "docs/operations/factory-gateway.md", "names": ["gateway-status"] },
				{ "path": "SETUP.md", "names": ["gateway-status"] }
			],
			"lushly": [{ "path": "SETUP.md", "names": ["gateway-status"] }]
		},
		"G1": {
			"landed": false,
			"afd": [
				{ "path": "AGENTS.md", "names": ["factory gateway"] },
				{
					"path": ".claude/skills/triage-issues/SKILL.md",
					"names": ["issue-label", "issue-comment"]
				},
				{ "path": ".claude/skills/prepare-pr/SKILL.md", "names": ["branch-push"] },
				{
					"path": "endpoints/botcore/plugins/botcore-factory/src/botcore_factory/docs.py",
					"names": [
						"issue-claim",
						"branch-push",
						"pr-open",
						"verification-record",
						"pr-merge",
						"pr-status"
					]
				}
			],
			"lushly": [
				{ "path": "AGENTS.md", "names": ["issue-claim"] },
				{ "path": "INIT.md", "names": ["issue-claim", "claim-list"] },
				{ "path": ".claude/skills/do-init-lushly/SKILL.md", "names": ["issue-claim"] },
				{ "path": ".claude/skills/do-triage/SKILL.md", "names": ["issue-label", "issue-comment"] },
				{
					"path": ".claude/skills/do-run-fleet/SKILL.md",
					"names": ["claim-list", "gateway-audit"]
				},
				{
					"path": ".claude/skills/do-end-session/SKILL.md",
					"names": ["issue-release", "pr-status"]
				},
				{
					"path": "Docs/operations/merge-lane.md",
					"names": ["branch-push", "pr-open", "verification-record", "pr-merge"]
				},
				{ "path": "scripts/issue-claim.mjs", "names": ["issue-claim", "issue-release"] },
				{
					"path": "scripts/final-validation-flakes.mjs",
					"names": ["issue-create", "issue-comment"]
				}
			]
		},
		"G2": {
			"landed": false,
			"afd": [
				{ "path": ".claude/skills/prepare-pr/SKILL.md", "names": ["review-record"] },
				{ "path": ".claude/skills/review-code/SKILL.md", "names": ["review-record"] }
			],
			"lushly": [
				{ "path": ".claude/skills/review-code-lushly/SKILL.md", "names": ["review-record"] },
				{ "path": ".claude/skills/do-prepare-pr/SKILL.md", "names": ["review-record"] },
				{ "path": "scripts/check-review-lanes.mjs", "names": ["review-get"] }
			]
		},
		"G3": {
			"landed": false,
			"afd": [{ "path": "docs/operations/factory-gateway.md", "names": ["gateway-wait"] }],
			"lushly": [
				{ "path": ".claude/skills/do-run-fleet/SKILL.md", "names": ["gateway-wait"] },
				{ "path": "Docs/operations/merge-lane.md", "names": ["gateway-wait"] },
				{ "path": ".claude/skills/lushly-worktree-discipline/SKILL.md", "names": ["pr-status"] }
			]
		},
		"G4": {
			"landed": false,
			"afd": [{ "path": "SETUP.md", "names": ["cell token"] }],
			"lushly": [{ "path": "SETUP.md", "names": ["cell token"] }]
		}
	},
	"door": {
		"$comment": "gh writes the gateway serves. The door check refuses them in instruction files, skills, runbooks, scripts, hooks and MCP configuration, except in 'allow' for a milestone not yet landed.",
		"patterns": [
			"gh issue edit",
			"gh issue comment",
			"gh issue create",
			"gh pr create",
			"gh pr merge",
			"gh api .*/issues/.*/labels",
			"gh variable set"
		],
		"allow": {
			"G5": [
				"lushly:.claude/skills/do-prepare-pr/SKILL.md",
				"lushly:.claude/skills/do-sweep/SKILL.md",
				"afd:.claude/skills/prepare-pr/SKILL.md"
			]
		}
	}
}
