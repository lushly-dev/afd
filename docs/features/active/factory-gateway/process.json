	"door": {
		"$comment": "gh writes the gateway serves. The door check refuses them in instruction files, skills, runbooks, scripts (text and argument lists), hooks and MCP configuration. GitHub Actions workflows and tests are out of scope: workflows run as GITHUB_TOKEN, not as an agent. Each allowed file may keep its gh writes until the named milestone lands; after that the check fails on it.",
		"patterns": [
			"gh issue edit",
			"gh issue comment",
			"gh issue create",
			"gh pr create",
			"gh pr merge",
			"gh variable set",
			"gh api .*/labels"
		],
		"argvPatterns": [
			"[\"']issue[\"'],\\s*[\"'](edit|comment|create)[\"']",
			"[\"']pr[\"'],\\s*[\"'](create|merge)[\"']",
			"[\"']variable[\"'],\\s*[\"']set[\"']"
		],
		"exclude": [".github/workflows/**", "**/*.test.mjs", "**/tests/**"],
		"allow": [
			{
				"repo": "lushly",
				"path": "scripts/merge-lane-ci.mjs",
				"until": "G1"
