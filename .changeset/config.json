{
	"$schema": "https://unpkg.com/@changesets/config@4.0.1/schema.json",
	"changelog": [
		"@changesets/changelog-github",
		{
			"repo": "lushly-dev/afd"
		}
	],
	"commit": false,
	"format": "prettier",
	"fixed": [
		[
			"@lushly-dev/afd-adapters",
			"@lushly-dev/afd-auth",
			"@lushly-dev/afd-cli",
			"@lushly-dev/afd-client",
			"@lushly-dev/afd-core",
			"@lushly-dev/local-db",
			"@lushly-dev/afd-server",
			"@lushly-dev/afd-testing",
			"@lushly-dev/afd-view-state"
		]
	],
	"linked": [],
	"access": "public",
	"baseBranch": "main",
	"updateInternalDependencies": "patch",
	"___experimentalUnsafeOptions_WILL_CHANGE_IN_PATCH": {
		"onlyUpdatePeerDependentsWhenOutOfRange": true
	},
	"ignore": [
		"@afd/example-*",
		"@lushly-dev/afd-auth-convex-hosted-fixture",
		"@lushly-dev/health-dashboard",
		"@lushly-dev/loam-*",
		"@lushly-dev/specimen-afd-runner",
		"@lushly-dev/specimen-server"
	],
	"privatePackages": {
		"version": true,
		"tag": false
	}
}
