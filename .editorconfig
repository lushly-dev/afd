root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2
[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,ipp,cmake}]
indent_style = space
indent_size = 4
max_line_length = 100

[CMakeLists.txt]
indent_style = space
indent_size = 4
