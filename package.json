{
	"name": "afd",
	"version": "0.6.0",
	"private": true,
	"description": "Agent-First Development - Build software where AI agents are first-class users",
	"repository": {
		"type": "git",
		"url": "https://github.com/lushly-dev/afd.git"
	},
	"author": "Falkicon",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.12.0",
		"pnpm": ">=9.0.0"
	},
	"packageManager": "pnpm@10.30.1",
	"scripts": {
		"build": "pnpm -r build",
		"clean": "pnpm -r clean && rimraf node_modules",
		"dev": "pnpm -r --parallel dev",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "pnpm -r test",
		"test:coverage": "pnpm -r --no-bail test --coverage",
		"test:watch": "pnpm -r --parallel test:watch",
		"typecheck": "pnpm -r typecheck",
		"check": "npx lefthook run check",
		"check:all": "node scripts/affected.mjs check --all",
		"affected": "node scripts/affected.mjs list",
		"verify": "node scripts/affected.mjs verify",
		"check:boundaries": "node scripts/check-boundaries.mjs",
		"check:skills": "node scripts/skill-profiles.mjs",
		"skills:sync": "node scripts/skill-profiles.mjs --write",
		"test:tooling": "node scripts/run-tooling-tests.mjs",
		"changeset": "node scripts/release/changeset.mjs",
		"version-packages": "node scripts/release-control.mjs version",
		"release:select": "node scripts/release-control.mjs select",
		"release:plan": "node scripts/release-control.mjs plan",
		"publish:npm": "node scripts/release-control.mjs publish",
		"prepare": "lefthook install",
		"test:hosted:local": "pnpm build && node scripts/run-hosted-local.mjs",
		"test:specimen": "pnpm -F \"@lushly-dev/specimen-cli...\" -F \"@lushly-dev/specimen-fast-af...\" build && pnpm -F @lushly-dev/specimen test:browser && pnpm -F @lushly-dev/specimen-fast-af test:browser && node tests/consumers/specimen/verify-artifacts.mjs",
		"test:fast-af": "pnpm -F \"@lushly-dev/violet-elements...\" build && pnpm -F @lushly-dev/fast-element test:chromium && pnpm -F @lushly-dev/violet-elements test:browser && node tests/consumers/fast-af/verify-artifacts.mjs",
		"test:violet": "pnpm -F \"@lushly-dev/violet-cli...\" -F @lushly-dev/violet-runtime -F @lushly-dev/afd-core build && pnpm -F @lushly-dev/violet-core -F @lushly-dev/violet-afd test:db && node tests/consumers/violet/verify-artifacts.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@changesets/changelog-github": "^0.6.0",
		"@changesets/cli": "^2.31.1",
		"@commitlint/cli": "^20.5.3",
		"@commitlint/config-conventional": "^20.5.3",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^4.1.12",
		"knip": "^5.88.1",
		"lefthook": "^2.1.14",
		"rimraf": "^6.1.3",
		"semver": "^7.8.5",
		"smol-toml": "^1.9.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.12"
	},
	"pnpm": {
		"overrides": {
			"@types/node": "^26.6.6",
			"@auth/core": "^0.41.3",
			"convex>ws": "^8.21.0",
			"fast-uri@>=3.0.0 <3.1.9": "^3.1.9",
			"brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
			"smol-toml@<=1.8.0": "^1.9.0",
			"source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
			"zod@>=4.0.0 <4.6.6": "^4.6.6"
		}
	}
}
